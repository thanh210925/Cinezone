@model IEnumerable<CINEMA.Models.Genre>
@{
    ViewData["Title"] = "Quản lý Thể loại";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/genre/genre-management.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active">Quản lý thể loại</li>
        </ol>
    </nav>

    <!-- Card bọc nội dung -->
    <div class="card shadow-sm border-0 rounded-4">

        <!-- Header với layout Flex phân bổ sang phải -->
        <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <h4 class="fw-bold text-primary mb-0 d-flex align-items-center">
                <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                    <i class="bi bi-mask fs-5"></i>
                </div>
                Danh sách thể loại phim
            </h4>

            <!-- Khu vực bên phải: Tìm kiếm + Nút Thêm -->
            <div class="d-flex align-items-center gap-2 ms-auto">
                <div class="input-group" style="width: 250px;">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0"
                           placeholder="Tìm kiếm..." onkeyup="filterTable()">
                </div>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium">
                    <i class="bi bi-plus-lg me-1"></i> Thêm mới
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table mb-0">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th class="text-center ps-4" width="8%">STT</th>
                                <th width="20%">Tên thể loại</th>
                                <th width="30%">Mô tả</th>
                                <th width="30%">Phim liên quan</th>
                                <th class="text-center pe-4" width="12%">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }
                            @foreach (var g in Model)
                            {
                                <tr>
                                    <td class="text-center fw-medium text-muted">@stt</td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fs-6">
                                            @g.Name
                                        </span>
                                    </td>
                                    <td class="text-muted text-truncate" style="max-width: 250px;">
                                        @(string.IsNullOrEmpty(g.Description) ? "—" : g.Description)
                                    </td>
                                    <td>
                                        @if (g.Movies != null && g.Movies.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var m in g.Movies)
                                                {
                                                    <span class="badge bg-light text-dark border rounded-pill px-2 small">
                                                        🎬 @m.Title
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Chưa có phim</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Edit" asp-route-id="@g.GenreId" class="btn btn-light btn-sm text-warning action-btn" data-bs-toggle="tooltip" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@g.GenreId" class="btn btn-light btn-sm text-danger action-btn" onclick="return confirm('Xóa thể loại này?');" data-bs-toggle="tooltip" title="Xóa">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-mask opacity-50" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 fw-bold text-dark">Chưa có thể loại nào!</h5>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/genre/index.js" asp-append-version="true"></script>
}