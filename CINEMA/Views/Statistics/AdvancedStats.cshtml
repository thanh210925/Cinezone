@model CINEMA.ViewModels.RevenueDashboardViewModel
@{
    ViewData["Title"] = "Thống kê chuyên sâu";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4 text-center text-gradient">📊 Báo cáo chuyên sâu</h2>

    <div class="row mb-4 justify-content-center">
        <div class="col-md-4">
            <div class="card-box">
                <div class="label">Tỷ lệ lấp đầy ghế toàn hệ thống</div>
                <div class="value text-primary">@Model.GlobalOccupancyRate.ToString("F2")%</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="chart-box">
                <h5>🏢 Vé bán theo rạp</h5>
                <form class="row g-2 mb-3">
                    <div class="col-md-8">
                        <select name="tId" class="form-select">
                            <option value="">-- Chọn Rạp --</option>
                            @foreach (var t in (List<CINEMA.Models.Theater>)ViewBag.Theaters) {
                                <option value="@t.TheaterId" selected="@(Context.Request.Query["tId"] == t.TheaterId.ToString())">@t.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4"><button type="button" onclick="loadTheaterData()" class="btn btn-primary w-100">Lọc</button></div>
                </form>
                <canvas id="cinemaChart"></canvas>
            </div>
        </div>
        <div class="col-md-6">
            <div class="chart-box">
                <h5>🎬 Vé bán theo phim</h5>
                <form class="row g-2 mb-3">
                    <div class="col-md-9"><select id="movieSelect" class="form-select">
                        <option value="">-- Tất cả phim --</option>
                        @foreach (var m in (List<CINEMA.Models.Movie>)ViewBag.Movies) {
                            <option value="@m.MovieId">@m.Title</option>
                        }
                    </select></div>
                    <div class="col-md-3"><button type="button" onclick="loadMovieData()" class="btn btn-primary w-100">Lọc</button></div>
                </form>
                <canvas id="movieChart"></canvas>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="chart-box">
                <h5>⏰ Vé bán theo suất chiếu</h5>
                <form class="row g-2 mb-3">
                    <div class="col-md-5"><select id="showtimeMovieSelect" class="form-select">
                        <option value="">-- Chọn Phim --</option>
                        @foreach (var m in (List<CINEMA.Models.Movie>)ViewBag.Movies) { <option value="@m.MovieId">@m.Title</option> }
                    </select></div>
                    <div class="col-md-5"><select id="showtimeTheaterSelect" class="form-select">
                        <option value="">-- Chọn Rạp --</option>
                        @foreach (var t in (List<CINEMA.Models.Theater>)ViewBag.Theaters) { <option value="@t.TheaterId">@t.Name</option> }
                    </select></div>
                    <div class="col-md-2"><button type="button" onclick="loadShowtimeChart()" class="btn btn-primary w-100">Lọc</button></div>
                </form>
                <canvas id="showtimeChart" height="100"></canvas>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-2">
        <form method="get" class="row g-3 mb-4 justify-content-center">
            <div class="col-md-3"><input type="date" name="from" class="form-control" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" /></div>
            <div class="col-md-3"><input type="date" name="to" class="form-control" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" /></div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Lọc thời gian</button></div>
        </form>
        <div class="col-md-4"><div class="chart-box"><h5>📅 Theo ngày</h5><canvas id="ticketsByDateChart"></canvas></div></div>
        <div class="col-md-4"><div class="chart-box"><h5>📆 Theo tháng</h5><canvas id="ticketsByMonthChart"></canvas></div></div>
        <div class="col-md-4"><div class="chart-box"><h5>📊 Theo năm</h5><canvas id="ticketsByYearChart"></canvas></div></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        window.AdvancedStatsConfig = {
            cinemaLabels: @Html.Raw(Json.Serialize(Model.CinemaLabels)),
            cinemaRevenue: @Html.Raw(Json.Serialize(Model.CinemaRevenue)),
            labelsByDate: @Html.Raw(Json.Serialize(Model.LabelsByDate)),
            ticketCountByDate: @Html.Raw(Json.Serialize(Model.TicketCountByDate)),
            labelsByMonth: @Html.Raw(Json.Serialize(Model.LabelsByMonth)),
            ticketCountByMonth: @Html.Raw(Json.Serialize(Model.TicketCountByMonth)),
            labelsByYear: @Html.Raw(Json.Serialize(Model.LabelsByYear)),
            ticketCountByYear: @Html.Raw(Json.Serialize(Model.TicketCountByYear))
        };
    </script>
    <script src="~/js/pages/statistics/advancedstats.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/statistics/advancedstats.css" asp-append-version="true" />
}