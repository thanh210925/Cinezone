@model List<CINEMA.Services.AssociationRule>
@{
    ViewData["Title"] = "Quy luật gợi ý - Apriori";
    Layout = "_AdminLayout";

    var genres = ViewBag.Genres as Dictionary<string, string> ?? new Dictionary<string, string>();
    var movies = ViewBag.Movies as Dictionary<string, string> ?? new Dictionary<string, string>();
    var combos = ViewBag.Combos as Dictionary<string, string> ?? new Dictionary<string, string>();

    string FormatItem(string item)
    {
        if (item.StartsWith("Genre_") && genres.TryGetValue(item, out string gName))
            return $"<span class=\"badge bg-info text-dark px-2 py-1 me-1\"><i class=\"bi bi-tag-fill me-1\"></i>{gName}</span>";
        
        if (item.StartsWith("Movie_") && movies.TryGetValue(item, out string mTitle))
            return $"<span class=\"badge bg-primary text-white px-2 py-1 me-1\"><i class=\"bi bi-film me-1\"></i>{mTitle}</span>";

        if (item.StartsWith("Combo_") && combos.TryGetValue(item, out string cName))
            return $"<span class=\"badge bg-warning text-dark px-2 py-1 me-1\"><i class=\"bi bi-cup-straw me-1\"></i>{cName}</span>";

        return $"<span class=\"badge bg-secondary px-2 py-1 me-1\">{item}</span>";
    }
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold text-primary mb-0 d-flex align-items-center">
                <div class="icon-shape bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                    <i class="bi bi-fire fs-5"></i>
                </div>
                Khai Phá Quy Luật Gợi Ý (Apriori)
            </h4>
            <p class="text-muted ms-5 ps-2 mb-0 mt-1">Phân tích hành vi giỏ hàng để tìm liên kết giữa phim và dịch vụ kèm theo</p>
        </div>
        <div>
            <a asp-action="RecommendationRules" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới dữ liệu
            </a>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-bottom border-4 border-danger">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold d-block mb-1">Số Luật Khai Phá Được</span>
                        <h3 class="fw-bold mb-0 text-dark">@Model.Count</h3>
                    </div>
                    <div class="icon-shape bg-danger bg-opacity-10 text-danger rounded-3 p-3">
                        <i class="bi bi-diagram-3 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-bottom border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold d-block mb-1">Min Support Ngưỡng</span>
                        <h3 class="fw-bold mb-0 text-dark">2%</h3>
                    </div>
                    <div class="icon-shape bg-info bg-opacity-10 text-info rounded-3 p-3">
                        <i class="bi bi-percent fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-bottom border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold d-block mb-1">Min Confidence Ngưỡng</span>
                        <h3 class="fw-bold mb-0 text-dark">10%</h3>
                    </div>
                    <div class="icon-shape bg-warning bg-opacity-10 text-warning rounded-3 p-3">
                        <i class="bi bi-shield-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-bottom border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small fw-bold d-block mb-1">Độ Tin Cậy Tối Đa</span>
                        <h3 class="fw-bold mb-0 text-dark">
                            @(Model.Any() ? $"{Model.Max(r => r.Confidence) * 100:N1}%" : "0%")
                        </h3>
                    </div>
                    <div class="icon-shape bg-success bg-opacity-10 text-success rounded-3 p-3">
                        <i class="bi bi-graph-up-arrow fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="fw-bold mb-0 text-dark">Bảng phân tích quy luật kết hợp Apriori</h5>
        </div>
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <img src="https://illustrations.popsy.co/amber/analysis.svg" alt="No data" style="width: 180px; max-width: 100%;" class="mb-4" />
                    <h5 class="fw-bold text-dark">Chưa khai phá được quy luật nào</h5>
                    <p class="text-muted small mx-auto" style="max-width: 450px;">Hệ thống cần tối thiểu 3 đơn giao dịch thành công (có mua vé và combo) để phân tích các luật kết hợp bắp nước đi kèm phim.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 5%;">STT</th>
                                <th style="width: 40%;">Tập Tiền Đề (LHS - Khách đã chọn)</th>
                                <th style="width: 5%;"></th>
                                <th style="width: 25%;">Hệ Quả (RHS - Gợi ý Phim/Combo)</th>
                                <th class="text-center" style="width: 8%;">Support</th>
                                <th class="text-center" style="width: 8%;">Confidence</th>
                                <th class="text-center" style="width: 9%;">Đánh giá</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int index = 1;
                            }
                            @foreach (var rule in Model.OrderByDescending(r => r.Confidence))
                            {
                                <tr>
                                    <td>@index</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var item in rule.LHS)
                                            {
                                                @Html.Raw(FormatItem(item))
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center text-muted">
                                        <i class="bi bi-arrow-right-circle-fill text-danger fs-5"></i>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var item in rule.RHS)
                                            {
                                                @Html.Raw(FormatItem(item))
                                            }
                                        </div>
                                    </td>
                                    <td class="text-center fw-semibold text-muted">
                                        @((rule.Support * 100).ToString("N1"))%
                                    </td>
                                    <td class="text-center fw-bold text-danger">
                                        @((rule.Confidence * 100).ToString("N1"))%
                                    </td>
                                    <td class="text-center">
                                        @if (rule.Lift > 2.0)
                                        {
                                            <span class="badge bg-success text-white">Rất mạnh 🔥</span>
                                        }
                                        else if (rule.Confidence > 0.4)
                                        {
                                            <span class="badge bg-primary text-white">Tốt ⭐</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white">Tiềm năng</span>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
