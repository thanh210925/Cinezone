                </div>
                <div class="bg-white text-danger rounded-3 px-4 py-2 fw-bold shadow-sm fs-5">
                    @Model.WorstSellingQuantity <small class="text-muted fw-normal fs-6">lượt bán</small>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-success-subtle">
                        <div class="text-success text-uppercase fw-bold small mb-2"><i class="bi bi-cash-coin me-1"></i> Doanh thu Combo</div>
                        <div class="text-success fw-bold fs-3">@Model.ComboRevenue.ToString("N0") ₫</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-primary-subtle">
                        <div class="text-primary text-uppercase fw-bold small mb-2"><i class="bi bi-box-seam me-1"></i> Tổng số lượt Combo đã bán</div>
                        <div class="text-primary fw-bold fs-3">@Model.ComboSold <small class="fs-6 fw-normal text-muted">lượt</small></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-warning-subtle text-warning-emphasis">
                        <div class="text-warning-emphasis text-uppercase fw-bold small mb-2"><i class="bi bi-fire me-1"></i> Combo bán chạy nhất</div>
                        <div class="text-warning-emphasis fw-bold fs-4 text-truncate" title="@Model.BestSellingCombo">@Model.BestSellingCombo</div>
                        <small class="text-warning-emphasis">@Model.BestSellingQuantity lượt bán</small>
                    </div>
                </div>
