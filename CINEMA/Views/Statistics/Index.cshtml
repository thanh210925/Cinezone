                        <small class="text-muted fw-bold text-uppercase mb-1">Chi tiêu Combo bình quân/Đơn</small>
                        <h4 class="fw-bold text-dark mb-0">@Model.AverageComboPerOrder.ToString("N0") ₫</h4>
                    </div>
