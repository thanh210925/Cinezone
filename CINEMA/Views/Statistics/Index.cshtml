                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }
    </script>

    <!-- SCRIPT XUẤT CSV TIẾNG VIỆT CHUẨN UTF-8 BOM -->
    <script>
        function exportToCSV() {
            let csvContent = "\uFEFF"; // Thêm Byte Order Mark (BOM) để Excel đọc đúng tiếng Việt
            
            // Header báo cáo
            csvContent += "BÁO CÁO THỐNG KÊ DOANH THU CINEZONE\r\n";
            csvContent += "Thời gian:," + (document.getElementById('inputFrom').value || "Toàn thời gian") + " - " + (document.getElementById('inputTo').value || "Toàn thời gian") + "\r\n\r\n";

            // Phần 1: Các chỉ số tài chính cơ bản
            csvContent += "1. TỔNG QUAN CHỈ SỐ TÀI CHÍNH\r\n";
            csvContent += "Chỉ số,Giá trị\r\n";
            csvContent += "Doanh thu thuần (Thực nhận)," + @Model.NetRevenue + " ₫\r\n";
            csvContent += "Doanh thu bán Vé gộp," + @Model.TicketRevenue + " ₫\r\n";
            csvContent += "Doanh thu bán Combo gộp," + @Model.GrossComboRevenue + " ₫\r\n";
            csvContent += "Khấu hao giảm giá Voucher," + @Model.TotalDiscount + " ₫\r\n";
            csvContent += "Tổng số vé bán ra," + @Model.TotalTickets + "\r\n";
            csvContent += "Tổng số combo bán ra," + @Model.ComboSold + "\r\n\r\n";

            // Phần 2: Hiệu suất rạp chi nhánh
            csvContent += "2. HIỆU SUẤT THEO RẠP CHIẾU\r\n";
            csvContent += "Tên rạp,Số vé đã bán,Doanh thu vé,Doanh thu Combo,Tổng doanh số,Tỷ lệ lấp đầy\r\n";
            @foreach (var r in Model.TheaterRevenues)
            {
                <text>
                csvContent += "\"@r.TheaterName\",@r.TicketsSold,@r.TicketRevenue,@r.ComboRevenue,@r.TotalRevenue,@r.OccupancyRate%\r\n";
                </text>
            }
            csvContent += "\r\n";

            // Phần 3: Phân tích theo phim
            csvContent += "3. DOANH THU THEO PHIM\r\n";
            csvContent += "Tên phim,Doanh thu gộp,Số vé bán ra\r\n";
            for(let i = 0; i < movieLabels.length; i++) {
                csvContent += "\"" + movieLabels[i] + "\"," + revenueByMovie[i] + "," + ticketData[i] + "\r\n";
            }
            csvContent += "\r\n";

            // Phần 4: VIP Customers
            csvContent += "4. TOP KHÁCH HÀNG THÂN THIẾT\r\n";
            csvContent += "Họ tên,Email,Số điện thoại,Hạng thành viên,Số vé đã đặt,Tổng chi tiêu thực nhận\r\n";
            @foreach (var c in Model.TopCustomers)
            {
                <text>
                csvContent += "\"@c.FullName\",\"@c.Email\",\"@c.Phone\",\"@c.MembershipLevel\",@c.TicketsBooked,@c.TotalSpent\r\n";
                </text>
            }
            csvContent += "\r\n";

            // Tạo download link
            let blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            let link = document.createElement("a");
            let url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", "CineZone_BaoCaoDoanhThu_" + new Date().toISOString().slice(0, 10) + ".csv");
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
}