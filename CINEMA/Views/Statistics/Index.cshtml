        <!-- 7. Tab Voucher -->
        <div class="tab-pane fade" id="voucher">
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 text-center">
                        <div class="text-muted text-uppercase fw-bold small mb-2">Tổng tiền chiết khấu voucher</div>
                        <div class="text-danger fw-bold fs-3">@Model.TotalDiscountAmount.ToString("N0") ₫</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 text-center">
                        <div class="text-muted text-uppercase fw-bold small mb-2">Voucher dùng nhiều nhất</div>
                        <div class="text-primary fw-bold fs-3">@Model.BestVoucher</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 text-center">
                        <div class="text-muted text-uppercase fw-bold small mb-2">Số lượt sử dụng tối đa</div>
                        <div class="text-success fw-bold fs-3">@Model.BestVoucherUsage <small class="fs-6 fw-normal text-muted">lượt</small></div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">🎟 Top Voucher có lượt dùng cao nhất</h6>
                        <div class="chart-container" style="position: relative; height:350px;"><canvas id="voucherChart"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="card shadow-sm border-0 rounded-4 h-100">
                        <div class="card-header bg-white pt-4 px-4 border-0">
                            <h6 class="fw-bold text-dark mb-0">📋 Chi tiết hiệu quả Voucher</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 350px;">
                                <table class="table table-hover table-premium align-middle mb-0">
                                    <thead class="sticky-top bg-light">
                                        <tr>
                                            <th class="ps-4">Mã Voucher</th>
                                            <th class="text-center">Đã dùng</th>
                                            <th class="text-end pe-4">Tổng giảm</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.VoucherStatistics)
                                        {
                                            <tr>
                                                <td class="ps-4"><span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 py-2 px-3 fw-bold">@item.VoucherCode</span></td>
                                                <td class="text-center fw-semibold text-dark">@item.UsedCount</td>
                                                <td class="text-end pe-4 text-danger fw-bold">@item.TotalDiscount.ToString("N0") ₫</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 8. Tab Bảng Vàng Khách Hàng VIP -->
        <div class="tab-pane fade" id="vip">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white pt-4 px-4 border-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold text-dark mb-1">👑 Top 5 Khách hàng thân thiết có Chi tiêu lớn nhất</h6>
                        <p class="text-muted small mb-0">Bảng vàng vinh danh những khách hàng có đóng góp doanh số cao nhất trong kỳ báo cáo</p>
                    </div>
                    <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning border-opacity-25 px-3 py-2 fw-semibold">VIP MEMBER</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-premium align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Vị trí</th>
                                    <th>Khách hàng</th>
                                    <th>Email</th>
                                    <th>Số điện thoại</th>
                                    <th class="text-center">Hạng thành viên</th>
                                    <th class="text-center">Vé đã mua</th>
                                    <th class="text-end pe-4">Tổng chi tiêu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int vipRank = 1; }
                                @foreach (var customer in Model.TopCustomers)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold fs-5 text-muted">
                                            @if (vipRank == 1) { <span class="text-warning">🥇</span> }
                                            else if (vipRank == 2) { <span class="text-secondary">🥈</span> }
                                            else if (vipRank == 3) { <span class="text-bronze">🥉</span> }
                                            else { <span>#@vipRank</span> }
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold me-2" style="width:35px; height:35px; font-size:0.9rem;">
                                                    @customer.FullName.Substring(0, 1).ToUpper()
                                                </div>
                                                <span class="fw-semibold">@customer.FullName</span>
                                            </div>
                                        </td>
                                        <td class="text-muted">@customer.Email</td>
                                        <td>@customer.Phone</td>
                                        <td class="text-center">
                                            <span class="badge badge-vip rounded-pill px-3 py-2">
                                                <i class="bi bi-gem me-1"></i>@customer.MembershipLevel
                                            </span>
                                        </td>
                                        <td class="text-center fw-medium">@customer.TicketsBooked vé</td>
                                        <td class="text-end pe-4 fw-bold text-success fs-6">@customer.TotalSpent.ToString("N0") ₫</td>
                                    </tr>
                                    vipRank++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 9. Tab Chi Tiết Bảng (Combo statistics) -->
        <div class="tab-pane fade" id="chitiet">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white pt-4 px-4 border-0">
                    <h6 class="fw-bold text-dark mb-0">📋 Chi tiết số lượng bán và cơ cấu doanh số Combo</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-premium align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Tên sản phẩm Combo</th>
                                    <th class="text-center">Số lượng bán ra</th>
                                    <th class="text-center">Tỷ lệ cơ cấu</th>
                                    <th class="text-end pe-4">Doanh thu Combo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var combo in Model.ComboStatistics)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-dark">@combo.ComboName</td>
                                        <td class="text-center fw-medium"><span class="badge bg-light text-dark border px-3 py-2">@combo.QuantitySold</span></td>
                                        <td class="text-center text-muted">@combo.Percentage %</td>
                                        <td class="text-end pe-4 fw-bold text-success">@combo.Revenue.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <!-- Đồng bộ hóa bộ lọc nhanh theo tháng và hai date input -->
    <script>
        document.getElementById('quickMonthFilter').addEventListener('change', function() {
            const selectedMonthValue = this.value; // Dạng "YYYY-MM"
            if (!selectedMonthValue) return;

            const [year, month] = selectedMonthValue.split('-').map(Number);
            const fromDate = `${year}-${String(month).padStart(2, '0')}-01`;
            const lastDay = new Date(year, month, 0).getDate();
            const toDate = `${year}-${String(month).padStart(2, '0')}-${String(lastDay).padStart(2, '0')}`;

            document.getElementById('inputFrom').value = fromDate;
            document.getElementById('inputTo').value = toDate;
            document.getElementById('filterForm').submit();
        });

        window.addEventListener('DOMContentLoaded', () => {
            const fromVal = document.getElementById('inputFrom').value;
            const toVal = document.getElementById('inputTo').value;

            if (fromVal && toVal) {
                const fromPrefix = fromVal.substring(0, 7);
                const toPrefix = toVal.substring(0, 7);

                if (fromPrefix === toPrefix && fromVal.endsWith('-01')) {
                    const selectElement = document.getElementById('quickMonthFilter');
                    const option = selectElement.querySelector(`option[value="${fromPrefix}"]`);
                    if(option) {
                        selectElement.value = fromPrefix;
                    }
                }
            }
        });

        // Tự động submit form khi chọn rạp hoặc phim từ dropdown
        const selectFilters = document.querySelectorAll('#filterForm select[name="theaterId"], #filterForm select[name="movieId"]');
        selectFilters.forEach(sel => {
            sel.addEventListener('change', () => {
                document.getElementById('filterForm').submit();
            });
        });
    </script>

    <!-- KHỞI TẠO BIỂU ĐỒ CHART.JS -->
    <script>
        // Lấy dữ liệu serialize từ Model C#
        const labelsByDate = @Html.Raw(Json.Serialize(Model.LabelsByDate));
        const revenueByDate = @Html.Raw(Json.Serialize(Model.RevenueByDate));
        const ticketCountByDate = @Html.Raw(Json.Serialize(Model.TicketCountByDate));

        const labelsByMonth = @Html.Raw(Json.Serialize(Model.LabelsByMonth));
        const revenueByMonth = @Html.Raw(Json.Serialize(Model.RevenueByMonth));
        const ticketCountByMonth = @Html.Raw(Json.Serialize(Model.TicketCountByMonth));

        const labelsByYear = @Html.Raw(Json.Serialize(Model.LabelsByYear));
        const revenueByYear = @Html.Raw(Json.Serialize(Model.RevenueByYear));
        const ticketCountByYear = @Html.Raw(Json.Serialize(Model.TicketCountByYear));

        const movieLabels = @Html.Raw(Json.Serialize(Model.MovieLabels));
        const revenueByMovie = @Html.Raw(Json.Serialize(Model.RevenueByMovie));
        const ticketData = @Html.Raw(Json.Serialize(Model.TicketsByMovie));

        const showtimeLabels = @Html.Raw(Json.Serialize(Model.ShowtimeLabels));
        const revenueByShowtime = @Html.Raw(Json.Serialize(Model.RevenueByShowtime));

        const comboPieLabels = @Html.Raw(Json.Serialize(Model.ComboPieLabels));
        const comboPieValues = @Html.Raw(Json.Serialize(Model.ComboPieValues));

        // Dữ liệu rạp chiếu
        const theaterLabels = @Html.Raw(Json.Serialize(Model.TheaterRevenues.Select(t => t.TheaterName)));
        const theaterRevenueData = @Html.Raw(Json.Serialize(Model.TheaterRevenues.Select(t => t.TotalRevenue)));

        // Dữ liệu khung giờ & ngày vàng
        const peakHoursLabels = @Html.Raw(Json.Serialize(Model.PeakHours.Select(p => p.TimeSlot)));
        const peakHoursTickets = @Html.Raw(Json.Serialize(Model.PeakHours.Select(p => p.TicketCount)));
        const peakHoursRevenue = @Html.Raw(Json.Serialize(Model.PeakHours.Select(p => p.Revenue)));

        const peakDaysLabels = @Html.Raw(Json.Serialize(Model.PeakDays.Select(p => p.DayOfWeek)));
        const peakDaysTickets = @Html.Raw(Json.Serialize(Model.PeakDays.Select(p => p.TicketCount)));
        const peakDaysRevenue = @Html.Raw(Json.Serialize(Model.PeakDays.Select(p => p.Revenue)));

        // Dữ liệu thanh toán
        const paymentMethodLabels = @Html.Raw(Json.Serialize(Model.PaymentMethodStats.Select(p => p.PaymentMethod)));
        const paymentMethodValues = @Html.Raw(Json.Serialize(Model.PaymentMethodStats.Select(p => p.TotalRevenue)));

        // Helper tạo biểu đồ doanh số kết hợp đường và cột
        function createMixedChart(id, labels, data1, data2) {
            new Chart(document.getElementById(id), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        { 
                            label: 'Doanh thu (₫)', 
                            data: data1, 
                            yAxisID: 'y', 
                            backgroundColor: 'rgba(13, 110, 253, 0.85)', 
                            borderRadius: 6, 
                            maxBarThickness: 45 
                        },
                        { 
                            label: 'Số vé bán', 
                            data: data2, 
                            type: 'line', 
                            yAxisID: 'y1', 
                            borderColor: '#ff8c00', 
                            backgroundColor: 'rgba(255, 140, 0, 0.1)',
                            borderWidth: 3, 
                            tension: 0.3,
                            fill: false
                        }
                    ]
                },
                options: { 
                    responsive: true, 
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 15, font: { weight: 600 } } }
                    },
                    scales: {
                        y: { position: 'left', grid: { drawOnChartArea: true } },
                        y1: { position: 'right', grid: { drawOnChartArea: false } }
                    }
                }
            });
        }

        // Khởi tạo các biểu đồ chính
        createMixedChart("revenueByDateChart", labelsByDate, revenueByDate, ticketCountByDate);
        createMixedChart("revenueByMonthChart", labelsByMonth, revenueByMonth, ticketCountByMonth);
        createMixedChart("revenueByYearChart", labelsByYear, revenueByYear, ticketCountByYear);

        // Biểu đồ hình tròn tỷ trọng phương thức thanh toán
        new Chart(document.getElementById("paymentMethodChart"), {
            type: 'doughnut',
            data: {
                labels: paymentMethodLabels,
                datasets: [{
                    data: paymentMethodValues,
                    backgroundColor: ['#20c997', '#0d6efd', '#fd7e14', '#6c757d'],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { boxWidth: 12 } }
                },
                cutout: '65%'
            }
        });

        // Biểu đồ phim doanh thu
        new Chart(document.getElementById("movieRevenueChart"), {
            type: 'bar',
            data: {
                labels: movieLabels,
                datasets: [{ 
                    label: 'Doanh thu phim (₫)', 
                    data: revenueByMovie, 
                    backgroundColor: 'rgba(25, 135, 84, 0.85)', 
                    borderRadius: 6, 
                    maxBarThickness: 45 
                }]
            },
            options: { 
                responsive: true, 
                maintainAspectRatio: false,
                plugins: { legend: { display: false } }
            }
        });

        // Biểu đồ so sánh lượng vé phim
        new Chart(document.getElementById("ticketComparisonChart"), {
            type: 'doughnut',
            data: {
                labels: movieLabels,
                datasets: [{ 
                    data: ticketData, 
                    backgroundColor: ['#0dcaf0', '#6f42c1', '#fd7e14', '#20c997', '#ffc107'],
                    hoverOffset: 6 
                }]
            },
            options: { 
                responsive: true, 
                maintainAspectRatio: false, 
                plugins: { legend: { position: 'bottom' } } 
            }
        });

        // Biểu đồ cột so sánh AOV
        new Chart(document.getElementById("aovChart"), {
            type: 'bar',
            data: {
                labels: ['Hôm nay', 'Tháng này', 'Quý này', 'Năm nay'],
                datasets: [{
                    label: 'AOV (VND)',
                    data: [@Model.AvgOrderValueToday, @Model.AvgOrderValueMonth, @Model.AvgOrderValueQuarter, @Model.AvgOrderValueYear],
                    backgroundColor: ['#f06292', '#4fc3f7', '#fff176', '#4db6ac'],
                    borderRadius: 6,
                    maxBarThickness: 45
                }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });

