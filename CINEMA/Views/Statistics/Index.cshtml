@model CINEMA.ViewModels.RevenueDashboardViewModel
@{
    ViewData["Title"] = "Thống kê doanh thu";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/revenue-dashboard.css" />
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold text-primary mb-0 d-flex align-items-center">
                <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                    <i class="bi bi-bar-chart-fill fs-5"></i>
                </div>
                Báo cáo doanh thu
            </h4>
            <p class="text-muted ms-5 ps-2 mb-0 mt-1">
                @if (Model.FromDate.HasValue || Model.ToDate.HasValue)
                {
                    <span>Đang lọc: <strong>@Model.FromDate?.ToString("dd/MM/yyyy") - @Model.ToDate?.ToString("dd/MM/yyyy")</strong></span>
                }
                else
                {
                    <span>Đang xem: <strong>Toàn thời gian</strong></span>
                }
            </p>
        </div>

        <div class="bg-white p-2 rounded-pill shadow-sm border">
            <form method="get" class="d-flex align-items-center m-0">
                <div class="d-flex align-items-center px-3 border-end">
                    <label class="text-muted small me-2 text-nowrap">Từ ngày</label>
                    <input type="date" name="from" class="form-control form-control-sm border-0 bg-transparent shadow-none" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="d-flex align-items-center px-3 border-end">
                    <label class="text-muted small me-2 text-nowrap">Đến ngày</label>
                    <input type="date" name="to" class="form-control form-control-sm border-0 bg-transparent shadow-none" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="px-2">
                    <button type="submit" class="btn btn-primary btn-sm rounded-pill px-4 fw-medium text-nowrap">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-center mb-4">
        <ul class="nav nav-pills gap-2 p-1 bg-white border rounded-pill shadow-sm" id="dashboardTabs" role="tablist">
            <li class="nav-item"><button class="nav-link active rounded-pill px-4" data-bs-toggle="pill" data-bs-target="#tongquan" type="button"><i class="bi bi-graph-up me-1"></i> Tổng Quan</button></li>
            <li class="nav-item"><button class="nav-link rounded-pill px-4" data-bs-toggle="pill" data-bs-target="#phim" type="button"><i class="bi bi-film me-1"></i> Theo Phim</button></li>
            <li class="nav-item"><button class="nav-link rounded-pill px-4" data-bs-toggle="pill" data-bs-target="#suatchieu" type="button"><i class="bi bi-calendar-event me-1"></i> Suất Chiếu</button></li>
            <li class="nav-item"><button class="nav-link rounded-pill px-4" data-bs-toggle="pill" data-bs-target="#combo" type="button"><i class="bi bi-cup-straw me-1"></i> Combo</button></li>
            <li class="nav-item"><button class="nav-link rounded-pill px-4" data-bs-toggle="pill" data-bs-target="#voucher" type="button"><i class="bi bi-ticket-perforated me-1"></i> Voucher</button></li>
            <li class="nav-item"><button class="nav-link rounded-pill px-4" data-bs-toggle="pill" data-bs-target="#chitiet" type="button"><i class="bi bi-list-columns-reverse me-1"></i> Chi Tiết Bảng</button></li>
        </ul>
    </div>

    <div class="tab-content" id="dashboardTabsContent">

        <div class="tab-pane fade show active" id="tongquan">

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 border-bottom border-4 border-info">
                        <div class="text-muted text-uppercase fw-bold small mb-2"><i class="bi bi-calendar-day me-1"></i> Doanh thu hôm nay</div>
                        <div class="text-dark fw-bold fs-3 mb-1">@Model.TodayRevenue.ToString("N0") ₫</div>
                        <span class="badge bg-info-subtle text-info rounded-pill px-3">@Model.TodayTickets vé bán ra</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 border-bottom border-4 border-primary">
                        <div class="text-muted text-uppercase fw-bold small mb-2"><i class="bi bi-calendar-month me-1"></i> Doanh thu tháng này</div>
                        <div class="text-dark fw-bold fs-3 mb-1">@Model.MonthRevenue.ToString("N0") ₫</div>
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3">@Model.MonthTickets vé bán ra</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 border-bottom border-4 border-success">
                        <div class="text-muted text-uppercase fw-bold small mb-2"><i class="bi bi-cash-stack me-1"></i> Tổng doanh thu</div>
                        <div class="text-success fw-bold fs-3 mb-1">@Model.TotalRevenue.ToString("N0") ₫</div>
                        <span class="badge bg-success-subtle text-success rounded-pill px-3">@Model.TotalTickets vé bán ra</span>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center">
                        <div class="bg-success-subtle text-success rounded-circle d-flex justify-content-center align-items-center me-3" style="width:50px;height:50px;"><i class="bi bi-check-lg fs-4"></i></div>
                        <div>
                            <div class="text-muted small fw-bold text-uppercase">Đã thanh toán</div>
                            <div class="fw-bold fs-5 text-dark">@Model.PaidOrders đơn</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center">
                        <div class="bg-warning-subtle text-warning rounded-circle d-flex justify-content-center align-items-center me-3" style="width:50px;height:50px;"><i class="bi bi-hourglass-split fs-4"></i></div>
                        <div>
                            <div class="text-muted small fw-bold text-uppercase">Đang chờ</div>
                            <div class="fw-bold fs-5 text-dark">@Model.PendingOrders đơn</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center">
                        <div class="bg-danger-subtle text-danger rounded-circle d-flex justify-content-center align-items-center me-3" style="width:50px;height:50px;"><i class="bi bi-x-lg fs-4"></i></div>
                        <div>
                            <div class="text-muted small fw-bold text-uppercase">Đã hủy</div>
                            <div class="fw-bold fs-5 text-dark">@Model.CancelledOrders đơn</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">📅 Doanh thu & Số vé theo ngày</h6>
                        <div class="chart-container" style="position: relative; height:300px;"><canvas id="revenueByDateChart"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">🎬 Tỷ trọng doanh thu phim</h6>
                        <div class="chart-container" style="position: relative; height:300px;"><canvas id="revenueByMovieChart"></canvas></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h6 class="fw-bold text-dark mb-4">📆 Theo tháng</h6>
                        <div class="chart-container" style="position: relative; height:250px;"><canvas id="revenueByMonthChart"></canvas></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h6 class="fw-bold text-dark mb-4">📊 Theo năm</h6>
                        <div class="chart-container" style="position: relative; height:250px;"><canvas id="revenueByYearChart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="phim">
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="text-muted small fw-bold text-uppercase mb-1">Đang/Sắp chiếu</div>
                        <div class="text-info fw-bold fs-4">@Model.NowShowingCount / @Model.ComingSoonCount</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="text-muted small fw-bold text-uppercase mb-1">Phim bán chạy nhất</div>
                        <div class="text-primary fw-bold text-truncate" title="@Model.TopSellingMovie">@Model.TopSellingMovie</div>
                        <small class="text-muted">@Model.TopSellingTickets vé</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="text-muted small fw-bold text-uppercase mb-1">Phim bán chậm nhất</div>
                        <div class="text-danger fw-bold text-truncate" title="@Model.LeastSellingMovie">@Model.LeastSellingMovie</div>
                        <small class="text-muted">@Model.LeastSellingTickets vé</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                        <div class="text-muted small fw-bold text-uppercase mb-1">Top Doanh thu</div>
                        <div class="text-success fw-bold text-truncate" title="@Model.TopRevenueMovie">@Model.TopRevenueMovie</div>
                        <small class="text-muted">@Model.TopRevenueAmount.ToString("N0") ₫</small>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4"><h6 class="fw-bold text-dark mb-0">💰 Giá trị trung bình đơn hàng (AOV)</h6></div>
                <div class="card-body px-4 pb-4">
                    <div class="row text-center g-3">
                        <div class="col-md-3">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted fw-bold d-block mb-1 text-uppercase">Hôm nay</small>
                                <span class="fw-bold text-dark fs-5">@Model.AvgOrderValueToday.ToString("N0") ₫</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted fw-bold d-block mb-1 text-uppercase">Tháng này</small>
                                <span class="fw-bold text-dark fs-5">@Model.AvgOrderValueMonth.ToString("N0") ₫</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted fw-bold d-block mb-1 text-uppercase">Quý này</small>
                                <span class="fw-bold text-dark fs-5">@Model.AvgOrderValueQuarter.ToString("N0") ₫</span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="p-3 bg-light rounded-3 border">
                                <small class="text-muted fw-bold d-block mb-1 text-uppercase">Năm nay</small>
                                <span class="fw-bold text-dark fs-5">@Model.AvgOrderValueYear.ToString("N0") ₫</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">📊 Doanh thu theo Phim</h6>
                        <div class="chart-container" style="position: relative; height:300px;"><canvas id="movieRevenueChart"></canvas></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">🎟️ Số lượng vé đã bán</h6>
                        <div class="chart-container" style="position: relative; height:300px;"><canvas id="ticketComparisonChart"></canvas></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">💰 Biểu đồ Giá trị đơn (AOV)</h6>
                        <div class="chart-container" style="position: relative; height:300px;"><canvas id="aovChart"></canvas></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">📊 So sánh doanh thu 2 tháng gần nhất</h6>
                        <div class="chart-container" style="position: relative; height:300px;"><canvas id="monthCompareChart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="suatchieu">
            <div class="card shadow-sm border-0 rounded-4 mb-4 p-4">
                <h6 class="fw-bold text-dark mb-4">🎬 Doanh thu theo suất chiếu</h6>
                <div class="chart-container" style="position: relative; height:350px;"><canvas id="showtimeRevenueChart"></canvas></div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white pt-4 px-4 border-0">
                    <h6 class="fw-bold text-dark mb-0">📋 Bảng thống kê suất chiếu</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover custom-table align-middle mb-0">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th class="ps-4">Mã SC</th>
                                    <th>Phim</th>
                                    <th class="text-center">Thời gian</th>
                                    <th class="text-center">Vé bán</th>
                                    <th class="text-end pe-4">Doanh thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ShowtimeStatistics)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">#@item.ShowtimeId</td>
                                        <td class="fw-medium">@item.MovieName</td>
                                        <td class="text-center text-muted small"><i class="bi bi-clock me-1"></i> @item.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-center"><span class="badge bg-light text-dark border px-3">@item.TicketCount</span></td>
                                        <td class="text-end pe-4 fw-bold text-success">@item.Revenue.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="combo">
            <div class="alert alert-danger border-0 shadow-sm rounded-4 d-flex justify-content-between align-items-center p-4 mb-4">
                <div>
                    <h5 class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i> Combo cần cải thiện: @Model.WorstSellingCombo</h5>
                    <p class="mb-0 text-danger opacity-75">Sản phẩm này có lượt bán thấp nhất trong kỳ báo cáo.</p>
                </div>
                <div class="bg-white text-danger rounded-3 px-4 py-2 fw-bold shadow-sm fs-5">
                    @Model.WorstSellingQuantity <small class="text-muted fw-normal fs-6">lượt bán</small>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-success-subtle">
                        <div class="text-success text-uppercase fw-bold small mb-2"><i class="bi bi-cash-coin me-1"></i> Doanh thu Combo</div>
                        <div class="text-success fw-bold fs-3">@Model.ComboRevenue.ToString("N0") ₫</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-primary-subtle">
                        <div class="text-primary text-uppercase fw-bold small mb-2"><i class="bi bi-box-seam me-1"></i> Đã bán ra</div>
                        <div class="text-primary fw-bold fs-3">@Model.ComboSold <small class="fs-6 fw-normal">lượt</small></div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-warning-subtle">
                        <div class="text-warning-emphasis text-uppercase fw-bold small mb-2"><i class="bi bi-fire me-1"></i> Bán chạy nhất</div>
                        <div class="text-warning-emphasis fw-bold fs-4 text-truncate" title="@Model.BestSellingCombo">@Model.BestSellingCombo</div>
                        <small class="text-warning-emphasis">@Model.BestSellingQuantity lượt bán</small>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-info h-100">
                        <small class="text-muted fw-bold text-uppercase mb-1">Tỷ lệ đơn có Combo</small>
                        <h4 class="fw-bold text-dark mb-0">@Model.ComboAttachRate %</h4>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-success h-100">
                        <small class="text-muted fw-bold text-uppercase mb-1">Tỷ trọng doanh thu</small>
                        <h4 class="fw-bold text-dark mb-0">@Model.ComboRevenueRate %</h4>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-3 border-start border-4 border-warning h-100">
                        <small class="text-muted fw-bold text-uppercase mb-1">Chi tiêu trung bình/Đơn</small>
                        <h4 class="fw-bold text-dark mb-0">@Model.AverageComboPerOrder.ToString("N0") ₫</h4>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">🔥 Top 5 combo bán chạy</h6>
                        <div class="chart-container" style="position: relative; height:250px;"><canvas id="topComboChart"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">💰 Top 5 combo doanh thu</h6>
                        <div class="chart-container" style="position: relative; height:250px;"><canvas id="topRevenueComboChart"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">🥧 Cơ cấu doanh thu</h6>
                        <div class="chart-container" style="position: relative; height:250px;"><canvas id="comboPieChart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="voucher">
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 text-center">
                        <div class="text-muted text-uppercase fw-bold small mb-2">Tổng giảm giá</div>
                        <div class="text-danger fw-bold fs-3">@Model.TotalDiscountAmount.ToString("N0") ₫</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 text-center">
                        <div class="text-muted text-uppercase fw-bold small mb-2">Voucher dùng nhiều nhất</div>
                        <div class="text-primary fw-bold fs-3">@Model.BestVoucher</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100 text-center">
                        <div class="text-muted text-uppercase fw-bold small mb-2">Lượt sử dụng tối đa</div>
                        <div class="text-success fw-bold fs-3">@Model.BestVoucherUsage <small class="fs-6 fw-normal text-muted">lượt</small></div>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">🎟 Top Voucher được sử dụng</h6>
                        <div class="chart-container" style="position: relative; height:350px;"><canvas id="voucherChart"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="card shadow-sm border-0 rounded-4 h-100">
                        <div class="card-header bg-white pt-4 px-4 border-0">
                            <h6 class="fw-bold text-dark mb-0">📋 Chi tiết Voucher</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive" style="max-height: 350px;">
                                <table class="table table-hover custom-table align-middle mb-0">
                                    <thead class="table-light text-secondary sticky-top">
                                        <tr>
                                            <th class="ps-4">Mã Code</th>
                                            <th class="text-center">Đã dùng</th>
                                            <th class="text-end pe-4">Tổng giảm</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.VoucherStatistics)
                                        {
                                            <tr>
                                                <td class="ps-4"><span class="badge bg-light text-dark border py-2 px-3 fw-bold">@item.VoucherCode</span></td>
                                                <td class="text-center fw-medium">@item.UsedCount</td>
                                                <td class="text-end pe-4 text-danger fw-bold">@item.TotalDiscount.ToString("N0") ₫</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="chitiet">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white pt-4 px-4 border-0">
                    <h6 class="fw-bold text-dark mb-0">📋 Thống kê chi tiết Combo</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover custom-table align-middle mb-0">
                            <thead class="table-light text-secondary">
                                <tr>
                                    <th class="ps-4">Tên Combo</th>
                                    <th class="text-center">Số lượng bán</th>
                                    <th class="text-center">Tỷ lệ</th>
                                    <th class="text-end pe-4">Doanh thu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var combo in Model.ComboStatistics)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">@combo.ComboName</td>
                                        <td class="text-center"><span class="badge bg-light text-dark border px-3">@combo.QuantitySold</span></td>
                                        <td class="text-center text-muted">@combo.Percentage %</td>
                                        <td class="text-end pe-4 fw-bold text-success">@combo.Revenue.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Dữ liệu từ Model
        const labelsByDate = @Html.Raw(Json.Serialize(Model.LabelsByDate));
        const revenueByDate = @Html.Raw(Json.Serialize(Model.RevenueByDate));
        const ticketCountByDate = @Html.Raw(Json.Serialize(Model.TicketCountByDate));

        const labelsByMonth = @Html.Raw(Json.Serialize(Model.LabelsByMonth));
        const revenueByMonth = @Html.Raw(Json.Serialize(Model.RevenueByMonth));
        const ticketCountByMonth = @Html.Raw(Json.Serialize(Model.TicketCountByMonth));

        const labelsByYear = @Html.Raw(Json.Serialize(Model.LabelsByYear));
        const revenueByYear = @Html.Raw(Json.Serialize(Model.RevenueByYear));
        const ticketCountByYear = @Html.Raw(Json.Serialize(Model.TicketCountByYear));

        const movieLabels = @Html.Raw(Json.Serialize(Model.MovieLabels));
        const revenueByMovie = @Html.Raw(Json.Serialize(Model.RevenueByMovie));
        const ticketData = @Html.Raw(Json.Serialize(Model.TicketsByMovie));

        const showtimeLabels = @Html.Raw(Json.Serialize(Model.ShowtimeLabels));
        const revenueByShowtime = @Html.Raw(Json.Serialize(Model.RevenueByShowtime));

        const comboPieLabels = @Html.Raw(Json.Serialize(Model.ComboPieLabels));
        const comboPieValues = @Html.Raw(Json.Serialize(Model.ComboPieValues));

        // Hàm tạo Line/Bar Chart tổng quát
        function createMixedChart(id, labels, data1, data2) {
        new Chart(document.getElementById(id), {
        type: 'bar',
        data: {
        labels: labels,
        datasets: [
        { label: 'Doanh thu', data: data1, yAxisID: 'y', backgroundColor: 'rgba(13, 110, 253, 0.8)', borderRadius: 4, maxBarThickness: 50 }, // Thêm giới hạn độ rộng cột
        { label: 'Số vé', data: data2, type: 'line', yAxisID: 'y1', borderColor: '#ffc107', borderWidth: 2, tension: 0.3 }
        ]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });
        }

        // Render Biểu đồ Tổng Quan
        createMixedChart("revenueByDateChart", labelsByDate, revenueByDate, ticketCountByDate);
        createMixedChart("revenueByMonthChart", labelsByMonth, revenueByMonth, ticketCountByMonth);
        createMixedChart("revenueByYearChart", labelsByYear, revenueByYear, ticketCountByYear);

        new Chart(document.getElementById("revenueByMovieChart"), {
        type: 'doughnut',
        data: {
        labels: movieLabels,
        datasets: [{ data: revenueByMovie, hoverOffset: 4 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });

        // Render Biểu đồ Theo Phim
        new Chart(document.getElementById("movieRevenueChart"), {
        type: 'bar',
        data: {
        labels: movieLabels,
        datasets: [{ label: 'Doanh thu (₫)', data: revenueByMovie, backgroundColor: '#198754', borderRadius: 4, maxBarThickness: 50 }]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });

        new Chart(document.getElementById("ticketComparisonChart"), {
        type: 'bar',
        data: {
        labels: movieLabels,
        datasets: [{ label: 'Số lượng vé', data: ticketData, backgroundColor: '#0dcaf0', borderRadius: 4, maxBarThickness: 50 }]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });

        new Chart(document.getElementById("aovChart"), {
        type: 'bar',
        data: {
        labels: ['Hôm nay', 'Tháng này', 'Quý này', 'Năm nay'],
        datasets: [{
        label: 'Giá trị trung bình (VND)',
        data: [@Model.AvgOrderValueToday, @Model.AvgOrderValueMonth, @Model.AvgOrderValueQuarter, @Model.AvgOrderValueYear],
        backgroundColor: ['rgba(255, 99, 132, 0.8)', 'rgba(54, 162, 235, 0.8)', 'rgba(255, 206, 86, 0.8)', 'rgba(75, 192, 192, 0.8)'],
        borderRadius: 4,
        maxBarThickness: 50
        }]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });

        new Chart(document.getElementById("monthCompareChart"), {
        type: 'bar',
        data: {
        labels: ['Tháng trước', 'Tháng này'],
        datasets: [{
        label: 'Doanh thu (VND)',
        data: [@Model.RevenueLastMonth, @Model.RevenueCurrentMonth],
        backgroundColor: ['rgba(108, 117, 125, 0.8)', 'rgba(25, 135, 84, 0.8)'],
        borderRadius: 4,
        maxBarThickness: 50
        }]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });

        // Render Biểu đồ Suất chiếu (Đây chính là biểu đồ bị mập trong ảnh của bạn)
        new Chart(document.getElementById("showtimeRevenueChart"), {
        type: 'bar',
        data: {
        labels: showtimeLabels,
        datasets: [{ label: 'Doanh thu (₫)', data: revenueByShowtime, backgroundColor: '#6f42c1', borderRadius: 4, maxBarThickness: 50 }]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });

        // Render Biểu đồ Combo
        new Chart(document.getElementById('topComboChart'), {
        type: 'bar',
        data: {
        labels: @Html.Raw(Json.Serialize(Model.TopComboLabels)),
        datasets: [{ label: 'Số lượng bán', data: @Html.Raw(Json.Serialize(Model.TopComboValues)), backgroundColor: '#0d6efd', borderRadius: 4, maxBarThickness: 50 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });

        new Chart(document.getElementById('topRevenueComboChart'), {
        type: 'bar',
        data: {
        labels: @Html.Raw(Json.Serialize(Model.TopRevenueComboLabels)),
        datasets: [{ label: 'Doanh thu (₫)', data: @Html.Raw(Json.Serialize(Model.TopRevenueComboValues)), backgroundColor: '#198754', borderRadius: 4, maxBarThickness: 50 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });

        new Chart(document.getElementById("comboPieChart"), {
        type: 'pie',
        data: {
        labels: comboPieLabels,
        datasets: [{ data: comboPieValues, hoverOffset: 4 }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
        });

        // Render Biểu đồ Voucher
        const voucherCtx = document.getElementById('voucherChart');
        if (voucherCtx) {
        new Chart(voucherCtx, {
        type: 'bar',
        data: {
        labels: @Html.Raw(Json.Serialize(Model.VoucherLabels)),
        datasets: [{ label: 'Lượt sử dụng', data: @Html.Raw(Json.Serialize(Model.VoucherValues)), backgroundColor: '#dc3545', borderRadius: 4, maxBarThickness: 50 }]
        },
        options: { responsive: true, maintainAspectRatio: false }
        });
        }
    </script>
}