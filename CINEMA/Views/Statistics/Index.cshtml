@model CINEMA.ViewModels.RevenueDashboardViewModel
@{
    ViewData["Title"] = "Báo cáo doanh thu chi tiết";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/revenue-dashboard.css" />
    <style>
        /* CSS nội bộ hỗ trợ các yếu tố Glassmorphism & Visual Premium */
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        }
        .gradient-primary {
            background: linear-gradient(135deg, #0d6efd 0%, #00d2ff 100%);
            color: white;
        }
        .gradient-success {
            background: linear-gradient(135deg, #198754 0%, #56ab2f 100%);
            color: white;
        }
        .gradient-warning {
            background: linear-gradient(135deg, #ffc107 0%, #ff8c00 100%);
            color: white;
        }
        .gradient-danger {
            background: linear-gradient(135deg, #dc3545 0%, #ff758c 100%);
            color: white;
        }
        .gradient-purple {
            background: linear-gradient(135deg, #6f42c1 0%, #b883ff 100%);
            color: white;
        }
        .nav-pills-premium {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(0, 0, 0, 0.06);
            padding: 5px;
            border-radius: 30px;
        }
        .nav-pills-premium .nav-link {
            border-radius: 25px;
            color: #5a626a;
            font-weight: 600;
            padding: 8px 20px;
            transition: all 0.25s ease;
        }
        .nav-pills-premium .nav-link:hover {
            color: #0d6efd;
            background: rgba(13, 110, 253, 0.05);
        }
        .nav-pills-premium .nav-link.active {
            background: linear-gradient(90deg, #0d6efd 0%, #0284c7 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(13, 110, 253, 0.2);
        }
        .table-premium th {
            background-color: #f8f9fa;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.78rem;
            color: #495057;
            letter-spacing: 0.6px;
            border-bottom: 2px solid #eef2f5;
        }
        .table-premium td {
            font-size: 0.9rem;
            padding: 14px 16px;
        }
        .badge-vip {
            background: linear-gradient(135deg, #f2b705 0%, #d4af37 100%);
            color: #12141c;
            font-weight: 700;
            text-shadow: 0 1px 1px rgba(255,255,255,0.3);
        }
    </style>
}

<div class="container-fluid py-4">
    <!-- TIÊU ĐỀ TRANG VÀ NÚT XUẤT CSV -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold text-primary mb-0 d-flex align-items-center">
                <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                    <i class="bi bi-graph-up-arrow fs-5"></i>
                </div>
                Trung tâm Phân tích Doanh thu CineZone
            </h4>
            <p class="text-muted ms-5 ps-2 mb-0 mt-1">
                @if (Model.FromDate.HasValue || Model.ToDate.HasValue)
                {
                    var today = DateTime.Today;
                    var defaultFrom = new DateTime(today.Year, today.Month, 1);
                    if (Model.FromDate == defaultFrom && Model.ToDate == today)
                    {
                        <span>Báo cáo mặc định: <strong>Tháng hiện tại (@today.ToString("MM/yyyy"))</strong></span>
                    }
                    else
                    {
                        <span>Báo cáo lọc: <strong>@Model.FromDate?.ToString("dd/MM/yyyy") - @Model.ToDate?.ToString("dd/MM/yyyy")</strong></span>
                    }
                }
                else
                {
                    <span>Báo cáo: <strong>Toàn thời gian</strong></span>
                }
                @if (ViewBag.SelectedTheaterId != null && (int)ViewBag.SelectedTheaterId > 0)
                {
                    var theaterName = (ViewBag.Theaters as List<CINEMA.Models.Theater>)?.FirstOrDefault(t => t.TheaterId == (int)ViewBag.SelectedTheaterId)?.Name;
                    <span> | Rạp: <strong>@theaterName</strong></span>
                }
                @if (ViewBag.SelectedMovieId != null && (int)ViewBag.SelectedMovieId > 0)
                {
                    var movieName = (ViewBag.Movies as List<CINEMA.Models.Movie>)?.FirstOrDefault(m => m.MovieId == (int)ViewBag.SelectedMovieId)?.Title;
                    <span> | Phim: <strong>@movieName</strong></span>
                }
            </p>
        </div>

        <div class="d-flex gap-2">
            <button onclick="exportToCSV()" class="btn btn-success rounded-pill px-4 fw-medium shadow-sm d-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-spreadsheet fs-5"></i> Xuất Báo Cáo CSV
            </button>
        </div>
    </div>

    <!-- BỘ LỌC ĐA NĂNG ĐỒNG BỘ -->
    <div class="bg-white p-3 rounded-4 shadow-sm border mb-4">
        <form id="filterForm" method="get" class="row g-3 align-items-center">
            <!-- Chọn tháng nhanh -->
            <div class="col-md-3 border-end">
                <label class="text-muted small fw-semibold d-block mb-1"><i class="bi bi-calendar3 me-1"></i>Chọn nhanh tháng</label>
                <select id="quickMonthFilter" class="form-select form-select-sm border-0 bg-light fw-medium text-primary">
                    <option value="">-- Chọn tháng --</option>
                    @for (int i = 0; i < 12; i++)
                    {
                        var targetMonth = DateTime.Today.AddMonths(-i);
                        var valString = targetMonth.ToString("yyyy-MM");
                        var displayString = $"Tháng {targetMonth.ToString("MM/yyyy")}";
                        <option value="@valString">@displayString</option>
                    }
                </select>
            </div>

            <!-- Từ ngày -->
            <div class="col-md-2 border-end">
                <label class="text-muted small fw-semibold d-block mb-1">Từ ngày</label>
                <input type="date" id="inputFrom" name="from" class="form-control form-control-sm border-0 bg-light fw-medium" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <!-- Đến ngày -->
            <div class="col-md-2 border-end">
                <label class="text-muted small fw-semibold d-block mb-1">Đến ngày</label>
                <input type="date" id="inputTo" name="to" class="form-control form-control-sm border-0 bg-light fw-medium" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <!-- Lọc theo Rạp -->
            <div class="col-md-2 border-end">
                <label class="text-muted small fw-semibold d-block mb-1"><i class="bi bi-building me-1"></i>Rạp chiếu</label>
                <select name="theaterId" class="form-select form-select-sm border-0 bg-light fw-medium text-primary">
                    <option value="">-- Tất cả rạp --</option>
                    @foreach (var th in ViewBag.Theaters as List<CINEMA.Models.Theater>)
                    {
                        <option value="@th.TheaterId" selected="@(ViewBag.SelectedTheaterId == th.TheaterId ? "selected" : null)">@th.Name</option>
                    }
                </select>
            </div>

            <!-- Lọc theo Phim -->
            <div class="col-md-2 border-end">
                <label class="text-muted small fw-semibold d-block mb-1"><i class="bi bi-film me-1"></i>Phim chiếu</label>
                <select name="movieId" class="form-select form-select-sm border-0 bg-light fw-medium text-primary">
                    <option value="">-- Tất cả phim --</option>
                    @foreach (var mv in ViewBag.Movies as List<CINEMA.Models.Movie>)
                    {
                        <option value="@mv.MovieId" selected="@(ViewBag.SelectedMovieId == mv.MovieId ? "selected" : null)">@mv.Title</option>
                    }
                </select>
            </div>

            <!-- Nút Lọc -->
            <div class="col-md-1">
                <label class="d-none d-md-block mb-1">&nbsp;</label>
                <button type="submit" class="btn btn-primary btn-sm w-100 rounded-pill px-3 fw-bold">
                    <i class="bi bi-funnel"></i> Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- HỆ THỐNG TABS DƯỚI DẠNG THÀNH PHẦN PREMIUM -->
    <div class="d-flex justify-content-center mb-4">
        <ul class="nav nav-pills nav-pills-premium gap-1 shadow-sm" id="dashboardTabs" role="tablist">
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tongquan" type="button"><i class="bi bi-grid-1x2-fill me-1"></i> Tổng Quan Tài Chính</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#phim" type="button"><i class="bi bi-film me-1"></i> Theo Phim</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#suatchieu" type="button"><i class="bi bi-calendar2-week-fill me-1"></i> Suất Chiếu</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#raproom" type="button"><i class="bi bi-building-fill me-1"></i> Hiệu Suất Rạp & Phòng</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#giovang" type="button"><i class="bi bi-clock-history me-1"></i> Giờ & Ngày Vàng</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#combo" type="button"><i class="bi bi-cup-straw me-1"></i> Thống kê Combo</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#voucher" type="button"><i class="bi bi-ticket-perforated-fill me-1"></i> Voucher</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#vip" type="button"><i class="bi bi-gem me-1"></i> Top Khách Hàng VIP</button></li>
            <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#chitiet" type="button"><i class="bi bi-table me-1"></i> Chi Tiết Bảng</button></li>
        </ul>
    </div>

    <!-- NỘI DUNG CHI TIẾT TỪNG TABS -->
    <div class="tab-content" id="dashboardTabsContent">
        <!-- 1. Tab Tổng Quan Tài Chính -->
        <div class="tab-pane fade show active" id="tongquan">
            <!-- KPIs Lớn Tài Chính -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 gradient-success glass-card h-100">
                        <div class="text-white-50 text-uppercase fw-bold small mb-2"><i class="bi bi-wallet2 me-1"></i> Doanh thu thuần (Net)</div>
                        <div class="text-white fw-bold fs-2 mb-1">@Model.NetRevenue.ToString("N0") ₫</div>
                        <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3">Doanh thu thực nhận</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 gradient-primary glass-card h-100">
                        <div class="text-white-50 text-uppercase fw-bold small mb-2"><i class="bi bi-ticket-detailed me-1"></i> Doanh thu vé gộp</div>
                        <div class="text-white fw-bold fs-2 mb-1">@Model.TicketRevenue.ToString("N0") ₫</div>
                        <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3">@Model.TotalTickets vé bán ra</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 gradient-warning glass-card h-100">
                        <div class="text-white-50 text-uppercase fw-bold small mb-2"><i class="bi bi-cup-straw me-1"></i> Doanh thu combo gộp</div>
                        <div class="text-white fw-bold fs-2 mb-1">@Model.GrossComboRevenue.ToString("N0") ₫</div>
                        <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3">@Model.ComboSold Combo đã bán</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-4 gradient-danger glass-card h-100">
                        <div class="text-white-50 text-uppercase fw-bold small mb-2"><i class="bi bi-tags-fill me-1"></i> Chiết khấu voucher</div>
                        <div class="text-white fw-bold fs-2 mb-1">@Model.TotalDiscount.ToString("N0") ₫</div>
                        <span class="badge bg-white bg-opacity-25 text-white rounded-pill px-3">@Model.VoucherUsageRate% đơn dùng voucher</span>
                    </div>
                </div>
            </div>

            <!-- Phân tích Đơn hàng & Lập doanh thu ngày -->
            <div class="row g-4 mb-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">📈 Xu hướng Doanh thu & Lượt Vé theo ngày</h6>
                        <div class="chart-container" style="position: relative; height:320px;"><canvas id="revenueByDateChart"></canvas></div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-3">💳 Phương thức thanh toán</h6>
                        <div class="chart-container mb-3" style="position: relative; height:180px;"><canvas id="paymentMethodChart"></canvas></div>
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless align-middle mb-0">
                                <tbody>
                                    @foreach (var pm in Model.PaymentMethodStats)
                                    {
                                        <tr>
                                            <td><span class="fw-semibold"><i class="bi bi-credit-card me-2 text-primary"></i>@pm.PaymentMethod</span></td>
                                            <td class="text-center text-muted">@pm.OrderCount đơn</td>
                                            <td class="text-end fw-bold text-success">@pm.TotalRevenue.ToString("N0") ₫</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Doanh thu theo tháng & năm -->
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h6 class="fw-bold text-dark mb-4">📆 Doanh thu theo tháng</h6>
                        <div class="chart-container" style="position: relative; height:250px;"><canvas id="revenueByMonthChart"></canvas></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h6 class="fw-bold text-dark mb-4">📊 Doanh thu theo năm</h6>
                        <div class="chart-container" style="position: relative; height:250px;"><canvas id="revenueByYearChart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Tab Theo Phim -->
        <div class="tab-pane fade" id="phim">
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-info">
                        <div class="text-muted small fw-bold text-uppercase mb-1">Đang / Sắp chiếu</div>
                        <div class="text-info fw-bold fs-4">@Model.NowShowingCount / @Model.ComingSoonCount</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-primary">
                        <div class="text-muted small fw-bold text-uppercase mb-1">Phim bán chạy nhất</div>
                        <div class="text-primary fw-bold text-truncate" title="@Model.TopSellingMovie">@Model.TopSellingMovie</div>
                        <small class="text-muted">@Model.TopSellingTickets vé</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-danger">
                        <div class="text-muted small fw-bold text-uppercase mb-1">Phim bán chậm nhất</div>
                        <div class="text-danger fw-bold text-truncate" title="@Model.LeastSellingMovie">@Model.LeastSellingMovie</div>
                        <small class="text-muted">@Model.LeastSellingTickets vé</small>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 border-start border-4 border-success">
                        <div class="text-muted small fw-bold text-uppercase mb-1">Top doanh thu phim</div>
                        <div class="text-success fw-bold text-truncate" title="@Model.TopRevenueMovie">@Model.TopRevenueMovie</div>
                        <small class="text-muted">@Model.TopRevenueAmount.ToString("N0") ₫</small>
                    </div>
                </div>
            </div>

            <!-- Khối biểu đồ phân tích phim & AOV -->
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">📊 Doanh thu chi tiết theo Phim</h6>
                        <div class="chart-container" style="position: relative; height:300px;"><canvas id="movieRevenueChart"></canvas></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">🎟️ Tỷ trọng Số lượng vé đã bán</h6>
                        <div class="chart-container" style="position: relative; height:300px;"><canvas id="ticketComparisonChart"></canvas></div>
                    </div>
                </div>
            </div>

            <!-- So sánh AOV và tháng gần nhất -->
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h6 class="fw-bold text-dark mb-4">💰 Giá trị đơn hàng trung bình (AOV)</h6>
                        <div class="chart-container" style="position: relative; height:250px;"><canvas id="aovChart"></canvas></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4">
                        <h6 class="fw-bold text-dark mb-4">⚖️ So sánh doanh thu 2 tháng gần nhất</h6>
                        <div class="chart-container" style="position: relative; height:250px;"><canvas id="monthCompareChart"></canvas></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Tab Suất Chiếu -->
        <div class="tab-pane fade" id="suatchieu">
            <div class="card shadow-sm border-0 rounded-4 mb-4 p-4">
                <h6 class="fw-bold text-dark mb-4">🎬 Hiệu suất Doanh thu theo khung giờ chiếu chi tiết</h6>
                <div class="chart-container" style="position: relative; height:350px;"><canvas id="showtimeRevenueChart"></canvas></div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white pt-4 px-4 border-0">
                    <h6 class="fw-bold text-dark mb-0">📋 Bảng thống kê doanh thu theo suất chiếu</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-premium align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Mã SC</th>
                                    <th>Phim</th>
                                    <th class="text-center">Thời gian chiếu</th>
                                    <th class="text-center">Phòng chiếu</th>
                                    <th class="text-center">Vé bán ra</th>
                                    <th class="text-end pe-4">Doanh thu vé</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ShowtimeStatistics)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-primary">#@item.ShowtimeId</td>
                                        <td class="fw-semibold">@item.MovieName</td>
                                        <td class="text-center text-muted small"><i class="bi bi-clock me-1"></i> @item.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="text-center fw-medium">@item.AuditoriumName</td>
                                        <td class="text-center"><span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2">@item.TicketCount</span></td>
                                        <td class="text-end pe-4 fw-bold text-success">@item.Revenue.ToString("N0") ₫</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Tab Rạp & Phòng Chiếu -->
        <div class="tab-pane fade" id="raproom">
            <div class="row g-4 mb-4">
                <!-- Bảng xếp hạng doanh số Rạp -->
                <div class="col-lg-7">
                    <div class="card shadow-sm border-0 rounded-4 h-100">
                        <div class="card-header bg-white pt-4 px-4 border-0">
                            <h6 class="fw-bold text-dark mb-0">🏢 Thống kê doanh số theo Rạp chiếu</h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover table-premium align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th class="ps-4">Rạp</th>
                                            <th class="text-center">Vé bán</th>
                                            <th class="text-end">Doanh thu vé</th>
                                            <th class="text-end">Doanh thu Combo</th>
                                            <th class="text-end">Tổng doanh số</th>
                                            <th class="text-center pe-4">Tỷ lệ lấp đầy</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var th in Model.TheaterRevenues)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-semibold"><i class="bi bi-building text-primary me-2"></i>@th.TheaterName</td>
                                                <td class="text-center fw-medium">@th.TicketsSold</td>
                                                <td class="text-end">@th.TicketRevenue.ToString("N0") ₫</td>
                                                <td class="text-end text-muted">@th.ComboRevenue.ToString("N0") ₫</td>
                                                <td class="text-end fw-bold text-success">@th.TotalRevenue.ToString("N0") ₫</td>
                                                <td class="text-center pe-4 fw-bold text-primary">@th.OccupancyRate%</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- So sánh rạp bằng biểu đồ -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-4">📊 Doanh thu các Rạp chi nhánh</h6>
                        <div class="chart-container" style="position: relative; height:300px;"><canvas id="theaterComparisonChart"></canvas></div>
                    </div>
                </div>
            </div>

            <!-- Bảng xếp hạng Top 10 Phòng Chiếu -->
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white pt-4 px-4 border-0">
                    <h6 class="fw-bold text-dark mb-0">📋 Top 10 Phòng chiếu có Doanh thu cao nhất</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-premium align-middle mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Thứ tự</th>
                                    <th>Tên Phòng</th>
                                    <th>Thuộc Rạp</th>
                                    <th class="text-center">Số vé đã bán</th>
                                    <th class="text-end pe-4">Tổng doanh thu vé</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int roomIndex = 1; }
                                @foreach (var room in Model.RoomRevenues)
                                {
                                    <tr>
                                        <td class="ps-4 text-muted fw-bold">#@roomIndex</td>
                                        <td class="fw-semibold text-primary">@room.RoomName</td>
                                        <td>@room.TheaterName</td>
                                        <td class="text-center fw-medium">@room.TicketsSold</td>
                                        <td class="text-end pe-4 fw-bold text-success">@room.Revenue.ToString("N0") ₫</td>
                                    </tr>
                                    roomIndex++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Tab Giờ & Ngày Vàng -->
        <div class="tab-pane fade" id="giovang">
            <div class="row g-4 mb-4">
                <!-- Biểu đồ Khung Giờ Vàng -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-2">⏰ Phân tích Khung Giờ chiếu đặt vé (Peak Hours)</h6>
                        <p class="text-muted small mb-4">Biểu diễn lượng vé và doanh số bán ra theo 4 khung giờ vàng trong ngày</p>
                        <div class="chart-container" style="position: relative; height:320px;"><canvas id="peakHoursChart"></canvas></div>
                    </div>
                </div>
                <!-- Biểu đồ Ngày Vàng Trong Tuần -->
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h6 class="fw-bold text-dark mb-2">📅 Phân tích Ngày chiếu đặt vé (Peak Days)</h6>
                        <p class="text-muted small mb-4">Xác định các ngày có lượng đặt vé đột biến trong tuần để tối ưu chi phí</p>
                        <div class="chart-container" style="position: relative; height:320px;"><canvas id="peakDaysChart"></canvas></div>
                    </div>
                </div>
