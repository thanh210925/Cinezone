@model CINEMA.Models.Position

@{
    Layout = "_AdminLayout";
}

<h3>Sửa chức vụ</h3>

<form asp-action="Edit" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="PositionId" />

    <div class="mb-3">
        <label>Tên chức vụ</label>

        <input asp-for="PositionName"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Mô tả</label>

        <textarea asp-for="Description"
                  class="form-control"></textarea>
    </div>

    <div class="mb-3">
    <label>Hệ số lương</label>
    <input asp-for="SalaryCoefficient" class="form-control" type="number" step="0.1" />
</div>

    <div class="mb-3">

        <label>Trạng thái</label>

        <select asp-for="IsActive"
                class="form-select">

            <option value="true">
                Hoạt động
            </option>

            <option value="false">
                Khóa
            </option>

        </select>

    </div>

    <button class="btn btn-success">
        Lưu
    </button>

</form>