@model IEnumerable<CINEMA.Models.Position>

@{
    ViewData["Title"] = "Quản lý chức vụ";
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between mb-4">
        <h3>Quản lý chức vụ</h3>

        <a asp-action="Create"
           class="btn btn-primary">
            Thêm chức vụ
        </a>
    </div>

    <form method="get">
        <div class="input-group mb-3">

            <input name="search"
                   class="form-control"
                   placeholder="Tìm chức vụ..." />

            <button class="btn btn-secondary">
                Tìm
            </button>

        </div>
    </form>

    <table class="table table-bordered table-hover">

        <thead>
            <tr>
                <th>ID</th>
                <th>Tên chức vụ</th>
                <th>Mô tả</th>
                <th>Trạng thái</th>
                <th width="160"></th>
                <th>Hệ số lương</th>

			</tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.PositionId</td>

                    <td>@item.PositionName</td>

                    <td>@item.Description</td>

                   

                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">
                                Hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                Khóa
                            </span>
                        }
                    </td>

                    

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@item.PositionId"
                           class="btn btn-warning btn-sm">
                            Sửa
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@item.PositionId"
                              method="post"
                              style="display:inline">

                            <button class="btn btn-danger btn-sm">
                                Xóa
                            </button>

                        </form>

                    </td>

                    <td>@item.SalaryCoefficient</td>

                </tr>
            }
        </tbody>

    </table>

</div>