@model CINEMA.Models.Position

@{
    Layout = "_AdminLayout";
}

<h3>Thêm chức vụ</h3>

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label>Tên chức vụ</label>

        <input asp-for="PositionName"
               class="form-control" />

        <span asp-validation-for="PositionName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Mô tả</label>

        <textarea asp-for="Description"
                  class="form-control"></textarea>
    </div>

    <button class="btn btn-success">
        Lưu
    </button>

</form>