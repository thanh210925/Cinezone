@model IEnumerable<CINEMA.Models.Customer>
@{
    ViewData["Title"] = "Quản lý khách hàng";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/customer/customer-management.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active">Quản lý khách hàng</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <h4 class="fw-bold text-primary mb-0 d-flex align-items-center">
                <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                    <i class="bi bi-people fs-5"></i>
                </div>
                Danh sách khách hàng
                <span class="badge bg-light text-secondary border ms-3 fw-medium fs-6" id="totalCustomersBadge">
                    Tổng: @(Model?.Count() ?? 0)
                </span>
            </h4>

            <div class="d-flex align-items-center gap-2 ms-auto">
                <div class="input-group" style="width: 320px;">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0"
                           placeholder="Tìm tên, email, SĐT..." onkeyup="searchCustomers()">
                </div>
                <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium">
                    <i class="bi bi-person-plus me-1"></i> Thêm mới
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle custom-table mb-0" id="customerTable">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Họ và tên</th>
                            <th>Thông tin liên hệ</th>
                            <th class="text-center">Giới tính</th>
                            <th class="text-center">Ngày sinh</th>
                            <th class="text-center">Đăng nhập cuối</th>
                            <th class="text-center pe-4" width="12%">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var c in Model)
                            {
                                <tr class="customer-row">
                                    <td class="ps-4">
                                        <span class="fw-bold text-primary">#@c.CustomerId</span>
                                    </td>
                                    <td class="fw-bold text-dark">
                                        @c.FullName
                                        <div class="small text-muted fw-normal mt-1">Gia nhập: @(c.CreatedAt.HasValue ? c.CreatedAt.Value.ToString("dd/MM/yyyy") : "-")</div>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark"><i class="bi bi-telephone text-muted me-1 small"></i> @c.Phone</div>
                                        <div class="small text-muted mt-1"><i class="bi bi-envelope text-muted me-1 small"></i> @c.Email</div>
                                    </td>
                                    <td class="text-center">
                                        @if (c.Gender?.ToLower() == "nam" || c.Gender?.ToLower() == "male")
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3">
                                                <i class="bi bi-gender-male me-1"></i> Nam
                                            </span>
                                        }
                                        else if (c.Gender?.ToLower() == "nữ" || c.Gender?.ToLower() == "female")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">
                                                <i class="bi bi-gender-female me-1"></i> Nữ
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">
                                                @c.Gender
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center text-muted">
                                        @(c.BirthDate.HasValue ? c.BirthDate.Value.ToString("dd/MM/yyyy") : "—")
                                    </td>
                                    <td class="text-center text-muted small">
                                        @(c.LastLogin.HasValue ? c.LastLogin.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa từng")
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Details" asp-route-id="@c.CustomerId" class="btn btn-light btn-sm text-info action-btn" data-bs-toggle="tooltip" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-light btn-sm text-warning action-btn" data-bs-toggle="tooltip" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khách hàng @c.FullName?');">
                                                <input type="hidden" name="id" value="@c.CustomerId" />
                                                <button type="submit" class="btn btn-light btn-sm text-danger action-btn" data-bs-toggle="tooltip" title="Xóa">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="emptyStateRow">
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-person-vcard fs-1 d-block mb-3 opacity-50"></i>
                                    <h5 class="fw-bold text-dark">Chưa có khách hàng nào!</h5>
                                    <p class="mb-0">Hãy thêm khách hàng đầu tiên vào hệ thống.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/customer/customeradmin-index.js" asp-append-version="true"></script>
}