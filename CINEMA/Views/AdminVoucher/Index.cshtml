@model List<CINEMA.Models.Voucher>
@{
    ViewData["Title"] = "Quản lý Voucher";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/voucher-management.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active">Quản lý Voucher</li>
        </ol>
    </nav>

    <!-- Thông báo Success (Được style lại hiện đại hơn) -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3"></i>
            <div>
                <strong>Thành công!</strong> @TempData["Success"]
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- HEADER & CARD -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <h4 class="fw-bold text-primary mb-0 d-flex align-items-center">
                <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                    <i class="bi bi-ticket-perforated fs-5"></i>
                </div>
                Danh sách Voucher
            </h4>

            <a href="/AdminVoucher/Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium">
                <i class="bi bi-plus-lg me-1"></i> Tạo voucher mới
            </a>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table mb-0">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th class="ps-4">Mã Voucher</th>
                                <th class="text-center">Mức giảm</th>
                                <th class="text-end">Đơn tối thiểu</th>
                                <th class="text-center">Phạm vi áp dụng</th>
                                <th class="text-center">Thời gian áp dụng</th>
                                <th class="text-center">Tình trạng</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-center pe-4">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="badge bg-primary fs-6 fw-bold text-uppercase px-3 py-2 shadow-sm" style="letter-spacing: 1px;">
                                            @v.Code
                                        </span>
                                    </td>

                                    <td class="text-center fw-medium text-danger">
                                        @if (v.DiscountPercent > 0)
                                        {
                                            <span>@v.DiscountPercent%</span>
                                        }
                                        else if (v.DiscountAmount > 0)
                                        {
                                            <span>@String.Format("{0:N0} ₫", v.DiscountAmount)</span>
                                        }
                                    </td>

                                    <td class="text-end text-muted fw-medium">
                                        @String.Format("{0:N0} ₫", v.MinOrderValue)
                                    </td>

                                    <td class="text-center">
                                        @if (v.VoucherCondition != null)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">@v.VoucherCondition.Name</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3">Không giới hạn</span>
                                        }
                                    </td>

                                    <td class="text-center text-muted small">
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="text-success"><i class="bi bi-play-circle me-1"></i> @v.StartDate?.ToString("dd/MM/yyyy")</span>
                                            <span class="text-danger"><i class="bi bi-stop-circle me-1"></i> @v.EndDate?.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        <div class="small">
                                            <span class="text-muted">Đã dùng: </span><strong class="text-dark">@v.UsedCount</strong> / @v.Quantity
                                        </div>
                                        <div class="progress mt-1 mx-auto" style="height: 6px; width: 80px;">
                                            @{
                                                var percent = v.Quantity > 0 ? (v.UsedCount * 100) / v.Quantity : 0;
                                                var barColor = percent >= 100 ? "bg-danger" : "bg-primary";
                                            }
                                            <div class="progress-bar @barColor" role="progressbar" style="width: @percent%"></div>
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        @if (!v.IsActive)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">Tắt</span>
                                        }
                                        else if (v.UsedCount >= v.Quantity)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">Hết lượt</span>
                                        }
                                        else if (v.StartDate > DateTime.Now)
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3">Chưa bắt đầu</span>
                                        }
                                        else if (v.EndDate < DateTime.Now)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3">Hết hạn</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Hoạt động</span>
                                        }
                                    </td>

                                    <td class="text-center pe-4">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="/AdminVoucher/Edit/@v.VoucherId" class="btn btn-light btn-sm text-warning action-btn" data-bs-toggle="tooltip" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a href="/AdminVoucher/Delete/@v.VoucherId" class="btn btn-light btn-sm text-danger action-btn" onclick="return confirm('Xóa voucher này?')" data-bs-toggle="tooltip" title="Xóa">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-ticket-perforated fs-1 d-block mb-3 opacity-50"></i>
                    <h5 class="fw-bold text-dark">Chưa có Voucher nào!</h5>
                    <p class="mb-0">Hãy tạo mã giảm giá đầu tiên cho khách hàng.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            })
        });
    </script>
}