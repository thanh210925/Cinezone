<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CINEZONE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CINEMA.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow fixed-top">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <img src="/images/unnamed.jpg" class="footer-logo" />
                    CineZone
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Schedule">
                                <i class="bi bi-calendar-event"></i> Lịch chiếu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-primary" href="#" data-bs-toggle="modal" data-bs-target="#modalMembershipSummary">
                                <i class="bi bi-gem"></i> Thành viên
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (Context.Session.GetString("CustomerName") == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Đăng ký
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    Xin chào, @Context.Session.GetString("CustomerName")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Customer" asp-action="Profile">Hồ sơ cá nhân</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Tickets" asp-action="MyTickets">Vé của tôi</a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Customer" asp-action="Logout">Đăng xuất</a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 main-content flex-grow-1" style="margin-top: 70px;">
        @RenderBody()
    </main>

    <footer class="footer-cinezone text-white pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row gy-4 text-center text-lg-start">
                <div class="col-12 col-md-6 col-lg-3">
                    <img src="/images/unnamed.jpg" class="footer-logo mb-3" />
                    <p class="small mb-3">Điểm hẹn điện ảnh</p>
                    <a asp-controller="Home" asp-action="Schedule" class="btn btn-warning fw-bold px-4 rounded-pill">
                        🎟 ĐẶT VÉ
                    </a>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="footer-title">Tài khoản</h6>
                    <a asp-controller="Customer" asp-action="Login" class="footer-link">Đăng nhập</a>
                    <a asp-controller="Customer" asp-action="Register" class="footer-link">Đăng ký</a>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="footer-title">Xem phim</h6>
                    <a asp-controller="Home" asp-action="Index" class="footer-link">Phim đang chiếu</a>
                    <a asp-controller="Home" asp-action="Index" class="footer-link">Phim sắp chiếu</a>
                </div>

                <div class="col-6 col-md-6 col-lg-2">
                    <h6 class="footer-title">Dịch vụ</h6>
                    <a href="#" class="footer-link">Thuê rạp</a>
                </div>

                <div class="col-6 col-md-6 col-lg-3">
                    <h6 class="footer-title">Hệ thống rạp</h6>
                    <a href="#" class="footer-link">CineZone Quận 1</a>
                </div>
            </div>

            <hr class="border-light opacity-25 my-4">

            <div class="footer-bottom d-flex flex-column flex-md-row justify-content-between align-items-center">
                <div class="mb-2 mb-md-0">© 2026 <strong>CineZone</strong></div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy" class="footer-link mb-0">Chính sách bảo mật</a>
                    <a href="#" class="footer-link mb-0">Hỏi & Đáp</a>
                </div>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="modalMembershipSummary" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title"><i class="bi bi-award"></i> Chính sách thành viên CineZone</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="row g-3 text-center">
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-3">
                                <h3 class="display-6">🥉</h3>
                                <h5 class="fw-bold" style="color: #e67e22;">Hạng ĐỒNG</h5>
                                <small class="text-muted">0 - 3 triệu đ</small>
                                <hr>
                                <ul class="list-unstyled small text-start">
                                    <li><i class="bi bi-check2 text-success"></i> Tích điểm cơ bản </li>
                                    <li><i class="bi bi-check2 text-success"></i> Quà bắp nước sinh nhật</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-3 border-top border-secondary border-4">
                                <h3 class="display-6">🥈</h3>
                                <h5 class="fw-bold text-secondary">Hạng BẠC</h5>
                                <small class="text-muted">3 - 10 triệu đ</small>
                                <hr>
                                <ul class="list-unstyled small text-start">
                                    <li><i class="bi bi-check2 text-success"></i> Giảm giá 3%</li>
                                    <li><i class="bi bi-check2 text-success"></i> Tặng cặp vé sinh nhật</li>
                                    <li><i class="bi bi-check2 text-success"></i> Ưu đãi Happy Day</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-3 border-top border-primary border-4 text-white" style="background: linear-gradient(135deg, #3498db, #2c3e50);">
                                <h3 class="display-6">💎</h3>
                                <h5 class="fw-bold">KIM CƯƠNG</h5>
                                <small class="text-light">> 10 triệu đ</small>
                                <hr>
                                <ul class="list-unstyled small text-start">
                                    <li><i class="bi bi-check2 text-info"></i> Giảm giá 10%</li>
                                    <li><i class="bi bi-check2 text-info"></i> Quà sinh nhật VIP</li>
                                    <li><i class="bi bi-check2 text-info"></i> Quầy vé ưu tiên</li>
                                    <li><i class="bi bi-check2 text-info"></i> Nâng cấp ghế FREE</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-4">
                        @if (Context.Session.GetString("CustomerName") != null)
                        {
                            <a asp-controller="Customer" asp-action="Profile" class="btn btn-outline-primary rounded-pill">Xem tiến trình của tôi</a>
                        }
                        else
                        {
                            <a asp-controller="Customer" asp-action="Register" class="btn btn-primary rounded-pill px-4">Đăng ký thành viên ngay</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="chat-toggle">💬</div>

    <div id="chatbox">
        <div id="chat-header">
            🎬 Hỗ trợ đặt vé
            <span onclick="toggleChat()" style="cursor: pointer;">✖</span>
        </div>

        <div id="chat-body">
            <div class="message bot">
                <div class="avatar">🤖</div>
                <div class="bubble">Xin chào! Bạn cần gì?</div>
            </div>

            <div class="suggestions">
                <button onclick="quickAsk('phim đang chiếu')">🎬 Phim đang chiếu</button>
                <button onclick="quickAsk('lịch chiếu')">⏰ Lịch chiếu</button>
                <button onclick="quickAsk('ghế trống')">💺 Ghế trống</button>
            </div>
        </div>

        <div class="chat-input">
            <input id="chatInput" placeholder="Nhập câu hỏi..." />
            <button onclick="sendMessage()">➤</button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // SCRIPT POPUP
        document.addEventListener("DOMContentLoaded", function () {
        const popup = document.getElementById("promoPopup");
        const closeBtn = document.getElementById("closePopup");

        if (!popup) return;

        if (closeBtn) {
        closeBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        popup.style.display = "none";
        });
        }

        popup.addEventListener("click", function (e) {
        if (e.target === popup) {
        popup.style.display = "none";
        }
        });
        });

        // SCRIPT CHATBOX
        function toggleChat() {
        let box = document.getElementById("chatbox");
        box.style.display = box.style.display === "none" || box.style.display === "" ? "block" : "none";
        }

        document.getElementById("chat-toggle").onclick = toggleChat;

        function addMessage(text, type) {
        let div = document.createElement("div");
        div.className = "message " + type;
        let bubble = `<div class="bubble">${text}</div>`;

        if (type === "bot") {
        div.innerHTML = `<div class="avatar">🤖</div>` + bubble;
        } else {
        div.innerHTML = bubble;
        }

        document.getElementById("chat-body").appendChild(div);
        let body = document.getElementById("chat-body");
        body.scrollTop = body.scrollHeight;
        }

        function sendMessage() {
        let input = document.getElementById("chatInput");
        let msg = input.value.trim();

        if (!msg) return;

        addMessage(msg, "user");

        let typing = document.createElement("div");
        typing.className = "message bot";
        typing.id = "typing";
        typing.innerHTML = `<div class="avatar">🤖</div><div class="bubble">Đang trả lời...</div>`;
        document.getElementById("chat-body").appendChild(typing);

        let body = document.getElementById("chat-body");
        body.scrollTop = body.scrollHeight;

        fetch('/Chatbot/Ask', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: msg })
        })
        .then(res => res.json())
        .then(data => {
        document.getElementById("typing")?.remove();
        addMessage(data, "bot");
        });

        input.value = "";
        }

        document.getElementById("chatInput").addEventListener("keypress", function (e) {
        if (e.key === "Enter") sendMessage();
        });

        function quickAsk(text) {
        document.getElementById("chatInput").value = text;
        sendMessage();
        }
    </script>
</body>
</html>