<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CINEZONE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CINEMA.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="d-flex flex-column min-vh-100">
    <script>
        (function () {
            if (localStorage.getItem("theme") === "dark") {
                document.body.classList.add("dark-theme");
            }
        })();
    </script>

    <header>
        <nav class="navbar navbar-expand-lg fixed-top navbar-transparent-overlay py-2.5">
            <div class="container-fluid px-4 px-lg-5">

                <!-- Logo CINEZONE -->
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="/images/unnamed.jpg" class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;" />
                    <span class="text-white fw-bold letter-spacing-1">CINEZONE</span>
                </a>

                <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <i class="bi bi-list fs-2 text-white"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <!-- Centered Navigation Links matching Screenshot -->
                    <ul class="navbar-nav mx-auto align-items-center gap-lg-1 my-2 my-lg-0">
                        <li class="nav-item">
                            <a class="nav-link nav-pill-active me-1" asp-controller="Home" asp-action="Schedule">
                                Lịch Chiếu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="NowShowing">
                                Phim Đang Hot
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="ComingSoon">
                                Phim Sắp Chiếu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Theaters">
                                Cụm Rạp
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Index#promotionSection">
                                Ưu Đãi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Concessions">
                                Bắp Nước
                            </a>
                        </li>
                    </ul>

                    <!-- Right Action Icons & Red TÀI KHOẢN Button -->
                    <div class="d-flex align-items-center gap-3 ms-auto">

                        <!-- Search Form -->
                        <div class="position-relative">
                            <form asp-controller="Home" asp-action="Search" method="get" class="d-flex align-items-center">
                                <input type="text"
                                       name="keyword"
                                       class="form-control form-control-sm rounded-pill bg-dark bg-opacity-50 text-white border-secondary border-opacity-50 ps-3 pe-4 py-1.5 opacity-90"
                                       placeholder="Tìm phim..."
                                       style="width: 140px; font-size: 0.85rem;" />
                                <button type="submit" class="btn text-light border-0 p-0 position-absolute end-0 me-2">
                                    <i class="bi bi-search small opacity-75"></i>
                                </button>
                            </form>
                        </div>

                        <!-- Dark Mode Toggle Icon -->
                        <button class="btn btn-link text-white p-1 border-0" id="btn-theme-toggle" onclick="toggleTheme()" title="Đổi chế độ sáng/tối">
                            <i class="bi bi-moon-fill fs-5" id="theme-icon"></i>
                        </button>

                        <!-- User Account Red Button (Matching Reference Mockup) -->
                        @{
                            var customerName = Context.Session.GetString("CustomerName");
                            var customerEmail = Context.Session.GetString("CustomerEmail") ?? "user@cinezone.vn";
                            var firstLetter = !string.IsNullOrEmpty(customerName) ? customerName.Trim().Substring(0, 1).ToUpper() : "U";
                        }
                        @if (customerName == null)
                        {
                            <a asp-controller="Customer" asp-action="Login" class="btn account-btn-red text-white rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center gap-2">
                                <i class="bi bi-person-fill fs-5"></i>
                                <span>TÀI KHOẢN</span>
                            </a>
                        }
                        else
                        {
                            <div class="dropdown">
                                <button class="btn account-btn-red text-white rounded-pill px-3 py-2 fw-bold shadow-sm dropdown-toggle d-inline-flex align-items-center gap-2 border-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5"></i>
                                    <span class="text-truncate" style="max-width: 150px;">@customerName</span>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 p-3" style="min-width: 270px; border-radius: 20px !important;">
                                    <!-- Header Avatar & User Info -->
                                    <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                                        <div class="user-avatar-circle flex-shrink-0">
                                            @firstLetter
                                        </div>
                                        <div class="overflow-hidden">
                                            <h6 class="fw-bold text-dark mb-0 text-truncate" style="max-width: 180px;" title="@customerName">@customerName</h6>
                                            <small class="text-muted text-truncate d-block" style="max-width: 180px; font-size: 0.78rem;" title="@customerEmail">@customerEmail</small>
                                        </div>
                                    </div>

                                    <!-- Menu Links matching screenshot -->
                                    <div class="d-flex flex-column gap-1">
                                        <a class="dropdown-item py-2.5 px-3 rounded-3 d-flex align-items-center gap-3 text-dark fw-semibold user-dropdown-link" asp-controller="Tickets" asp-action="MyTickets">
                                            <i class="bi bi-ticket-perforated-fill fs-5 text-secondary"></i>
                                            <span>Đơn Hàng Của Bạn</span>
                                        </a>

                                        <a class="dropdown-item py-2.5 px-3 rounded-3 d-flex align-items-center gap-3 text-dark fw-semibold user-dropdown-link" asp-controller="Customer" asp-action="Profile">
                                            <i class="bi bi-person-gear fs-5 text-secondary"></i>
                                            <span>Trang Cá Nhân</span>
                                        </a>

                                        <a class="dropdown-item py-2.5 px-3 rounded-3 d-flex align-items-center gap-3 text-dark fw-semibold user-dropdown-link" asp-controller="Customer" asp-action="Profile">
                                            <i class="bi bi-lock-fill fs-5 text-secondary"></i>
                                            <span>Đổi Mật Khẩu</span>
                                        </a>

                                        <hr class="dropdown-divider my-2 opacity-50">

                                        <a class="dropdown-item py-2.5 px-3 rounded-3 d-flex align-items-center gap-3 text-dark fw-semibold user-dropdown-link text-danger" asp-controller="Customer" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right fs-5 text-danger opacity-75"></i>
                                            <span class="text-danger">Đăng Xuất</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

