<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CINEZONE</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CINEMA.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<style>
/* Nút Back To Top */
#btnBackToTop {
    position: fixed;
    bottom: 90px; /* Đặt cao hơn nút Chatbox một chút */
    right: 20px;
    display: none; /* Ẩn mặc định */
    z-index: 999;
    border: none;
    outline: none;
    background: linear-gradient(135deg, #dc3545, #b02a37);
    color: white;
    cursor: pointer;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    font-size: 1.5rem;
    box-shadow: 0 4px 10px rgba(220, 53, 69, 0.4);
    transition: all 0.3s ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
}

/* Hiệu ứng mượt mà khi hiện lên */
#btnBackToTop.show {
    opacity: 1;
    visibility: visible;
}

#btnBackToTop:hover {
    transform: translateY(-5px);
    box-shadow: 0 6px 15px rgba(220, 53, 69, 0.6);
    background: linear-gradient(135deg, #b02a37, #842029);
}
</style>
</head>

<body class="d-flex flex-column min-vh-100">
    <script>
        (function () {
            if (localStorage.getItem("theme") === "dark") {
                document.body.classList.add("dark-theme");
            }
        })();
    </script>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow fixed-top">
            <div class="container">

                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <img src="/images/unnamed.jpg" class="footer-logo" />
                    CineZone
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav me-auto">
                         <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Schedule">
                                <i class="bi bi-calendar-event"></i> Lịch chiếu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Concessions">
                                <i class="bi bi-cup-straw"></i> Đặt bắp nước
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold text-primary" href="#" data-bs-toggle="modal" data-bs-target="#modalMembershipSummary">
                                <i class="bi bi-gem"></i> Thành viên
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="TermsAndPolicies">
                                <i class="bi bi-shield-check"></i> Điều khoản & Chính sách
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item me-2">
                            <button class="btn btn-link nav-link p-1 border-0" id="btn-theme-toggle" onclick="toggleTheme()" title="Đổi chế độ sáng/tối" style="box-shadow: none;">
                                <i class="bi bi-moon-fill fs-5" id="theme-icon"></i>
                            </button>
                        </li>
                        @if (Context.Session.GetString("CustomerName") == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Đăng ký
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    Xin chào, @Context.Session.GetString("CustomerName")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Customer" asp-action="Profile">Hồ sơ cá nhân</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Tickets" asp-action="MyTickets">Vé của tôi</a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Customer" asp-action="Logout">Đăng xuất</a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-3 main-content flex-grow-1" style="margin-top: 10px;">
        @RenderBody()
    </main>

    <footer class="footer-cinezone text-white pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row gy-4">

                <div class="col-lg-3 col-md-6 text-center text-md-start pe-lg-4">
                    <a asp-controller="Home" asp-action="Index" class="d-inline-block mb-3">
                        <img src="/images/unnamed.jpg" class="rounded-circle shadow-sm" style="width: 80px; height: 80px; object-fit: cover;" alt="CineZone Logo" />
                    </a>
                    <p class="small mb-3 fw-bold text-uppercase letter-spacing-1">Điểm hẹn điện ảnh</p>

                    <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-md-start mb-4">
                        <a asp-controller="Home" asp-action="Schedule" class="btn btn-warning fw-bold px-4 rounded-0 text-dark" style="letter-spacing: 1px;">ĐẶT VÉ</a>
                    </div>

                    <div class="social-icons d-flex gap-2 justify-content-center justify-content-md-start">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                        <a href="#"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6 col-6">
                    <h6 class="footer-title text-uppercase fw-bold mb-4">Tài khoản</h6>
                    <ul class="list-unstyled footer-links mb-4">
                        <li><a asp-controller="Customer" asp-action="Login">Đăng nhập</a></li>
                        <li><a asp-controller="Customer" asp-action="Register">Đăng ký</a></li>
                        <li><a href="#" data-bs-toggle="modal" data-bs-target="#modalMembershipSummary">Membership</a></li>
                    </ul>

                    <h6 class="footer-title text-uppercase fw-bold mb-4">Xem phim</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Phim đang chiếu</a></li>
                        <li><a asp-controller="Home" asp-action="Index">Phim sắp chiếu</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6 col-6">
                    <h6 class="footer-title text-uppercase fw-bold mb-4">CineZone</h6>
                    <ul class="list-unstyled footer-links mb-4">
                        <li><a href="#">Giới thiệu</a></li>
                        <li><a href="#">Liên hệ</a></li>
                        <li><a href="#">Tuyển dụng</a></li>
                    </ul>

                    <h6 class="footer-title text-uppercase fw-bold mb-4">Dịch vụ</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">Thuê rạp</a></li>
                        <li><a href="#">Tổ chức sự kiện</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-6">
                    <h6 class="footer-title text-uppercase fw-bold mb-4">Hệ thống rạp</h6>
                    <ul class="list-unstyled footer-links" style="column-count: 2; column-gap: 20px;">
                        @await Component.InvokeAsync("TheaterList")
                    </ul>
                </div>
            </div>

            <hr class="border-light opacity-25 my-4">

            <div class="footer-bottom d-flex flex-column flex-lg-row justify-content-between align-items-center text-center text-lg-start">
                <div class="mb-3 mb-lg-0 small text-light opacity-75">
                    © 2026 <strong>CineZone</strong>. All rights reserved.
                </div>

                <div class="d-flex flex-wrap gap-4 small justify-content-center">
                    <a asp-controller="Home" asp-action="Privacy" class="footer-link-bottom">Chính sách bảo mật</a>
                    <a href="#" class="footer-link-bottom">Tin điện ảnh</a>

                    <a href="javascript:void(0)" onclick="toggleChat()" class="footer-link-bottom fw-bold text-warning">
                        <i class="bi bi-chat-dots me-1"></i> Hỏi và đáp
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="modalMembershipSummary" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title"><i class="bi bi-award"></i> Chính sách thành viên CineZone</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4 bg-light">
                    <div class="row g-3 text-center">
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-3">
                                <h3 class="display-6">🥉</h3>
                                <h5 class="fw-bold" style="color: #e67e22;">Hạng ĐỒNG</h5>
                                <small class="text-muted">0 - 3 triệu đ</small>
                                <hr>
                                <ul class="list-unstyled small text-start">
                                    <li><i class="bi bi-check2 text-success"></i> Tích điểm cơ bản </li>
                                    <li><i class="bi bi-check2 text-success"></i> Quà bắp nước sinh nhật</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-3 border-top border-secondary border-4">
                                <h3 class="display-6">🥈</h3>
                                <h5 class="fw-bold text-secondary">Hạng BẠC</h5>
                                <small class="text-muted">3 - 10 triệu đ</small>
                                <hr>
                                <ul class="list-unstyled small text-start">
                                    <li><i class="bi bi-check2 text-success"></i> Giảm giá 3%</li>
                                    <li><i class="bi bi-check2 text-success"></i> Tặng cặp vé sinh nhật</li>
                                    <li><i class="bi bi-check2 text-success"></i> Ưu đãi Happy Day</li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card h-100 border-0 shadow-sm p-3 border-top border-primary border-4 text-white" style="background: linear-gradient(135deg, #3498db, #2c3e50);">
                                <h3 class="display-6">💎</h3>
                                <h5 class="fw-bold">KIM CƯƠNG</h5>
                                <small class="text-light">> 10 triệu đ</small>
                                <hr>
                                <ul class="list-unstyled small text-start">
                                    <li><i class="bi bi-check2 text-info"></i> Giảm giá 10%</li>
                                    <li><i class="bi bi-check2 text-info"></i> Quà sinh nhật VIP</li>
                                    <li><i class="bi bi-check2 text-info"></i> Quầy vé ưu tiên</li>
                                    <li><i class="bi bi-check2 text-info"></i> Nâng cấp ghế FREE</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-4">
                        @if (Context.Session.GetString("CustomerName") != null)
                        {
                            <a asp-controller="Customer" asp-action="Profile" class="btn btn-outline-primary rounded-pill">Xem tiến trình của tôi</a>
                        }
                        else
                        {
                            <a asp-controller="Customer" asp-action="Register" class="btn btn-primary rounded-pill px-4">Đăng ký thành viên ngay</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <button id="btnBackToTop" title="Lên đầu trang">
        <i class="bi bi-arrow-up-short"></i>
    </button>
    <div id="chat-toggle">
        💬
        <span id="chat-badge" class="badge bg-danger rounded-pill" style="display: none; position: absolute; top: -5px; right: -5px; font-size: 10px; padding: 4px 6px;">0</span>
    </div>

    <div id="chatbox">
        <div id="chat-header">
            <span id="chat-header-title">🎬 Hỗ trợ đặt vé</span>
            <span id="back-to-bot" style="display: none; cursor: pointer; margin-right: 15px; font-size: 12px; color: #ffc107;" onclick="switchToBotChat()">🤖 Hỏi Bot</span>
            <span onclick="toggleChat()" style="cursor: pointer;">✖</span>
        </div>

        <div id="chat-body">
            <div class="message bot">
                <div class="avatar">🤖</div>
                <div class="bubble">Xin chào! Bạn cần gì?</div>
            </div>

            <div class="suggestions">
                <button onclick="quickAsk('phim đang chiếu')">🎬 Phim đang chiếu</button>
                <button onclick="quickAsk('lịch chiếu')">⏰ Lịch chiếu</button>
                <button onclick="quickAsk('ghế trống')">💺 Ghế trống</button>
                <button onclick="switchToHumanChat()" style="background-color: #0d6efd; color: white;">💬 Gặp nhân viên</button>
            </div>
        </div>

        <div class="chat-input">
            <input id="chatInput" placeholder="Nhập câu hỏi..." />
            <button onclick="sendMessage()">➤</button>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // SCRIPT POPUP
        document.addEventListener("DOMContentLoaded", function () {
        const popup = document.getElementById("promoPopup");
        const closeBtn = document.getElementById("closePopup");

        if (!popup) return;

        if (closeBtn) {
        closeBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        popup.style.display = "none";
        });
        }

        popup.addEventListener("click", function (e) {
        if (e.target === popup) {
        popup.style.display = "none";
        }
        });
        });

        // SCRIPT CHATBOX
        let isHumanChatMode = false;
        let customerChatConnection = null;
        let unreadCount = 0;
        let isUserLoggedIn = @(Context.Session.GetInt32("CustomerId") != null ? "true" : "false");

        function toggleChat() {
            let box = document.getElementById("chatbox");
            let isOpening = box.style.display === "none" || box.style.display === "";
            box.style.display = isOpening ? "block" : "none";
            
            if (isOpening) {
                unreadCount = 0;
                let badge = document.getElementById("chat-badge");
                badge.style.display = "none";
                badge.innerText = "0";
            }
        }

        document.getElementById("chat-toggle").onclick = toggleChat;

        function addMessage(text, type, time = null) {
            let div = document.createElement("div");
            div.className = "message " + (type === "user" ? "user" : "bot");
            
            let avatarIcon = type === "bot" ? "🤖" : (type === "admin" ? "👨‍💼" : "");
            let avatarHtml = avatarIcon ? `<div class="avatar">${avatarIcon}</div>` : "";
            
            let timeColor = type === "user" ? "#ffeef4" : "#6c757d";
            let timeHtml = time ? `<small class="d-block mt-1" style="font-size: 9px; color: ${timeColor}; text-align: ${type === 'user' ? 'right' : 'left'}">${time}</small>` : "";
            let bubble = `<div class="bubble">${text}${timeHtml}</div>`;

            div.innerHTML = avatarHtml + bubble;

            document.getElementById("chat-body").appendChild(div);
            let body = document.getElementById("chat-body");
            body.scrollTop = body.scrollHeight;
        }

        function sendMessage() {
            let input = document.getElementById("chatInput");
            let msg = input.value.trim();

            if (!msg) return;

            if (isHumanChatMode) {
                if (customerChatConnection && customerChatConnection.state === signalR.HubConnectionState.Connected) {
                    customerChatConnection.invoke("SendMessageFromCustomer", msg)
                        .catch(err => console.error("Gửi tin nhắn qua SignalR thất bại: ", err));
                    input.value = "";
                } else {
                    addMessage("❌ Mất kết nối. Vui lòng bấm 'Gặp nhân viên' để kết nối lại.", "bot");
                }
            } else {
                addMessage(msg, "user");

                let typing = document.createElement("div");
                typing.className = "message bot";
                typing.id = "typing";
                typing.innerHTML = `<div class="avatar">🤖</div><div class="bubble">Đang trả lời...</div>`;
                document.getElementById("chat-body").appendChild(typing);

                let body = document.getElementById("chat-body");
                body.scrollTop = body.scrollHeight;

                fetch('/Chatbot/Ask', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: msg })
                })
                .then(res => res.json())
                .then(data => {
                    document.getElementById("typing")?.remove();
                    addMessage(data, "bot");
                });

                input.value = "";
            }
        }

        document.getElementById("chatInput").addEventListener("keypress", function (e) {
            if (e.key === "Enter") sendMessage();
        });

        function quickAsk(text) {
            document.getElementById("chatInput").value = text;
            sendMessage();
        }

        function switchToHumanChat() {
            if (!isUserLoggedIn) {
                addMessage("🤖 Bạn vui lòng đăng nhập để gặp nhân viên hỗ trợ nhé!", "bot");
                return;
            }

            isHumanChatMode = true;
            document.getElementById("chat-header-title").innerText = "👨‍💼 Hỗ trợ trực tuyến";
            document.getElementById("back-to-bot").style.setProperty("display", "inline", "important");

            let chatBody = document.getElementById("chat-body");
            chatBody.innerHTML = `<div class="text-center py-3 text-muted">Đang tải lịch sử chat...</div>`;

            fetch('/Chatbot/GetChatHistory')
                .then(res => res.json())
                .then(data => {
                    chatBody.innerHTML = "";
                    if (data.success && data.messages.length > 0) {
                        data.messages.forEach(msg => {
                            addMessage(msg.text, msg.type, msg.time);
                        });
                    } else {
                        addMessage("Xin chào! Nhân viên rạp phim CineZone có thể giúp gì cho bạn ạ?", "admin");
                    }
                    
                    initCustomerSignalR();
                });
        }

        function switchToBotChat() {
            isHumanChatMode = false;
            document.getElementById("chat-header-title").innerText = "🎬 Hỗ trợ đặt vé";
            document.getElementById("back-to-bot").style.setProperty("display", "none", "important");
            
            let chatBody = document.getElementById("chat-body");
            chatBody.innerHTML = `
                <div class="message bot">
                    <div class="avatar">🤖</div>
                    <div class="bubble">Chào bạn! Tôi đã trở lại. Bạn muốn hỏi gì thêm không?</div>
                </div>
                <div class="suggestions">
                    <button onclick="quickAsk('phim đang chiếu')">🎬 Phim đang chiếu</button>
                    <button onclick="quickAsk('lịch chiếu')">⏰ Lịch chiếu</button>
                    <button onclick="quickAsk('ghế trống')">💺 Ghế trống</button>
                    <button onclick="switchToHumanChat()" style="background-color: #0d6efd; color: white;">💬 Gặp nhân viên</button>
                </div>
            `;
        }

        function initCustomerSignalR() {
            if (customerChatConnection) return;

            customerChatConnection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            customerChatConnection.on("ReceiveMessageFromAdmin", function (adminName, messageText, time) {
                let box = document.getElementById("chatbox");
                if (box.style.display === "block" && isHumanChatMode) {
                    addMessage(messageText, "admin", time);
                } else {
                    unreadCount++;
                    let badge = document.getElementById("chat-badge");
                    badge.innerText = unreadCount;
                    badge.style.display = "block";
                }
            });

            customerChatConnection.on("ReceiveMessage", function (senderType, messageText, time) {
                if (isHumanChatMode) {
                    addMessage(messageText, senderType, time);
                }
            });

            customerChatConnection.start().catch(err => console.error("Customer SignalR connection error: ", err));
        }

        if (isUserLoggedIn) {
            setTimeout(initCustomerSignalR, 2000);
        }
        // ==========================================
        // 🚀 SCRIPT BACK TO TOP
        // ==========================================
        let backToTopBtn = document.getElementById("btnBackToTop");

        window.addEventListener("scroll", function () {
            // Khi cuộn xuống quá 300px thì hiện nút
            if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
                backToTopBtn.classList.add("show");
            } else {
                backToTopBtn.classList.remove("show");
            }
        });

        backToTopBtn.addEventListener("click", function () {
            // Cuộn mượt lên đỉnh trang
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });
        // ==========================================
        // 🚀 CHẾ ĐỘ SÁNG TỐI (THEME TOGGLE)
        // ==========================================
        function updateThemeIcon(isDark) {
            const icon = document.getElementById("theme-icon");
            if (icon) {
                if (isDark) {
                    icon.classList.remove("bi-moon-fill");
                    icon.classList.add("bi-sun-fill");
                    icon.style.color = "#ffc107";
                } else {
                    icon.classList.remove("bi-sun-fill");
                    icon.classList.add("bi-moon-fill");
                    icon.style.color = "";
                }
            }
        }

        function toggleTheme() {
            const isDark = document.body.classList.toggle("dark-theme");
            localStorage.setItem("theme", isDark ? "dark" : "light");
            updateThemeIcon(isDark);
        }

        document.addEventListener("DOMContentLoaded", function () {
            const isDark = document.body.classList.contains("dark-theme");
            updateThemeIcon(isDark);
        });
    </script>
</body>
</html>