@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineZone Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link rel="stylesheet" href="~/css/admin.css" />

    @RenderSection("Styles", required: false)
</head>

<body>
    <div class="admin-wrapper">

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <aside class="sidebar" id="sidebar">
            <div class="logo">
                <span class="logo-text text-white">CINEZONE</span>
                <button id="toggleSidebar" class="toggle-btn">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <div class="admin-info">
                <div class="avatar"><i class="bi bi-person-fill"></i></div>
                <div class="admin-name">@Context.Session.GetString("Name")</div>
                <div class="admin-role">Administrator</div>
            </div>

            <ul class="sidebar-menu">
                <li>
                    <a asp-controller="Admin" asp-action="Dashboard" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                    </a>
                </li>
           
             @if (HttpContextAccessor.HttpContext.Session.GetString("Role") == "SuperAdmin")
{
         <li>
                    <a asp-controller="Admin" asp-action="StaffList" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "StaffList" ? "active" : "")">
                        <i class="bi bi-building"></i><span>Quản lý Nhân viên</span>
                    </a>
                </li>
    <li>
        <a asp-controller="Log" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Log" ? "active" : "")">
            <i class="bi bi-building"></i><span>Quản lý Nhật ký</span>
        </a>
    </li>
}
                <li>
                    <a asp-controller="Theater" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Theater" ? "active" : "")">
                        <i class="bi bi-building"></i><span>Quản lý Rạp</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Auditorium" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Auditorium" ? "active" : "")">
                        <i class="bi bi-easel"></i><span>Quản lý Phòng Chiếu</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Movie" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Movie" ? "active" : "")">
                        <i class="bi bi-film"></i><span>Quản lý Phim</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Showtime" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Showtime" ? "active" : "")">
                        <i class="bi bi-calendar-event"></i><span>Quản lý Lịch Chiếu</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Genre" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Genre" ? "active" : "")">
                        <i class="bi bi-tags"></i><span>Quản lý Thể Loại</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Combo" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Combo" ? "active" : "")">
                        <i class="bi bi-cup-straw"></i><span>Quản lý Combo</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="CustomerAdmin" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "CustomerAdmin" ? "active" : "")">
                        <i class="bi bi-people"></i><span>Quản lý Khách Hàng</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminOrders" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminOrders" ? "active" : "")">
                        <i class="bi bi-bag-check"></i><span>Quản lý Đơn Hàng</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminVoucher" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminVoucher" ? "active" : "")">
                        <i class="bi bi-ticket-perforated"></i><span>Quản lý Voucher</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="AdminPopup" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminPopup" ? "active" : "")">
                        <i class="bi bi-megaphone"></i><span>Quản lý Popup</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Statistics" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Statistics" && ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")">
                        <i class="bi bi-bar-chart-line"></i><span>Báo Cáo Doanh Thu</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Statistics" asp-action="AdvancedStats" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Statistics" && ViewContext.RouteData.Values["Action"]?.ToString() == "AdvancedStats" ? "active" : "")">
                        <i class="bi bi-pie-chart"></i><span>Báo cáo chuyên sâu</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Admin" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i><span>Đăng Xuất</span>
                    </a>
                </li>
            </ul>
        </aside>

        <main class="main-content" id="mainContent">

            <div class="d-lg-none d-flex justify-content-between align-items-center bg-white p-3 rounded-3 shadow-sm mb-3 border">
                <h5 class="m-0 fw-bold text-primary">CINEZONE</h5>
                <button id="mobileToggle" class="btn btn-light border d-flex align-items-center justify-content-center">
                    <i class="bi bi-list fs-4"></i>
                </button>
            </div>

            <div class="content-box">
                @RenderBody()
            </div>

            <div class="footer">
                © 2026 CineZone Admin System. All Rights Reserved.
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const sidebar = document.getElementById('sidebar');
        const content = document.getElementById('mainContent');
        const toggleBtn = document.getElementById('toggleSidebar');
        const mobileToggleBtn = document.getElementById('mobileToggle');
        const overlay = document.getElementById('sidebarOverlay');
        const icon = toggleBtn.querySelector('i');

        // Toggle cho Desktop (Thu nhỏ/Phóng to) và nút Đóng trên Mobile
        toggleBtn.addEventListener('click', () => {
        if (window.innerWidth > 992) {
        // Hành vi trên Desktop
        sidebar.classList.toggle('collapsed');
        content.classList.toggle('expanded');
        icon.className = sidebar.classList.contains('collapsed') ? 'bi bi-layout-sidebar' : 'bi bi-list';
        } else {
        // Nút trong sidebar trở thành nút Đóng trên Mobile
        closeMobileSidebar();
        }
        });

        // Toggle mở Menu trên Mobile
        if (mobileToggleBtn) {
        mobileToggleBtn.addEventListener('click', () => {
        sidebar.classList.add('show-mobile');
        overlay.classList.add('show');
        icon.className = 'bi bi-x-lg'; // Đổi icon thành dấu X để tắt
        });
        }

        // Đóng menu khi bấm ra ngoài lớp phủ đen
        overlay.addEventListener('click', closeMobileSidebar);

        function closeMobileSidebar() {
        sidebar.classList.remove('show-mobile');
        overlay.classList.remove('show');
        icon.className = 'bi bi-list'; // Trả lại icon list
        }
    </script>
</body>
</html>