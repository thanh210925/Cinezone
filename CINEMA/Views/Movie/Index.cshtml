@model IEnumerable<CINEMA.Models.Movie>
@{
    ViewData["Title"] = "Quản lý phim";
    Layout = "_AdminLayout";
    var today = DateTime.Today;
    var nowShowing = Model?.Where(m => m.IsActive == true && m.ReleaseDate?.ToDateTime(TimeOnly.MinValue) <= today).ToList() ?? new();
    var comingSoon = Model?.Where(m => m.ReleaseDate?.ToDateTime(TimeOnly.MinValue) > today).ToList() ?? new();
    var stopped = Model?.Where(m => m.IsActive == false).ToList() ?? new();
}

<div class="container-fluid py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 p-3 rounded-4 shadow-sm border-0 d-flex align-items-center" role="alert">
            <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
            <div>
                <h6 class="fw-bold mb-0 text-success">@TempData["SuccessMessage"]</h6>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 p-3 rounded-4 shadow-sm border-0 d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
            <div>
                <h6 class="fw-bold mb-0 text-danger">@TempData["ErrorMessage"]</h6>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-primary mb-0 d-flex align-items-center">
                <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                    <i class="bi bi-film fs-5"></i>
                </div>
                Quản lý phim
            </h4>
        </div>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm fw-medium">
            <i class="bi bi-plus-lg me-1"></i> Thêm phim mới
        </a>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var item in new[] {
            new { Title = "Đang chiếu", Count = nowShowing.Count, Color = "success" },
            new { Title = "Sắp chiếu", Count = comingSoon.Count, Color = "warning" },
            new { Title = "Ngừng chiếu", Count = stopped.Count, Color = "danger" }
        })
        {
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <div class="text-@item.Color fw-bold fs-4">@item.Count</div>
                    <small class="text-muted text-uppercase fw-bold" style="letter-spacing: 1px;">@item.Title</small>
                </div>
            </div>
        }
    </div>
    <!-- TABS -->
    <div class="card shadow-sm border-0 rounded-4">
        <!-- Thêm d-flex và justify-content-center để căn giữa -->
        <div class="card-header bg-white pt-4 px-4 border-0 d-flex justify-content-center">
            <!-- Thêm gap-3 (hoặc gap-4) để các nút cách đều nhau -->
            <ul class="nav nav-pills gap-3" id="movieTabs" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active rounded-pill px-4 fw-medium" data-bs-toggle="pill" data-bs-target="#nowShowing" type="button">
                        <i class="bi bi-play-circle me-1"></i> Đang chiếu
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link rounded-pill px-4 fw-medium" data-bs-toggle="pill" data-bs-target="#comingSoon" type="button">
                        <i class="bi bi-rocket-takeoff me-1"></i> Sắp chiếu
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link rounded-pill px-4 fw-medium" data-bs-toggle="pill" data-bs-target="#stopped" type="button">
                        <i class="bi bi-stop-circle me-1"></i> Ngừng chiếu
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-0">
            <div class="tab-content" id="movieTabsContent">
                <div class="tab-pane fade show active" id="nowShowing">@Html.Partial("_MovieTable", nowShowing)</div>
                <div class="tab-pane fade" id="comingSoon">@Html.Partial("_MovieTableComingSoon", comingSoon)</div>
                <div class="tab-pane fade" id="stopped">@Html.Partial("_MovieTableStopped", stopped)</div>
            </div>
        </div>
    </div>