@model IEnumerable<CINEMA.Models.Movie>

<div class="table-responsive">
    <table class="table table-hover align-middle custom-table mb-0">
        <thead class="table-light text-secondary">
            <tr>
                <th class="text-center ps-4" width="80px">Poster</th>
                <th>Tên phim</th>
                <th class="text-center">Thời lượng</th>
                <th class="text-center">Ngày khởi chiếu</th>
                <th>Quốc gia</th>
                <th>Ngôn ngữ</th>
                <th class="text-center">Độ tuổi</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-center pe-4" width="120px">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var m in Model)
                {
                    <tr>
                        <td class="ps-4 text-center">
                            <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? "/images/unnamed.jpg" : m.PosterUrl)" onerror="this.onerror=null; this.src='/images/unnamed.jpg';" class="rounded shadow-sm" style="width: 50px; height: 70px; object-fit: cover;" alt="Poster" />
                        </td>
                        <td class="fw-bold text-dark">@m.Title</td>
                        <td class="text-center text-muted">@m.Duration <small>phút</small></td>
                        <td class="text-center fw-medium text-warning">
                            <i class="bi bi-calendar-event me-1"></i> @m.ReleaseDate?.ToString("dd/MM/yyyy")
                        </td>
                        <td class="text-muted">@m.Country</td>
                        <td class="text-muted">@m.Language</td>
                        <td class="text-center">
                            <span class="badge bg-dark rounded-pill px-2 small">@m.AgeRating</span>
                        </td>
                        <td class="text-center">
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3">
                                <i class="bi bi-rocket-takeoff me-1"></i> Sắp chiếu
                            </span>
                        </td>
                        <td class="text-center pe-4">
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Details" asp-route-id="@m.MovieId" class="btn btn-light btn-sm text-info action-btn" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@m.MovieId" class="btn btn-light btn-sm text-warning action-btn" title="Sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@m.MovieId" class="btn btn-light btn-sm text-danger action-btn" onclick="return confirm('Xóa phim @m.Title?')" title="Xóa">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" class="text-center py-5 text-muted">
                        <i class="bi bi-calendar-x fs-1 d-block mb-2 opacity-50"></i>
                        Chưa có phim sắp chiếu
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>