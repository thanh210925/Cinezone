@model CINEMA.Models.MovieListViewModel
@{
    ViewData["Title"] = "Quản lý nhập phim";
    Layout = "_AdminLayout";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0"><i class="bi bi-film text-primary"></i> Quản lý nhập phim</h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill"><i class="bi bi-arrow-left"></i> Quay lại</a>
    </div>

    <ul class="nav nav-pills mb-4" id="movieTab" role="tablist">
        <li class="nav-item"><button class="nav-link active rounded-pill px-4" data-bs-toggle="tab" data-bs-target="#manual"><i class="bi bi-pencil-square"></i> Nhập thủ công</button></li>
        <li class="nav-item"><button class="nav-link rounded-pill px-4" data-bs-toggle="tab" data-bs-target="#excel"><i class="bi bi-file-earmark-excel"></i> Import Excel</button></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="manual">
            <form asp-action="CreateMultiple" method="post">
                <div id="movieContainer"></div>
                <div class="d-flex gap-2 py-3 border-top mt-3">
                    <button type="button" onclick="addMovie()" class="btn btn-outline-primary rounded-pill px-4"><i class="bi bi-plus-circle"></i> Thêm phim</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-5"><i class="bi bi-floppy"></i> Lưu tất cả</button>
                </div>
            </form>
        </div>

        <div class="tab-pane fade" id="excel">
            <div class="card shadow-sm border-0 p-4">
                <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                    <div class="alert alert-info"><i class="bi bi-info-circle"></i> Tải file Excel có thứ tự: Tên | Thời lượng | Quốc gia | Ngôn ngữ | Tuổi | Mô tả | Poster | Trailer.</div>
                    <input type="file" name="file" class="form-control mb-3" accept=".xlsx" required />
                    <button type="submit" class="btn btn-success rounded-pill px-4"><i class="bi bi-upload"></i> Thực hiện Import</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/movie/create.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/movie/create.js" asp-append-version="true"></script>
}