@model CINEMA.Models.Movie
@{
    ViewData["Title"] = "Chi tiết phim";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4 text-gradient">🎬 Chi tiết phim</h2>

    <div class="card p-4 shadow-sm border-0 rounded-4">
        <div class="row g-4">
            <div class="col-md-4 text-center">
                @if (!string.IsNullOrEmpty(Model.PosterUrl))
                {
                    <img src="@Model.PosterUrl" alt="@Model.Title" class="rounded shadow-sm w-100" style="max-height: 420px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-light text-muted py-5 rounded">Chưa có poster</div>
                }
            </div>

            <div class="col-md-8">
                <h3 class="fw-bold mb-3">@Model.Title</h3>
                <p><b>⏱ Thời lượng:</b> @(Model.Duration.HasValue ? Model.Duration + " phút" : "-")</p>
                <p><b>📅 Ngày khởi chiếu:</b> @(Model.ReleaseDate.HasValue ? Model.ReleaseDate.Value.ToString("dd/MM/yyyy") : "-")</p>
                <p><b>📅 Ngày kết thúc chiếu:</b> @(Model.EndDate.HasValue ? Model.EndDate.Value.ToString("dd/MM/yyyy") : "-")</p>
                <p><b>🌍 Quốc gia:</b> @Model.Country</p>
                <p><b>🗣 Ngôn ngữ:</b> @Model.Language</p>
                <p><b>🔞 Giới hạn tuổi:</b> @Model.AgeRating</p>
                <p>
                    <b>🎞 Trạng thái:</b>
                    <span class="badge bg-@(Model.IsActive == true ? "success" : "secondary")">
                        @(Model.IsActive == true ? "Đang chiếu" : "Ngưng chiếu")
                    </span>
                </p>
                <p class="mt-3"><b>📝 Mô tả:</b><br />@Model.Description</p>

                @if (!string.IsNullOrEmpty(Model.TrailerUrl))
                {
                    <button type="button"
                            class="btn btn-outline-danger fw-bold mt-3"
                            data-bs-toggle="modal"
                            data-bs-target="#trailerModal"
                            data-trailer="@Model.TrailerUrl"
                            data-title="@Model.Title">
                        🎥 Xem trailer
                    </button>
                }
                else
                {
                    <p class="text-muted fst-italic mt-3">🎬 Chưa có trailer cho phim này.</p>
                }
            </div>
        </div>
    </div>

    <div class="card p-4 shadow-sm border-0 rounded-4 mt-4">
        <h4 class="fw-bold mb-4">💬 Đánh giá từ người dùng</h4>

        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            <div class="review-list">
                @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                {
                    <div class="review-item border-bottom py-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div>
                                <strong class="text-primary">
                                    @(review.Customer != null ? review.Customer.FullName : "Người dùng")
                                </strong>

                                @if (review.Customer != null && review.Customer.Email != "anonymous@cinezone.com")
                                {
                                    int score = (int)review.Customer.ReputationScore;
                                    string badgeClass = score >= 80 ? "bg-success" : (score >= 50 ? "bg-warning text-dark" : "bg-danger");

                                    <span class="badge @badgeClass ms-2" title="Điểm uy tín: @score%">
                                        Uy tín: @score%
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary ms-2">Khách vãng lai</span>
                                }

                                @if (review.IsHidden == true)
                                {
                                    <span class="badge bg-dark ms-1">Đã ẩn</span>
                                }
                            </div>
                            <span class="text-muted small">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>

                        <div class="mb-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                // Chỗ này tôi dùng Bootstrap Icon (bi bi-star-fill) cho đồng bộ với file của bạn
                                <i class="bi @(i <= review.Rating ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                            }
                        </div>

                        <p class="mb-1 @(review.IsHidden == true ? "text-muted text-decoration-line-through" : "")">
                            @review.Comment
                        </p>

                        @if (review.HasReport == true)
                        {
                            <div class="alert alert-danger p-2 mt-2 mb-0 small rounded-3 border-0">
                                <strong>⚠️ Bị báo cáo:</strong> @review.ReportReason
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-chat-dots fs-1"></i>
                <p class="mt-2">Chưa có đánh giá nào cho phim này.</p>
            </div>
        }
    </div>

    <a asp-action="Index" class="btn btn-secondary mt-4">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="modal fade" id="trailerModal" tabindex="-1" aria-labelledby="trailerLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 overflow-hidden">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="trailerLabel">🎬 Trailer phim</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="ratio ratio-16x9">
                    <iframe id="trailerFrame" src="" allowfullscreen class="border-0"></iframe>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/movie/details.js" asp-append-version="true"></script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/movie/details.css" asp-append-version="true" />
}
