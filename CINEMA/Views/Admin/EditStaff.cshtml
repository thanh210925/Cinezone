@model CINEMA.Models.Admin

@{
    ViewData["Title"] = "Sửa nhân viên";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0 rounded-4 p-4">

                <h4 class="fw-bold mb-4">
                    Sửa nhân viên
                </h4>

                <form asp-action="EditStaff"
                      method="post"
                      enctype="multipart/form-data">

                    <input type="hidden"
                           asp-for="AdminId" />

                    <div class="row">

                        <div class="col-md-4 text-center">

                            <img id="preview"
                                 src="@(string.IsNullOrEmpty(Model.Avatar) ? "/images/default-avatar.png" : Model.Avatar)"
                                 class="rounded-circle border"
                                 width="150"
                                 height="150"
                                 style="object-fit:cover" />

                            <div class="mt-3">

                                <input type="file"
                                       name="avatar"
                                       class="form-control"
                                       onchange="previewImage(event)" />

                            </div>

                        </div>

                        <div class="col-md-8">
                            <div class="mb-3">
                                <<label>Mã nhân viên</label>
                                    <input asp-for="EmployeeCode" class="form-control" readonly />
                            </div>
                            <div class="mb-3">
                                <label>Họ tên</label>
                                <input asp-for="FullName"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label>Email</label>
                                <input asp-for="Email"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label>Số điện thoại</label>
                                <input asp-for="Phone"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label>Ngày sinh</label>
                                <input asp-for="BirthDate"
                                       type="date"
                                       class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label>Địa chỉ</label>
                                <textarea asp-for="Address"
                                          class="form-control"></textarea>
                            </div>

                            <div class="mb-3">
                                <label>Chi nhánh</label>

                                <select asp-for="BranchId"
                                        asp-items="ViewBag.Branches"
                                        class="form-select">
                                </select>
                            </div>

                            <div class="mb-3">
                                <label>Chức vụ</label>

                                <select asp-for="PositionId"
                                        asp-items="ViewBag.Positions"
                                        class="form-select">
                                </select>
                            </div>

                            <div class="mb-3">
                                <label>Role</label>

                                <select asp-for="Role"
                                        class="form-select">

                                    <option value="Staff">
                                        Staff
                                    </option>

                                    <option value="SuperAdmin">
                                        SuperAdmin
                                    </option>

                                </select>
                            </div>

                            

                            <div class="mb-3">
                                <label>Giới tính</label>
                                <select asp-for="Gender" class="form-select">
                                    <option>Nam</option>
                                    <option>Nữ</option>
                                    <option>Khác</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label>CCCD</label>
                                <input asp-for="CitizenId" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label>Thông tin công việc</label>
                                <textarea asp-for="JobInfo" class="form-control"></textarea>
                            </div>

                            <div class="mb-3">
                                <label>Ngày vào làm</label>
                                <input asp-for="HireDate" type="date" class="form-control" />
                            </div>

                            <div class="mb-3">

                                <label>Trạng thái</label>

                                <select asp-for="IsActive"
                                        class="form-select">

                                    <option value="true">
                                        Hoạt động
                                    </option>

                                    <option value="false">
                                        Khóa
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>

                    <div class="mt-4">

                        <a asp-action="StaffList"
                           class="btn btn-secondary">
                            Hủy
                        </a>

                        <button class="btn btn-warning">
                            Cập nhật
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<script>
    function previewImage(event)
    {
        document.getElementById('preview').src =
            URL.createObjectURL(event.target.files[0]);
    }
</script>