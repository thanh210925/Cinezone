@model CINEMA.Models.Admin

@{
    ViewData["Title"] = "Chi tiết nhân viên";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between mb-4">

        <div>
            <h3 class="fw-bold text-primary">
                Hồ sơ nhân viên
            </h3>

            <small class="text-muted">
                Thông tin chi tiết nhân viên
            </small>
        </div>

        <div>

            <a asp-action="EditStaff"
               asp-route-id="@Model.AdminId"
               class="btn btn-warning">

                <i class="bi bi-pencil"></i>
                Sửa
            </a>

            <a asp-action="StaffList"
               class="btn btn-secondary">

                Quay lại

            </a>

        </div>

    </div>

    <div class="row">

        <!-- Avatar -->

        <div class="col-lg-4">

            <div class="card shadow-sm border-0 rounded-4">

                <div class="card-body text-center">

                    @if (!string.IsNullOrEmpty(Model.Avatar))
                    {
                        <img src="@Model.Avatar"
                             class="rounded-circle border"
                             width="180"
                             height="180"
                             style="object-fit:cover" />
                    }
                    else
                    {
                        <img src="/images/default-avatar.png"
                             class="rounded-circle border"
                             width="180"
                             height="180" />
                    }

                    <h4 class="mt-3 fw-bold">
                        @Model.FullName
                    </h4>

                    <p class="text-muted">
                        @Model.Email
                    </p>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            Hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Đã khóa
                        </span>
                    }

                </div>

            </div>

        </div>

        <!-- Thông tin -->

        <div class="col-lg-8">

            <div class="card shadow-sm border-0 rounded-4">

                <div class="card-body">

                    <h5 class="mb-4">
                        Thông tin cá nhân
                    </h5>

                    <table class="table">

                        <tr>
                            <th width="200">
                                Mã nhân viên
                            </th>
                            <td>
                                @Model.EmployeeCode
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Họ tên
                            </th>
                            <td>
                                @Model.FullName
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Email
                            </th>
                            <td>
                                @Model.Email
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Số điện thoại
                            </th>
                            <td>
                                @Model.Phone
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Ngày sinh
                            </th>
                            <td>
                                @(Model.BirthDate?.ToString("dd/MM/yyyy"))
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Địa chỉ
                            </th>
                            <td>
                                @Model.Address
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Chi nhánh
                            </th>
                            <td>
                                @(Model.Branch?.BranchName ?? "Chưa gán")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Chức vụ
                            </th>
                            <td>
                                @(Model.Position?.PositionName ?? "Chưa gán")
                            </td>
                        </tr>

                        <tr>
                            <th>
                                Vai trò
                            </th>
                            <td>

                                @if (Model.Role == "SuperAdmin")
                                {
                                    <span class="badge bg-danger">
                                        SuperAdmin
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        Staff
                                    </span>
                                }

                            </td>
                        </tr>

                        <tr>
                            <th>
                                Ngày tạo
                            </th>
                            <td>
                                @(Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm"))
                            </td>
                        </tr>
                        <tr>
                            <th>Mã nhân viên</th>
                            <td>@Model.EmployeeCode</td>
                        </tr>

                        <tr>
                            <th>Giới tính</th>
                            <td>@Model.Gender</td>
                        </tr>

                        <tr>
                            <th>CCCD</th>
                            <td>@Model.CitizenId</td>
                        </tr>

                        <tr>
                            <th>Thông tin công việc</th>
                            <td>@Model.JobInfo</td>
                        </tr>

                        <tr>
                            <th>Ngày vào làm</th>
                            <td>@Model.HireDate?.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th>
                                Đăng nhập gần nhất
                            </th>
                            <td>
                                @(Model.LastLogin?.ToString("dd/MM/yyyy HH:mm"))
                            </td>
                        </tr>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>