@model IEnumerable<CINEMA.Models.Admin>

@{
    ViewData["Title"] = "Quản lý nhân viên";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-primary mb-0">Quản lý nhân viên</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item active">Danh sách nhân viên</li>
                </ol>
            </nav>
        </div>
        <a asp-action="CreateStaff" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Thêm nhân viên
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-header bg-white border-0 p-3">

            <form method="get">

                <div class="input-group">

                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Tìm theo tên hoặc email..." />

                    <button class="btn btn-primary">
                        <i class="bi bi-search"></i>
                    </button>

                </div>

            </form>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th width="90">Ảnh</th>

                            <th>Mã NV</th>

                            <th>Họ tên</th>

                            <th>Email</th>

                            <th>Giới tính</th>

                            <th>Ngày vào làm</th>

                            <th>Chi nhánh</th>

                            <th>Chức vụ</th>

                            <th>Vai trò</th>

                            <th>Trạng thái</th>

                            <th class="text-center">
                                Thao tác
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    @if (!string.IsNullOrEmpty(item.Avatar))
                                    {
                                        <img src="@item.Avatar"
                                             class="rounded-circle border"
                                             width="55"
                                             height="55"
                                             style="object-fit:cover">
                                    }
                                    else
                                    {
                                        <img src="/images/default-avatar.png"
                                             class="rounded-circle border"
                                             width="55"
                                             height="55">
                                    }

                                </td>

                                <td>@item.EmployeeCode</td>

                                <td class="fw-bold">
                                    @item.FullName
                                </td>

                                <td>
                                    @item.Email
                                </td>

                                

                                <td>@item.Gender</td>

                                <td>@item.HireDate?.ToString("dd/MM/yyyy")</td>

                                <td>
                                    @{
                                        var theaterDict = ViewBag.TheaterDict as Dictionary<int, string>;
                                        int currentId = item.BranchId ?? 0; // Lấy ID rạp từ nhân viên

                                        if (theaterDict != null && currentId > 0 && theaterDict.ContainsKey(currentId))
                                        {
                                            <span class="fw-bold text-dark">@theaterDict[currentId]</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Chưa gán rạp</span>
                                        }
                                    }
                                </td>

                                <td>
                                    @(item.Position?.PositionName ?? "Chưa gán")
                                </td>

                                <td>

                                    @if (item.Role == "SuperAdmin")
                                    {
                                        <span class="badge bg-danger">
                                            SuperAdmin
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            Staff
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Khóa
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <div class="btn-group">

                                        <a asp-action="DetailsStaff"
                                           asp-route-id="@item.AdminId"
                                           class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="EditStaff"
                                           asp-route-id="@item.AdminId"
                                           class="btn btn-sm btn-outline-warning">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-action="ResetPassword"
                                           asp-route-id="@item.AdminId"
                                           class="btn btn-sm btn-outline-secondary"
                                           title="Reset password">

                                            <i class="bi bi-key"></i>

                                        </a>

                                        <form asp-action="ToggleStaffStatus"
                                              asp-route-id="@item.AdminId"
                                              method="post"
                                              style="display:inline">

                                            @if (item.IsActive)
                                            {
                                                <button class="btn btn-sm btn-outline-danger"
                                                        title="Khóa tài khoản">

                                                    <i class="bi bi-lock"></i>

                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success"
                                                        title="Mở khóa">

                                                    <i class="bi bi-unlock"></i>

                                                </button>
                                            }

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
</div>