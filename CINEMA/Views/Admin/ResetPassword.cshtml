@model CINEMA.Models.Admin

@{
    Layout = "_AdminLayout";
}

<div class="container mt-4">

    <div class="card">

        <div class="card-body">

            <h4>
                Reset mật khẩu
            </h4>

            <p>
                Nhân viên:
                <b>@Model.FullName</b>
            </p>

            <form method="post">

                <div class="mb-3">

                    <label>
                        Mật khẩu mới
                    </label>

                    <input type="password"
                           name="newPassword"
                           class="form-control" />

                </div>

                <button class="btn btn-primary">
                    Lưu
                </button>

            </form>

        </div>

    </div>

</div>