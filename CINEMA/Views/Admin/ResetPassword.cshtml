@model CINEMA.Models.Admin
@{
    ViewData["Title"] = "Đặt lại mật khẩu nhân viên";
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Admin/StaffList" class="text-decoration-none">Quản lý nhân viên</a></li>
            <li class="breadcrumb-item active">Đặt lại mật khẩu</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="fw-bold mb-0 text-center">
                        <i class="bi bi-shield-lock-fill me-2"></i>Đặt lại mật khẩu
                    </h5>
                </div>
                <div class="card-body p-4 bg-white">
                    <div class="text-center mb-4">
                        <div class="bg-light text-primary rounded-circle d-inline-flex align-items-center justify-content-center fw-bold fs-3 mb-2" style="width: 60px; height: 60px;">
                            @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                        </div>
                        <h6 class="fw-bold mb-1 text-dark">@Model.FullName</h6>
                        <span class="badge bg-secondary px-2.5 py-1.5 rounded-pill small">Mã NV: @Model.EmployeeCode</span>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger border-0 rounded-3 shadow-none mb-3 d-flex align-items-center" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <div>@ViewBag.Error</div>
                        </div>
                    }

                    <form asp-action="ResetPassword" method="post" autocomplete="off">
                        @Html.AntiForgeryToken()

                        <!-- Mật khẩu mới của nhân viên -->
                        <div class="mb-3">
                            <label class="form-label fw-bold text-secondary small mb-1">MẬT KHẨU MỚI CHO NHÂN VIÊN <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key-fill text-muted"></i></span>
                                <input type="password" name="newPassword" class="form-control border-start-0 px-2" placeholder="Nhập mật khẩu mới..." required minlength="6" />
                            </div>
                            <div class="form-text text-muted small">Mật khẩu mới phải có ít nhất 6 ký tự.</div>
                        </div>

                        <!-- Mật khẩu Superadmin xác nhận -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary small mb-1">MẬT KHẨU CỦA BẠN (SUPERADMIN) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person-fill-lock text-muted"></i></span>
                                <input type="password" name="superAdminPassword" class="form-control border-start-0 px-2" placeholder="Xác nhận mật khẩu Superadmin của bạn..." required />
                            </div>
                            <div class="form-text text-muted small">Nhập mật khẩu của bạn để xác minh quyền hạn.</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill fw-semibold py-2">
                                <i class="bi bi-check-circle-fill me-1"></i> Xác nhận thay đổi
                            </button>
                            <a href="/Admin/StaffList" class="btn btn-outline-secondary rounded-pill fw-semibold py-2">
                                Hủy bỏ
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>