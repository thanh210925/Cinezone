@model IEnumerable<CINEMA.Models.LeaveRequest>
@{
    ViewData["Title"] = "Quản lý nghỉ phép";
}


@{
    ViewData["Title"] = "Nhật ký hoạt động";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <h3 class="fw-bold text-primary mb-4"><i class="bi bi-calendar-x"></i> Danh sách đơn xin nghỉ phép</h3>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-nowrap">
                        <tr>
                            <th class="ps-4">Nhân viên</th>
                            <th>Từ ngày</th>
                            <th>Đến ngày</th>
                            <th>Lý do</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.Admin?.FullName</td>
                                <td class="text-nowrap">@item.StartDate.ToString("dd/MM/yyyy")</td>
                                <td class="text-nowrap">@item.EndDate.ToString("dd/MM/yyyy")</td>
                                <td>@item.Reason</td>
                                <td>
                                    <span class="badge @(item.Status == "Đã duyệt" ? "bg-success-subtle text-success" : (item.Status == "Từ chối" ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning")) border px-3 py-2 rounded-pill">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    @if (item.Status == "Chờ duyệt")
                                    {
                                        <form asp-action="ApproveLeave" method="post" class="d-inline-flex gap-1">
                                            <input type="hidden" name="id" value="@item.RequestId" />
                                            <button name="status" value="Đã duyệt" class="btn btn-sm btn-success rounded-circle shadow-sm" title="Duyệt đơn"><i class="bi bi-check-lg"></i></button>
                                            <button name="status" value="Từ chối" class="btn btn-sm btn-danger rounded-circle shadow-sm" title="Từ chối"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>