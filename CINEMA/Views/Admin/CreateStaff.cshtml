@model CINEMA.Models.Admin
@{
    ViewData["Title"] = "Thêm nhân viên";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h4 class="fw-bold mb-4 text-primary"><i class="bi bi-person-plus-fill"></i> Thêm nhân viên mới</h4>

                <form asp-action="CreateStaff" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Họ tên</label>
                        <input asp-for="FullName" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Email</label>
                        <input asp-for="Email" type="email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Mật khẩu</label>
                        <input asp-for="PasswordHash" type="password" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Số điện thoại</label>
                        <input asp-for="Phone" class="form-control" />
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <a asp-action="StaffList" class="btn btn-outline-secondary rounded-pill flex-fill">Hủy</a>
                        <button type="submit" class="btn btn-primary rounded-pill flex-fill">Tạo tài khoản</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}