@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Hỗ trợ khách hàng trực tuyến";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h2 class="h3 mb-0 text-white font-weight-bold"><i class="bi bi-chat-dots-fill text-primary me-2"></i> Hỗ trợ Khách hàng trực tuyến</h2>
        <span class="badge bg-success p-2" id="connection-status">Đang kết nối SignalR...</span>
    </div>

    <div class="row chat-row-gradient" style="height: calc(100vh - 200px); min-height: 500px;">
        <!-- Cột danh sách khách hàng -->
        <div class="col-md-4 col-lg-3 border-end border-secondary bg-dark-custom rounded-start p-0 d-flex flex-column h-100">
            <div class="p-3 border-bottom border-secondary">
                <input type="text" id="search-customer" class="form-control bg-secondary-custom text-white border-0" placeholder="Tìm kiếm khách hàng...">
            </div>
            
            <div class="flex-grow-1 overflow-auto" id="customer-list-container">
                <div class="text-center py-4 text-muted">Đang tải danh sách cuộc trò chuyện...</div>
            </div>
        </div>

        <!-- Cột nội dung chat -->
        <div class="col-md-8 col-lg-9 bg-dark-custom rounded-end p-0 d-flex flex-column h-100 position-relative" id="chat-content-container">
            <!-- Header cuộc trò chuyện -->
            <div class="p-3 border-bottom border-secondary d-flex align-items-center justify-content-between bg-dark-header" id="chat-header" style="display: none !important;">
                <div class="d-flex align-items-center">
                    <img id="chat-avatar" src="/images/default-avatar.png" class="rounded-circle me-3" width="45" height="45" alt="Avatar">
                    <div>
                        <h5 class="mb-0 text-white font-weight-bold" id="chat-customer-name">Khách hàng</h5>
                        <small class="text-success"><i class="bi bi-circle-fill fs-xs me-1"></i> Đang trực tuyến</small>
                    </div>
                </div>
            </div>

            <!-- Khung hiển thị tin nhắn -->
            <div class="flex-grow-1 overflow-auto p-4 d-flex flex-column" id="chat-messages-container" style="background-color: #0b0f19;">
                <div class="m-auto text-center text-muted">
                    <i class="bi bi-chat-square-quote fs-1 d-block mb-3 text-secondary"></i>
                    <h5>Chọn một khách hàng ở danh sách bên trái để bắt đầu cuộc trò chuyện.</h5>
                </div>
            </div>

            <!-- Khung nhập tin nhắn -->
            <div class="p-3 border-top border-secondary bg-dark-header" id="chat-input-area" style="display: none !important;">
                <div class="input-group">
                    <input type="text" id="admin-message-input" class="form-control bg-secondary-custom text-white border-0 py-2" placeholder="Nhập câu trả lời hỗ trợ..." autocomplete="off">
                    <button class="btn btn-primary px-4" id="btn-send-message">
                        <i class="bi bi-send-fill"></i> Gửi
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/chatsupport.css" asp-append-version="true" />
}

@section Scripts {
    <!-- Thư viện SignalR Client -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/pages/admin/chatsupport.js" asp-append-version="true"></script>
}
