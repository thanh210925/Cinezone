@model List<CINEMA.Models.UserSearchLog>
@{
    ViewBag.Title = "Lịch sử tìm kiếm";
    Layout = "_Layout";
}

<h3 class="mb-3">Lịch sử tìm kiếm của khách hàng</h3>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Thời gian</th>
                <th>Khách hàng</th>
                <th>Từ khóa</th>
                <th>Số kết quả</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="4" class="text-center text-muted">Chưa có dữ liệu.</td></tr>
            }
            @foreach (var log in Model)
            {
                <tr class="@(log.ResultCount == 0 ? "table-danger" : "")">
                    <td>@log.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(log.Customer?.FullName ?? "Khách vãng lai")</td>
                    <td>@log.Keyword</td>
                    <td>@(log.ResultCount ?? 0)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<p class="text-muted">🔴 Dòng đỏ: tìm kiếm không ra kết quả nào.</p>

@{
    int totalPages = (int)ViewBag.TotalPages;
    int currentPage = (int)ViewBag.Page;
}
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="CustomerSearchLogs" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}