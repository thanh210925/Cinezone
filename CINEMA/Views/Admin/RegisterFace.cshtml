@using CINEMA.Models
@model IEnumerable<Admin>
@{
    ViewData["Title"] = "Đăng ký khuôn mặt";
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="bi bi-person-bounding-box"></i> Quản lý & Đăng ký khuôn mặt nhân viên</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã NV</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Trạng thái khuôn mặt</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var admin in Model)
                        {
                            <tr>
                                <td>@admin.EmployeeCode</td>
                                <td class="fw-bold">@admin.FullName</td>
                                <td>@admin.Email</td>
                                <td>
                                    <span class="badge bg-secondary">@admin.Role</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(admin.FacePhoto))
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@admin.FacePhoto" alt="Face photo" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover;" />
                                            <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle-fill"></i> Đã đăng ký</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning"><i class="bi bi-exclamation-triangle-fill"></i> Chưa đăng ký</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-sm btn-primary" onclick="openRegisterModal(@admin.AdminId, '@admin.FullName')">
                                            <i class="bi bi-camera-fill"></i> Quét & Đăng ký
                                        </button>
                                        @if (!string.IsNullOrEmpty(admin.FacePhoto))
                                        {
                                            <button class="btn btn-sm btn-danger" onclick="deleteFace(@admin.AdminId, '@admin.FullName')">
                                                <i class="bi bi-trash-fill"></i> Xóa
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Đăng Ký Khuôn Mặt -->
<div class="modal fade" id="registerFaceModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="registerFaceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="registerFaceModalLabel"><i class="bi bi-camera"></i> Đăng ký khuôn mặt: <span id="targetAdminName" class="text-warning"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" onclick="stopCamera()"></button>
            </div>
            <div class="modal-body text-center bg-light">
                <div id="ai-loading" class="alert alert-info py-2" style="font-size: 0.9rem;">
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    Đang tải mô hình nhận diện AI...
                </div>
                
                <div class="position-relative d-inline-block mx-auto mb-3" style="max-width: 400px; width: 100%;">
                    <video id="webcam" width="100%" height="auto" autoplay class="border rounded bg-dark shadow-sm" style="transform: scaleX(-1); display: block;"></video>
                    <!-- Canvas vẽ khung nhận diện đè lên camera -->
                    <canvas id="overlay" class="position-absolute top-0 start-0 w-100 h-100" style="pointer-events: none; transform: scaleX(-1);"></canvas>
                </div>

                <div id="cameraStatus" class="alert alert-warning py-2 mb-3">
                    Vui lòng hướng khuôn mặt trực diện vào camera
                </div>

                <div class="form-check d-flex justify-content-center mb-3">
                    <input class="form-check-input me-2" type="checkbox" id="chkManual" onchange="toggleManualMode(this)">
                    <label class="form-check-label text-muted small" for="chkManual">
                        Chụp thủ công (Bỏ qua kiểm duyệt khuôn mặt bằng AI)
                    </label>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" onclick="stopCamera()">Hủy</button>
                    <button type="button" id="btnCapture" class="btn btn-success px-4" onclick="captureAndSave()" disabled>
                        <i class="bi bi-camera-fill"></i> Chụp & Lưu khuôn mặt
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Tải thư viện face-api.js -->
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
    <script>
        window.RegisterFaceConfig = {
            modelUrl: '@Url.Content("~/models/")'
        };
    </script>
    <script src="~/js/pages/admin/registerface.js" asp-append-version="true"></script>
}
