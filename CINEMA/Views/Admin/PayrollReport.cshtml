@model IEnumerable<CINEMA.ViewModels.PayrollViewModel>
@{
    ViewData["Title"] = "Bảng công tháng";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Bảng tổng hợp công tháng @ViewBag.Month / @ViewBag.Year</h4>
        </div>
        <div class="card-body">
            <table class="table table-hover table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Mã NV</th>
                        <th>Tên nhân viên</th>
                        <th>Số ngày công (Đã duyệt)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EmployeeCode</td>
                            <td>@item.FullName</td>
                            <td><span class="badge bg-info text-dark">@item.TotalDays ngày</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button class="btn btn-primary" onclick="window.print()">In báo cáo</button>
        </div>
    </div>
</div>