    box-shadow: 0 25px 65px rgba(0, 0, 0, 0.75), 0 0 50px rgba(13, 110, 253, 0.25);
    transform: scale(0.88) translateY(20px);
    transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    color: #ffffff;
}
.payment-loading-overlay.active .payment-loading-card {
    transform: scale(1) translateY(0);
}
.payment-icon-wrapper {
    position: relative;
    width: 86px;
    height: 86px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
}
.payment-icon-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: rgba(13, 110, 253, 0.3);
    animation: pulseRing 1.8s infinite ease-in-out;
}
@@keyframes pulseRing {
    0% { transform: scale(0.85); opacity: 0.9; }
    50% { transform: scale(1.4); opacity: 0.15; }
    100% { transform: scale(0.85); opacity: 0.9; }
}
.payment-icon-box {
    position: relative;
    z-index: 2;
    width: 76px;
    height: 76px;
    background: linear-gradient(135deg, #1e2d4a 0%, #101726 100%);
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.3rem;
    color: #6ea8fe;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
}
.payment-loading-title {
    font-weight: 800;
    font-size: 1.6rem;
    color: #ffffff;
    letter-spacing: -0.5px;
}
.payment-loading-sub {
    font-size: 0.95rem;
    color: #a5c7fe;
    line-height: 1.5;
    font-weight: 500;
}
.payment-progress-container {
    width: 100%;
    height: 6px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    overflow: hidden;
    position: relative;
}
.payment-progress-bar {
    height: 100%;
    width: 45%;
    background: linear-gradient(90deg, #0d6efd, #20c997, #0d6efd);
    border-radius: 10px;
    position: absolute;
    animation: shimmerMove 1.4s infinite ease-in-out;
}
@@keyframes shimmerMove {
    0% { left: -45%; width: 45%; }
    50% { width: 65%; }
    100% { left: 100%; width: 45%; }
}
</style>
    </script>
}