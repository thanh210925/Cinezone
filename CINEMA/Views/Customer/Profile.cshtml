                        </div>
                    </div>
                </div>
            </div>
        }

        @if (order.Status == "Chờ thanh toán" || order.Status == "Đang chờ thanh toán" || order.Status == "Thanh toán thất bại")
        {
            <div class="modal fade" id="paymentMethodModal-@order.OrderId" tabindex="-1" aria-hidden="true">
