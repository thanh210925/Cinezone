@model CINEMA.Models.Customer
@{
    ViewData["Title"] = "Quản lý đơn hàng của bạn";
    
    var ringClass = Model.MembershipLevel == "Kim cương" ? "ring-diamond" :
                    Model.MembershipLevel == "Bạc" ? "ring-silver" : "ring-bronze";
                    
    var badgeClass = Model.MembershipLevel == "Kim cương" ? "badge-diamond" :
                     Model.MembershipLevel == "Bạc" ? "badge-silver" : "badge-bronze";

    var orders = Model.Orders?.OrderByDescending(o => o.CreatedAt).ToList() ?? new List<CINEMA.Models.Order>();
    var initialLetter = !string.IsNullOrEmpty(Model.FullName) ? Model.FullName.Trim()[0].ToString().ToUpper() : "U";

    var countTotal = orders.Count;
    var countPending = orders.Count(o => o.Status == "Chờ thanh toán" || o.Status == "Đang chờ thanh toán");
    var countPaid = orders.Count(o => o.Status == "Đã thanh toán" || o.Status == "Completed" || o.Status == "Paid");
    var countCancelled = orders.Count(o => o.Status == "Đã hủy" || o.Status == "Thanh toán thất bại");
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/customer/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages/tickets/mytickets.css" asp-append-version="true" />
}

<div class="container-fluid px-lg-5 px-3 profile-dashboard-container py-4" style="padding-top: 115px !important;">
    
    <div class="row g-4">
        
        <!-- 🟢 LEFT COLUMN: USER SIDEBAR CARD (Dạng Card bên trái) -->
        <div class="col-lg-3 col-md-4">
            <div class="user-sidebar-card text-center sticky-top" style="top: 115px; z-index: 10;">
                <!-- Avatar circle with Initial / Photo -->
                <div class="user-avatar-circle">
                    @if (!string.IsNullOrEmpty(Model.Avatar))
                    {
                        <img src="@Model.Avatar" class="user-avatar-img" alt="@Model.FullName" />
                    }
                    else
                    {
                        <span>@initialLetter</span>
                    }
                </div>

                <h5 class="fw-bold mb-1 text-dark">@Model.FullName</h5>
                <p class="text-muted small text-break mb-3">@Model.Email</p>

                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1.5 fw-bold mb-3 d-inline-block">
                    <i class="bi bi-shield-check me-1"></i> @(string.IsNullOrEmpty(Model.MembershipLevel) ? "Khách Hàng Thân Thiết" : Model.MembershipLevel)
                </span>

                <!-- 📊 THANH TÍCH ĐIỂM HẠNG THÀNH VIÊN -->
                <div class="px-2 mb-3">
                    <div class="d-flex justify-content-between text-muted small fw-bold mb-1" style="font-size: 0.78rem;">
                        <span>Tiến trình hạng</span>
                        <span class="text-success fw-bold">@Model.ProgressPercent%</span>
                    </div>
                    <div class="progress rounded-pill bg-light mb-2" style="height: 9px; border: 1px solid #e2e8f0;">
                        <div class="progress-bar bg-success rounded-pill" role="progressbar" style="width: @Model.ProgressPercent%" aria-valuenow="@Model.ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <small class="text-muted d-block text-start" style="font-size: 0.73rem;">
                        @if (Model.MembershipLevel != "Kim cương")
                        {
                            @:Còn thiếu <b class="text-dark">@Model.NextLevelAmount.ToString("N0") ₫</b> để thăng hạng 🚀
                        }
                        else
                        {
                            @:🎉 Bạn đã đạt cấp bậc Kim Cương cao nhất!
                        }
                    </small>
                </div>

                <!-- 📱 NÚT MÃ QR TÍCH ĐIỂM -->
                <button type="button" class="btn btn-success w-100 rounded-pill py-2 fw-bold mb-3 d-flex align-items-center justify-content-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalLoyaltyQR">
                    <i class="bi bi-qr-code-scan fs-5"></i> Mã QR Tích Điểm
                </button>

                <!-- Navigation List Buttons -->
                <div class="border-top pt-3 d-flex flex-column gap-1">
                    <button type="button" class="user-menu-btn active" id="btn-tab-orders" onclick="switchMainTab('orders')">
                        <i class="bi bi-bag-check-fill fs-5"></i> Đơn Hàng Của Bạn
                    </button>
                    <button type="button" class="user-menu-btn" id="btn-tab-info" onclick="switchMainTab('info')">
                        <i class="bi bi-person-vcard-fill fs-5"></i> Thông Tin Cá Nhân
                    </button>
                    <a asp-action="EditProfile" class="user-menu-btn text-secondary">
                        <i class="bi bi-pencil-square fs-5"></i> Chỉnh Sửa Hồ Sơ
                    </a>
                    <a asp-controller="Customer" asp-action="Logout" class="user-menu-btn text-danger">
                        <i class="bi bi-box-arrow-right fs-5"></i> Đăng Xuất
                    </a>
                </div>
            </div>
        </div>

        <!-- 🟢 RIGHT COLUMN: DỰ ÁN DẠNG DASHBOARD ĐƠN HÀNG (Giống giao diện người dùng mẫu) -->
        <div class="col-lg-9 col-md-8 ps-lg-4">
            
            <!-- 📦 PANE 1: BẢNG QUẢN LÝ ĐƠN HÀNG CỦA BẠN -->
            <div id="pane-orders" class="main-tab-content">
                <!-- Title Header -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h4 class="fw-bold text-dark m-0 d-flex align-items-center gap-2">
                            <i class="bi bi-box-seam text-success fs-3"></i> Quản Lý Đơn Hàng Của Bạn
                        </h4>
                        <p class="text-muted small mb-0 mt-1">Quản lý lịch sử vé xem phim và combo bắp nước của tài khoản</p>
                    </div>
                </div>

                <!-- 4 Summary Stats Cards Top -->
                <div class="row g-3 mb-4">
                    <div class="col-6 col-lg-3">
                        <div class="user-stat-card">
                            <div class="user-stat-icon icon-blue">
                                <i class="bi bi-bag"></i>
                            </div>
                            <div>
                                <div class="fw-bold fs-4 text-dark">@countTotal</div>
                                <small class="text-muted small fw-bold">Tổng Đơn Đã Đặt</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="user-stat-card">
                            <div class="user-stat-icon icon-yellow">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <div>
                                <div class="fw-bold fs-4 text-dark">@countPending</div>
                                <small class="text-muted small fw-bold">Đơn Chờ Xử Lý</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="user-stat-card">
                            <div class="user-stat-icon icon-green">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div>
                                <div class="fw-bold fs-4 text-dark">@countPaid</div>
                                <small class="text-muted small fw-bold">Đã Hoàn Thành</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="user-stat-card">
                            <div class="user-stat-icon icon-purple">
                                <i class="bi bi-wallet2"></i>
                            </div>
                            <div>
                                <div class="fw-bold fs-6 text-dark text-truncate" title="@Model.TotalSpent.ToString("N0") ₫">@Model.TotalSpent.ToString("N0") ₫</div>
                                <small class="text-muted small fw-bold">Tổng Chi Tiêu</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Horizontal Filter Pills Nav -->
                <div class="order-filter-nav">
                    <button type="button" class="order-filter-pill active" onclick="filterUserOrders('all', this)">
                        Tất Cả <span class="badge">@countTotal</span>
                    </button>
                    <button type="button" class="order-filter-pill" onclick="filterUserOrders('pending', this)">
                        Chờ Xử Lý <span class="badge">@countPending</span>
                    </button>
                    <button type="button" class="order-filter-pill" onclick="filterUserOrders('paid', this)">
                        Đã Thanh Toán <span class="badge">@countPaid</span>
                    </button>
                    <button type="button" class="order-filter-pill" onclick="filterUserOrders('cancelled', this)">
                        Đã Hủy <span class="badge">@countCancelled</span>
                    </button>
                </div>

                <!-- List of Orders Container -->
                <div id="userOrdersContainer">
                    @if (!orders.Any())
                    {
                        <!-- Default Empty State -->
                        <div class="empty-orders-card">
                            <div class="text-muted mb-3"><i class="bi bi-box2" style="font-size: 3.5rem;"></i></div>
                            <h5 class="fw-bold text-dark">Không tìm thấy đơn hàng nào</h5>
                            <p class="text-muted small mb-4">Bạn chưa có đơn hàng nào. Khám phá các siêu phẩm điện ảnh mới nhất ngay!</p>
                            <a href="/Home" class="btn btn-success fw-bold px-4 py-2 rounded-pill shadow-sm"><i class="bi bi-cart-fill me-1"></i> Đặt Vé Ngay</a>
                        </div>
                    }
                    else
                    {
                        foreach (var order in orders)
                        {
                            var firstGroup = order.Tickets.GroupBy(t => t.ShowtimeId).FirstOrDefault();
                            var firstTicket = firstGroup?.FirstOrDefault();
                            var movieTitle = firstTicket?.Showtime?.Movie?.Title ?? "Không rõ";
                            var posterUrl = firstTicket?.Showtime?.Movie?.PosterUrl;
                            var roomName = firstTicket?.Showtime?.Auditorium?.Name ?? "Không rõ";
                            var theaterName = firstTicket?.Showtime?.Auditorium?.Theater?.Name;
                            var showtimeStr = firstTicket?.Showtime?.StartTime?.ToString("dd/MM/yyyy HH:mm") ?? "Không rõ";
                            var seatsStr = string.Join(", ", order.Tickets.Select(t => $"{t.Seat?.RowLabel}{t.Seat?.SeatNumber}"));
                            var quantity = order.Tickets.Count;
                            var isComboOnly = order.Tickets == null || !order.Tickets.Any();

                            var catType = (order.Status == "Chờ thanh toán" || order.Status == "Đang chờ thanh toán") ? "pending" :
                                          (order.Status == "Đã thanh toán" || order.Status == "Completed" || order.Status == "Paid") ? "paid" : "cancelled";

                            <div class="user-order-item mb-4" data-category="@catType">
                                @if (isComboOnly)
                                {
                                    <div class="card ticket-pass-card combo-only-card h-100 shadow-sm">
                                        <!-- 1. LEFT STUB -->
                                        <div class="ticket-poster-stub combo-poster-stub">
                                            <div class="ticket-poster-fallback combo-fallback">
                                                <i class="bi bi-egg-fried mb-2 text-warning animate-bounce" style="font-size: 2.5rem;"></i>
                                                <span class="fw-bold tracking-wide small">CINEZONE</span>
                                                <small class="text-white-50">BẮP NƯỚC</small>
                                            </div>
                                        </div>

                                        <!-- 2. MIDDLE CONTENT -->
                                        <div class="ticket-pass-content">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                    <div>
                                                        <span class="ticket-custom-badge @GetCustomStatusClass(order.Status)">
                                                            @order.Status
                                                        </span>
                                                        <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 text-uppercase fw-bold ms-1" style="font-size: 0.65rem;">🍿 Combo</span>
                                                    </div>
                                                    <small class="text-muted">Đặt lúc: @order.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>

                                                <h5 class="movie-title mt-2 text-primary fw-bold"><i class="bi bi-cup-straw me-2"></i>Đơn hàng bắp nước riêng</h5>

                                                <div class="mt-2 p-2.5 bg-light rounded-3">
                                                    <span class="fw-semibold text-secondary small d-block mb-1">Sản phẩm đã chọn:</span>
                                                    <ul class="list-unstyled mb-0">
                                                        @foreach (var oc in order.OrderCombos)
                                                        {
                                                            <li class="d-flex justify-content-between align-items-center mb-1 small">
                                                                <span class="text-dark"><i class="bi bi-check2-circle text-success me-1"></i>@oc.Combo?.Name</span>
                                                                <span class="fw-bold text-dark">x @oc.Quantity</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>

                                            <div class="border-top mt-3 pt-2 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="text-muted small d-block">Tổng tiền:</span>
                                                    <span class="fw-bold text-danger fs-6">@String.Format("{0:N0} ₫", order.TotalAmount)</span>
                                                </div>
                                                <small class="text-muted font-monospace">@order.PaymentMethod</small>
                                            </div>
                                        </div>

                                        <!-- 3. RIGHT STUB -->
                                        <div class="ticket-qr-stub">
                                            @if (order.Status == "Đã thanh toán" || order.Status == "Completed" || order.Status == "Paid")
                                            {
                                                <button type="button" class="btn btn-action-qr w-100 mb-2 py-2" data-bs-toggle="modal" data-bs-target="#qrModal-@order.OrderId">
                                                    <i class="bi bi-qr-code"></i> Nhận bắp nước
                                                </button>
                                                <small class="text-muted d-block mb-2">Đưa mã QR cho quầy bắp nước</small>
                                            }
                                            else if (order.Status == "Chờ thanh toán" || order.Status == "Đang chờ thanh toán" || order.Status == "Thanh toán thất bại")
                                            {
                                                <button type="button" class="btn btn-warning w-100 mb-2 py-2 rounded-pill fw-bold pay-btn pulse-amber text-dark"
                                                        data-bs-toggle="modal" data-bs-target="#paymentMethodModal-@order.OrderId">
                                                    💳 Thanh toán
                                                </button>

                                                <form asp-controller="Tickets" asp-action="CancelOrder" method="post" class="w-100">
                                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                                    <button type="submit" class="btn btn-link text-danger text-decoration-none small py-1 w-100"
                                                            onclick="return confirm('Bạn có chắc muốn hủy đơn bắp nước này không?');">
                                                        <i class="bi bi-x-circle"></i> Hủy đơn hàng
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <div class="text-muted mb-2 text-center">
                                                    <i class="bi bi-x-circle-fill" style="font-size: 1.8rem;"></i>
                                                </div>
                                                <span class="fw-bold text-muted d-block mb-2 text-center">ĐƠN ĐÃ HỦY</span>
                                            }

                                            <a asp-controller="Tickets" asp-action="Details" asp-route-id="@order.OrderId"
                                               class="btn btn-outline-secondary btn-action-detail w-100 mt-1 py-1.5">
                                                <i class="bi bi-eye"></i> Xem chi tiết
                                            </a>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="card ticket-pass-card h-100 shadow-sm">
                                        <!-- 1. LEFT STUB (POSTER) -->
                                        <div class="ticket-poster-stub">
                                            @if (!string.IsNullOrEmpty(posterUrl))
                                            {
                                                <img class="ticket-poster-image" src="@posterUrl" alt="@movieTitle poster" />
                                            }
                                            else
                                            {
                                                <div class="ticket-poster-fallback">
                                                    <i class="bi bi-film mb-2" style="font-size: 2rem;"></i>
                                                    <span>CINEZONE</span>
                                                </div>
                                            }
                                        </div>

                                        <!-- 2. MIDDLE CONTENT -->
                                        <div class="ticket-pass-content">
                                            <div>
                                                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                    <div>
                                                        <span class="ticket-custom-badge @GetCustomStatusClass(order.Status)">
                                                            @order.Status
                                                        </span>
                                                    </div>
                                                    <small class="text-muted">Đặt lúc: @order.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>

                                                <h5 class="movie-title fw-bold mt-1">@movieTitle</h5>

                                                <div>
                                                    @if (firstTicket?.Showtime?.Movie?.AgeRating != null)
                                                    {
                                                        <span class="badge bg-dark text-white rounded-pill px-2.5 py-1 text-uppercase fw-bold" style="font-size: 0.65rem;">@firstTicket.Showtime.Movie.AgeRating</span>
                                                    }
                                                    @if (firstTicket?.Showtime?.Movie?.Duration != null)
                                                    {
                                                        <span class="text-muted small ms-2"><i class="bi bi-clock"></i> @firstTicket.Showtime.Movie.Duration phút</span>
                                                    }
                                                </div>

                                                <div class="ticket-details-grid mt-2">
                                                    <div class="ticket-detail-item">
                                                        <span class="ticket-detail-label">Mã đơn</span>
                                                        <span class="ticket-detail-value font-monospace text-primary">@("CZ" + order.OrderId.ToString("D6"))</span>
                                                    </div>
                                                    <div class="ticket-detail-item">
                                                        <span class="ticket-detail-label">Suất chiếu</span>
                                                        <span class="ticket-detail-value text-danger">@showtimeStr</span>
                                                    </div>
                                                    <div class="ticket-detail-item">
                                                        <span class="ticket-detail-label">Rạp / Phòng</span>
                                                        <span class="ticket-detail-value">@(!string.IsNullOrEmpty(theaterName) ? theaterName + " - " + roomName : roomName)</span>
                                                    </div>
                                                    <div class="ticket-detail-item">
                                                        <span class="ticket-detail-label">Ghế (@quantity vé)</span>
                                                        <span class="ticket-detail-value text-success">@seatsStr</span>
                                                    </div>
                                                </div>

                                                @if (order.OrderCombos != null && order.OrderCombos.Any())
                                                {
                                                    <div class="combo-badge-summary">
                                                        <i class="bi bi-cup-straw"></i>
                                                        Combo: @string.Join(", ", order.OrderCombos.Select(oc => $"{oc.Combo?.Name} x{oc.Quantity}"))
                                                    </div>
                                                }
                                            </div>

                                            <div class="border-top mt-3 pt-2 d-flex justify-content-between align-items-center">
                                                <div>
                                                    <span class="text-muted small d-block">Tổng tiền:</span>
                                                    <span class="fw-bold text-danger fs-5">@String.Format("{0:N0} ₫", order.TotalAmount)</span>
                                                </div>
                                                <small class="text-muted font-monospace">@order.PaymentMethod</small>
                                            </div>
                                        </div>

                                        <!-- 3. RIGHT STUB -->
                                        <div class="ticket-qr-stub">
                                            @if (order.Status == "Đã thanh toán" || order.Status == "Completed" || order.Status == "Paid")
                                            {
                                                <button type="button" class="btn btn-action-qr w-100 mb-2 py-2" data-bs-toggle="modal" data-bs-target="#qrModal-@order.OrderId">
                                                    <i class="bi bi-qr-code"></i> Xem mã QR
                                                </button>
                                                <small class="text-muted d-block mb-2">Đưa mã QR cho nhân viên rạp</small>
                                            }
                                            else if (order.Status == "Chờ thanh toán" || order.Status == "Đang chờ thanh toán" || order.Status == "Thanh toán thất bại")
                                            {
                                                <button type="button" class="btn btn-warning w-100 mb-2 py-2 rounded-pill fw-bold pay-btn pulse-amber text-dark"
                                                        data-bs-toggle="modal" data-bs-target="#paymentMethodModal-@order.OrderId">
                                                    💳 Thanh toán
                                                </button>

                                                <form asp-controller="Tickets" asp-action="CancelOrder" method="post" class="w-100">
                                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                                    <button type="submit" class="btn btn-link text-danger text-decoration-none small py-1 w-100"
                                                            onclick="return confirm('Bạn có chắc muốn hủy đơn đặt vé này không?');">
                                                        <i class="bi bi-x-circle"></i> Hủy đơn hàng
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <div class="text-muted mb-2 text-center">
                                                    <i class="bi bi-x-circle-fill" style="font-size: 1.8rem;"></i>
                                                </div>
                                                <span class="fw-bold text-muted d-block mb-2 text-center">ĐƠN ĐÃ HỦY</span>
                                            }

                                            <a asp-controller="Tickets" asp-action="Details" asp-route-id="@order.OrderId"
                                               class="btn btn-outline-secondary btn-action-detail w-100 mt-1 py-1.5">
                                                <i class="bi bi-eye"></i> Xem chi tiết
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <!-- Filter Dynamic Empty State -->
                        <div id="filterEmptyCard" class="empty-orders-card" style="display: none;">
                            <div class="text-muted mb-3"><i class="bi bi-box2" style="font-size: 3.5rem;"></i></div>
                            <h5 class="fw-bold text-dark">Không tìm thấy đơn hàng nào</h5>
                            <p class="text-muted small mb-4">Bạn chưa có đơn hàng nào thuộc trạng thái này. Khám phá các siêu phẩm điện ảnh mới nhất ngay!</p>
                            <a href="/Home" class="btn btn-success fw-bold px-4 py-2 rounded-pill shadow-sm"><i class="bi bi-cart-fill me-1"></i> Đặt Vé Ngay</a>
                        </div>
                    }
                </div>
            </div>

            <!-- 👤 PANE 2: THÔNG TIN CÁ NHÂN & ĐẶC QUYỀN -->
            <div id="pane-info" class="main-tab-content" style="display: none;">
                <div class="mb-4">
                    <h4 class="fw-bold text-dark m-0">Xin chào, @Model.FullName!</h4>
                    <p class="text-muted small">Chào mừng bạn quay trở lại với không gian điện ảnh CineZone.</p>
                </div>

                <div class="row g-3 mb-5">
                    <div class="col-sm-6">
                        <div class="stat-card">
                            <div class="stat-icon stat-icon-money">
                                <i class="bi bi-wallet2"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block small uppercase fw-bold">Tổng chi tiêu</small>
                                <span class="fw-bold text-dark fs-5">@Model.TotalSpent.ToString("N0") ₫</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="stat-card">
                            <div class="stat-icon stat-icon-phone">
                                <i class="bi bi-telephone"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block small uppercase fw-bold">Số điện thoại</small>
                                <span class="fw-bold text-dark fs-6">@Model.Phone</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="stat-card">
                            <div class="stat-icon stat-icon-calendar">
                                <i class="bi bi-calendar3"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block small uppercase fw-bold">Thành viên từ</small>
                                <span class="fw-bold text-dark fs-6">@Model.CreatedAt?.ToString("dd/MM/yyyy")</span>
