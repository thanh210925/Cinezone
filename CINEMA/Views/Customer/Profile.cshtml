@functions {
    public string GetCustomStatusClass(string? status)
    {
        if (status == "Đã thanh toán" || status == "Completed" || status == "Paid")
            return "badge-paid";
        if (status != null && (status.Contains("chờ") || status.Contains("Chờ")))
            return "badge-pending";
        return "badge-cancelled";
    }
}

@section Scripts {
    <script src="~/js/pages/tickets/mytickets.js" asp-append-version="true"></script>
    <script>
        function switchMainTab(tabName) {
            const btnOrders = document.getElementById('btn-tab-orders');
            const btnInfo = document.getElementById('btn-tab-info');
            const paneOrders = document.getElementById('pane-orders');
            const paneInfo = document.getElementById('pane-info');

            if (tabName === 'orders') {
                btnOrders.classList.add('active');
                btnInfo.classList.remove('active');
                paneOrders.style.display = 'block';
                paneInfo.style.display = 'none';
            } else {
                btnInfo.classList.add('active');
                btnOrders.classList.remove('active');
                paneInfo.style.display = 'block';
                paneOrders.style.display = 'none';
            }
        }

        function filterUserOrders(cat, pillBtn) {
            document.querySelectorAll('.order-filter-pill').forEach(b => b.classList.remove('active'));
            pillBtn.classList.add('active');

            const orderItems = document.querySelectorAll('.user-order-item');
            let matchCount = 0;

            orderItems.forEach(item => {
                const itemCat = item.getAttribute('data-category');
                if (cat === 'all' || itemCat === cat) {
                    item.style.display = 'block';
                    matchCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            const filterEmptyCard = document.getElementById('filterEmptyCard');
            if (filterEmptyCard) {
                filterEmptyCard.style.display = (matchCount === 0 && orderItems.length > 0) ? 'block' : 'none';
            }
        }

        function showPaymentTransitionOverlay(method, evt) {
            if (evt) {
                evt.preventDefault();
            }
            const href = evt.currentTarget ? evt.currentTarget.getAttribute('href') : null;
            const overlay = document.getElementById("paymentLoadingOverlay");
            const iconBox = document.getElementById("paymentLoadingIcon");
            const textEl = document.getElementById("paymentLoadingText");

            if (method === 'VietQR') {
                if (iconBox) iconBox.innerHTML = '<i class="bi bi-bank2 text-info"></i>';
                if (textEl) textEl.innerText = "Đang chuyển đến trang thanh toán QR ngân hàng...";
            } else {
                if (iconBox) iconBox.innerHTML = '<i class="bi bi-credit-card-2-front-fill text-warning"></i>';
                if (textEl) textEl.innerText = "Đang chuyển sang cổng thanh toán thẻ quốc tế Stripe...";
            }

            if (overlay) overlay.classList.add("active");

            setTimeout(() => {
                if (href) window.location.href = href;
            }, 1000);
        }
    </script>
}

<!-- OVERLAY TRẠNG THÁI CHỜ THANH TOÁN -->
<div id="paymentLoadingOverlay" class="payment-loading-overlay">
    <div class="payment-loading-card">
        <div class="payment-icon-wrapper mb-3">
