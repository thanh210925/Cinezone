@model CINEMA.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Xác nhận & Thanh toán";
}

<!-- Custom Styles for checkout page -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

@section Styles {
    <link rel="stylesheet" href="~/css/pages/payment/index.css" asp-append-version="true" />
}

<div class="container checkout-container">

    <div class="checkout-marquee">
        <div>
            <p class="checkout-marquee-title">XÁC NHẬN THANH TOÁN VÉ</p>
            <p class="checkout-marquee-sub">Kiểm tra kỹ thông tin đơn hàng trước khi chuyển khoản</p>
        </div>
        <div class="checkout-marquee-icon"><i class="bi bi-shield-check"></i></div>
    </div>

    <div class="row g-4">
        <!-- LEFT: BOOKING DETAIL -->
        <div class="col-lg-7">

            <div class="checkout-card">
                <div class="checkout-card-header"><i class="bi bi-person"></i> Thông tin khách hàng</div>
                <div class="checkout-card-body">
                    @if (!string.IsNullOrEmpty(Model.CustomerName))
                    {
                        <div class="field-grid">
                            <div>
                                <span class="field-label">Họ và tên</span>
                                <span class="field-value">@Model.CustomerName</span>
                            </div>
                            <div>
                                <span class="field-label">Số điện thoại</span>
                                <span class="field-value">@Model.CustomerPhone</span>
                            </div>
                            <div class="field-full">
                                <span class="field-label">Email</span>
                                <span class="field-value">@Model.CustomerEmail</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Đang tải...</p>
                    }
                </div>
            </div>

            <div class="checkout-card">
                <div class="checkout-card-header"><i class="bi bi-ticket-perforated"></i> Chi tiết đặt vé</div>
                <div class="checkout-card-body">

                    <div class="movie-strip">
                        <div>
                            <p class="movie-strip-title">@Model.MovieTitle</p>
                            <p class="movie-strip-tag">CineZone Movie Ticket</p>
                        </div>
                        <i class="bi bi-film movie-strip-reel"></i>
                    </div>

                    <div class="field-grid mb-4">
                        <div>
                            <span class="field-label">Rạp chiếu</span>
                            <span class="field-value">@Model.TheaterName</span>
                        </div>
                        <div>
                            <span class="field-label">Phòng chiếu</span>
                            <span class="field-value">@Model.Auditorium</span>
                        </div>
                        <div>
                            <span class="field-label">Suất chiếu</span>
                            <span class="field-value text-danger">@Model.Showtime</span>
                        </div>
                        <div>
                            <span class="field-label">Vị trí rạp</span>
                            <span class="text-muted small d-block" style="line-height: 1.3;">@Model.TheaterAddress</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <p class="section-label"><i class="bi bi-grid-3x3-gap-fill"></i> Ghế đã chọn</p>
                        <div>
                            @if (Model.SelectedSeats != null && Model.SelectedSeats.Any())
                            {
                                foreach (var seat in Model.SelectedSeats)
                                {
                                    <span class="seat-pill">@seat</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Không có</span>
                            }
                        </div>
                    </div>

                    <p class="section-label"><i class="bi bi-tags-fill"></i> Phân loại vé</p>
                    <div class="checkout-list-group mb-4">
                        <div class="checkout-list-item">
                            <span>Người lớn</span>
                            <span class="field-value">@Model.AdultTickets vé</span>
                        </div>
                        <div class="checkout-list-item">
                            <span>Trẻ em</span>
                            <span class="field-value">@Model.ChildTickets vé</span>
                        </div>
                        <div class="checkout-list-item">
                            <span>Học sinh / Sinh viên</span>
                            <span class="field-value">@Model.StudentTickets vé</span>
                        </div>
                    </div>

                    @if (Model.Combos != null && Model.Combos.Any())
                    {
                        <p class="section-label"><i class="bi bi-egg-fried"></i> Combo bắp nước đã chọn</p>
                        <div class="checkout-list-group mb-4">
                            @foreach (var combo in Model.Combos)
                            {
                                <div class="checkout-list-item">
                                    <span>@combo.ComboName <span class="text-muted">x @combo.Quantity</span></span>
                                    <span class="text-danger fw-bold">@((combo.Price * combo.Quantity).ToString("N0")) ₫</span>
                                </div>
                            }
                        </div>
                    }

                    @* 💡 Gợi ý Nâng cấp Combo (Upselling) *@
                    @{
                        var upsells = ViewBag.UpsellOffers as List<CINEMA.ViewModels.UpsellOffer>;
                    }
                    @if (upsells != null && upsells.Any())
                    {
                        <div class="card border-warning bg-warning bg-opacity-10 rounded-4 mb-4 p-3" style="border-style: dashed !important; border-width: 1.5px !important; border-color: #ffc107 !important; background-color: #fffdf5 !important;">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-gift-fill text-warning me-2 fs-5"></i>
                                <span class="fw-bold text-dark" style="font-size:0.9rem;">Ưu đãi nâng cấp Combo từ AI</span>
                            </div>
                            <p class="text-muted small mb-3">Nâng cấp combo của bạn lên cỡ lớn hơn hoặc gói ưu đãi để thưởng thức trọn vẹn hơn với mức giá tiết kiệm:</p>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var offer in upsells)
                                {
                                    <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded-3 border">
                                        <div class="small text-dark">
                                            <span class="text-muted text-decoration-line-through">@offer.CurrentComboName</span>
                                            <i class="bi bi-arrow-right mx-1 text-secondary"></i>
                                            <span class="fw-bold">@offer.UpgradedComboName</span>
                                        </div>
                                        <a href="@Url.Action("UpgradeCombo", "Payment", new { currentId = offer.CurrentComboId, upgradedId = offer.UpgradedComboId })" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold py-1" style="font-size:0.75rem; color: #000;">
                                            +@offer.PriceDiff.ToString("N0") ₫
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- KHU VỰC NHẬP VOUCHER -->
                    <p class="section-label"><i class="bi bi-gift-fill text-danger"></i> Mã giảm giá / Voucher</p>
                    <div class="card p-3 border rounded-3 bg-light mb-4 shadow-xs" style="background-color: #f8f9fa !important;">
                        <div class="input-group">
                            <input type="text" id="checkoutVoucherCode" class="form-control text-uppercase fw-bold" placeholder="Nhập mã voucher..." value="@Model.VoucherCode" style="letter-spacing: 1px;" />
                            <button type="button" class="btn btn-warning fw-bold px-4 text-dark" onclick="applyCheckoutVoucher()">Áp dụng</button>
                        </div>
                        <div id="checkoutVoucherMessage" class="mt-2 small fw-semibold"></div>
                    </div>

                    <p class="section-label"><i class="bi bi-receipt"></i> Chi tiết thanh toán</p>
                    <div class="checkout-list-group mb-4" id="payment-details-list">
                        <div class="checkout-list-item">
                            <span>Tổng tiền gốc</span>
                            <span class="fw-bold text-dark" id="disp-original-price">@Model.OriginalPrice.ToString("N0") ₫</span>
                        </div>
                        
                        <div class="checkout-list-item" id="row-membership-discount" style="@(Model.MembershipDiscountAmount > 0 ? "" : "display: none;")">
                            <span class="text-success fw-semibold"><i class="bi bi-gem me-1"></i> Ưu đãi hạng @Model.MembershipLevel</span>
                            <span class="text-success fw-bold" id="disp-membership-discount">-@Model.MembershipDiscountAmount.ToString("N0") ₫ (-@Model.MembershipDiscountPercent.ToString("0")%)</span>
                        </div>

                        <div class="checkout-list-item" id="row-voucher-discount" style="@(Model.DiscountAmount > 0 ? "" : "display: none;")">
                            <span class="text-danger fw-semibold"><i class="bi bi-tag-fill me-1"></i> Giảm giá Voucher (<span id="disp-voucher-code">@Model.VoucherCode</span>)</span>
                            <span class="text-danger fw-bold" id="disp-voucher-discount">-@(Model.DiscountAmount?.ToString("N0") ?? "0") ₫</span>
                        </div>
                    </div>

                    <div class="ticket-perforation"></div>

                    <div class="total-price-box">
                        <span class="total-price-label">Tổng thanh toán</span>
                        <span class="total-price-value" id="disp-total-price">@Model.TotalPrice.ToString("N0") ₫</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: PAYMENT & CONFIRMATION -->
        <div class="col-lg-5">
            <div class="payment-sticky">
                <div class="checkout-card">
                    <div class="checkout-card-header"><i class="bi bi-credit-card"></i> Cổng thanh toán</div>
                    <div class="checkout-card-body">
                        <form asp-controller="Payment" asp-action="Confirm" method="post" id="checkoutPaymentForm">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="MovieId" />
                            <input type="hidden" asp-for="ShowtimeId" />
                            @foreach (var seat in Model.SelectedSeats)
                            {
                                <input type="hidden" name="SelectedSeats" value="@seat" />
                            }
                            <input type="hidden" asp-for="AdultTickets" />
                            <input type="hidden" asp-for="ChildTickets" />
                            <input type="hidden" asp-for="StudentTickets" />
                            <input type="hidden" asp-for="TotalPrice" />
                            <input type="hidden" asp-for="VoucherCode" />

                            @if (Model.Combos != null)
                            {
                                @for (int i = 0; i < Model.Combos.Count; i++)
                                {
                                    <input type="hidden" name="Combos[@i].OrderComboId" value="@Model.Combos[i].OrderComboId" />
                                    <input type="hidden" name="Combos[@i].ComboId" value="@Model.Combos[i].ComboId" />
                                    <input type="hidden" name="Combos[@i].ComboName" value="@Model.Combos[i].ComboName" />
                                    <input type="hidden" name="Combos[@i].Quantity" value="@Model.Combos[i].Quantity" />
                                    <input type="hidden" name="Combos[@i].Price" value="@Model.Combos[i].Price" />
                                }
                            }





                            @* //NEWWWWWWW *@
                            <div class="mb-3 mt-2">
                                <p class="section-label mb-2" style="font-size: 0.85rem;"><i class="bi bi-wallet2"></i> Chọn phương thức thanh toán</p>

                                <label class="payment-method-box active" onclick="selectPaymentBox(this)">
                                    <input type="radio" name="method" value="VietQR" checked onchange="updatePaymentUI()" />
                                    <i class="bi bi-qr-code payment-method-icon text-success"></i>
                                    <div class="payment-method-details">
                                        <span class="payment-method-name">Thanh toán VietQR (Thật)</span>
                                        <span class="payment-method-desc">Quét mã QR tự động xác nhận tức thì (Napas 24/7)</span>
                                    </div>
                                </label>

                                <label class="payment-method-box" onclick="selectPaymentBox(this)">
                                    <input type="radio" name="method" value="Chuyển khoản" onchange="updatePaymentUI()" />
                                    <i class="bi bi-qr-code-scan payment-method-icon text-primary"></i>
                                    <div class="payment-method-details">
                                        <span class="payment-method-name">Ví VNPAY / App Ngân hàng</span>
                                        <span class="payment-method-desc">Cổng thanh toán trực tuyến VNPAY</span>
                                    </div>
                                </label>

                                <label class="payment-method-box" onclick="selectPaymentBox(this)">
                                    <input type="radio" name="method" value="Online" onchange="updatePaymentUI()" />
                                    <i class="bi bi-credit-card-2-front-fill payment-method-icon text-warning"></i>
                                    <div class="payment-method-details">
                                        <span class="payment-method-name">Thẻ quốc tế (Stripe)</span>
                                        <span class="payment-method-desc">Thanh toán bằng thẻ Visa, Mastercard...</span>
                                    </div>
                                </label>

                                <label class="payment-method-box" onclick="selectPaymentBox(this)">
                                    <input type="radio" name="method" value="Tại quầy" onchange="updatePaymentUI()" />
                                    <i class="bi bi-shop payment-method-icon text-info"></i>
                                    <div class="payment-method-details">
                                        <span class="payment-method-name">Thanh toán tại quầy</span>
                                        <span class="payment-method-desc">Giữ ghế và thanh toán khi đến rạp</span>
                                    </div>
                                </label>
                            </div>

                           <div class="gateway-info">
                                <i class="bi bi-info-circle-fill"></i>
                                <span id="gateway-info-text">Bạn sẽ được chuyển hướng an toàn sang cổng thanh toán trực tuyến <strong>VNPAY</strong> để xác thực thẻ/tài khoản ngân hàng của bạn.</span>
                            </div>

                            <div class="custom-check-box" onclick="var chk = this.querySelector('input'); chk.checked = !chk.checked;">
                                <input type="checkbox" id="checkAge" class="form-check-input" required onclick="event.stopPropagation();">
                                <label for="checkAge" onclick="event.stopPropagation();">
                                    Tôi xác nhận đã chọn phim đúng độ tuổi quy định và sẽ xuất trình giấy tờ tùy thân nếu rạp có yêu cầu kiểm tra.
                                </label>
                            </div>

                            <div class="custom-check-box" onclick="var chk = this.querySelector('input'); chk.checked = !chk.checked;">
                                <input type="checkbox" id="checkTerms" class="form-check-input" required onclick="event.stopPropagation();">
                                <label for="checkTerms" onclick="event.stopPropagation();">
                                    Tôi đồng ý với các chính sách hoàn đổi vé, bảo mật và điều khoản sử dụng dịch vụ của CineZone.
                                </label>
                            </div>

                            <button type="submit" id="btn-submit-payment" class="btn btn-pay-vnpay mt-3">
                                <i class="bi bi-credit-card-fill me-2"></i>Xác nhận & Thanh toán VNPAY
                            </button>

                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- OVERLAY TRẠNG THÁI CHỜ THANH TOÁN (Modern Glassmorphic Overlay Modal) -->
<div id="paymentLoadingOverlay" class="payment-loading-overlay">
    <div class="payment-loading-card">
        <div class="payment-icon-wrapper mb-3">
            <div class="payment-icon-pulse"></div>
            <div class="payment-icon-box" id="paymentLoadingIcon">
                <i class="bi bi-bank2"></i>
            </div>
        </div>
        <h3 class="payment-loading-title mb-2">Đặt hàng thành công!</h3>
        <p class="payment-loading-sub mb-4" id="paymentLoadingText">Đang chuyển đến trang thanh toán QR ngân hàng...</p>
        <div class="payment-progress-container">
            <div class="payment-progress-bar"></div>
        </div>
    </div>
</div>

@* //NEWWWWWWW *@
@section Scripts {
    <script>
        window.PaymentIndexConfig = {
            originalPrice: "@Model.OriginalPrice",
            membershipDiscountAmount: "@Model.MembershipDiscountAmount",
            comboTotal: "@(Model.Combos?.Sum(c => c.Price * c.Quantity) ?? 0)"
        };
    </script>
    <script src="~/js/pages/payment/index.js" asp-append-version="true"></script>
}