@model CINEMA.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Xác nhận & Thanh toán";
}

<!-- Custom Styles for checkout page -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --color-gold: #f0b429;
        --color-gold-soft: #ffe6a3;
        --color-crimson: #e0263d;
        --color-crimson-dark: #b81430;
        --color-ink: #0c0c10;
        --color-charcoal: #17171d;
        --color-charcoal-soft: #201f27;
        --color-canvas: #edeae2;
        --color-paper: #ffffff;
        --color-line: rgba(12, 12, 16, 0.1);
        --font-display: 'Roboto', sans-serif;
        --font-body: 'Inter', sans-serif;
    }

    body {
        background: var(--color-canvas);
        font-family: var(--font-body);
    }

    .checkout-container {
        max-width: 1120px;
        margin: 2.5rem auto 4rem;
    }

    /* ---------- Marquee header ---------- */
    .checkout-marquee {
        background: var(--color-ink);
        border-radius: 18px;
        padding: 1.75rem 2rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        position: relative;
        overflow: hidden;
        border: 1px solid #000;
    }

    .checkout-marquee::before {
        content: "";
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(90deg, var(--color-gold) 0 10px, transparent 10px 22px);
        opacity: 0.5;
        height: 4px;
        top: 0;
    }

    .checkout-marquee::after {
        content: "";
        position: absolute;
        inset: 0;
        background: repeating-linear-gradient(90deg, var(--color-gold) 0 10px, transparent 10px 22px);
        opacity: 0.5;
        height: 4px;
        bottom: 0;
        top: auto;
    }

    .checkout-marquee-title {
        font-family: var(--font-display);
        font-size: 2.1rem;
        letter-spacing: 1px;
        color: var(--color-gold-soft);
        margin: 0;
        line-height: 1;
    }

    .checkout-marquee-sub {
        color: rgba(255,255,255,0.55);
        font-size: 0.85rem;
        margin-top: 0.3rem;
        letter-spacing: 0.2px;
    }

    .checkout-marquee-icon {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        background: var(--color-gold);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-ink);
        font-size: 1.3rem;
        flex: none;
    }

    /* ---------- Cards ---------- */
    .checkout-card {
        background: var(--color-paper);
        border-radius: 16px;
        border: 1px solid var(--color-line);
        overflow: hidden;
        margin-bottom: 1.25rem;
    }

    .checkout-card-header {
        background: var(--color-charcoal);
        color: var(--color-gold-soft);
        padding: 0.9rem 1.5rem;
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .checkout-card-body {
        padding: 1.5rem;
    }

    /* ---------- Field grid ---------- */
    .field-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem 1.25rem;
    }

    .field-grid .field-full { grid-column: 1 / -1; }

    .field-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: #9a9aa5;
        margin-bottom: 2px;
    }

    .field-value {
        font-weight: 700;
        color: var(--color-ink);
        font-size: 0.95rem;
    }

    /* ---------- Movie strip ---------- */
    .movie-strip {
        background: var(--color-ink);
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        color: #fff;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }

    .movie-strip-title {
        font-family: var(--font-display);
        font-size: 1.7rem;
        letter-spacing: 0.5px;
        color: var(--color-gold-soft);
        margin: 0;
        line-height: 1.1;
    }

    .movie-strip-tag {
        font-size: 0.72rem;
        color: rgba(255,255,255,0.45);
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-top: 4px;
    }

    .movie-strip-reel {
        font-size: 1.6rem;
        color: var(--color-gold);
        flex: none;
        opacity: 0.85;
    }

    /* ---------- Seat pills ---------- */
    .seat-pill {
        background: #fdf3da;
        color: #93650a;
        border: 1px solid #f2dfa3;
        padding: 3px 11px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.82rem;
        display: inline-block;
        margin: 0 6px 6px 0;
    }

    /* ---------- List rows ---------- */
    .checkout-list-group {
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--color-line);
    }

    .checkout-list-item {
        padding: 0.7rem 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--color-paper);
        border-bottom: 1px solid var(--color-line);
        font-size: 0.9rem;
    }

    .checkout-list-item:last-child { border-bottom: none; }
    .checkout-list-item:nth-child(even) { background: #fafaf8; }

    .section-label {
        font-family: var(--font-display);
        font-size: 1.05rem;
        letter-spacing: 0.5px;
        color: var(--color-charcoal);
        margin-bottom: 0.65rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* ---------- Perforation + total ---------- */
    .ticket-perforation {
        position: relative;
        height: 0;
        border-top: 2px dashed #d8d5cc;
        margin: 1.5rem 0;
    }

    .ticket-perforation::before,
    .ticket-perforation::after {
        content: "";
        position: absolute;
        top: -11px;
        width: 22px;
        height: 22px;
        background: var(--color-canvas);
        border-radius: 50%;
    }

    .ticket-perforation::before { left: -1.5rem; }
    .ticket-perforation::after { right: -1.5rem; }

    .total-price-box {
        background: var(--color-ink);
        border-radius: 14px;
        padding: 1.1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 0.25rem;
    }

    .total-price-label {
        color: rgba(255,255,255,0.6);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 700;
    }

    .total-price-value {
        font-family: var(--font-display);
        font-size: 2rem;
        color: var(--color-gold);
        letter-spacing: 0.5px;
    }

    /* ---------- Right column / payment ---------- */
    .payment-sticky { position: sticky; top: 1.5rem; }

    .gateway-info {
        background: #fff7e6;
        border: 1px solid #f6e3ae;
        color: #7a5205;
        border-radius: 12px;
        padding: 0.85rem 1rem;
        font-size: 0.83rem;
        line-height: 1.5;
        margin-bottom: 1.1rem;
        display: flex;
        gap: 10px;
    }

    .gateway-info i { color: var(--color-gold); margin-top: 2px; }

    .custom-check-box {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 0.7rem 0.9rem;
        border: 1.5px solid var(--color-line);
        border-radius: 12px;
        margin-bottom: 0.75rem;
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease;
        background: var(--color-paper);
    }

    .custom-check-box:hover {
        border-color: var(--color-gold);
        background: #fffdf5;
    }

    .custom-check-box input[type="checkbox"] { margin-top: 2px; accent-color: var(--color-crimson); }

    .custom-check-box label {
        font-size: 0.82rem;
        color: #55555f;
        line-height: 1.45;
        cursor: pointer;
    }

    .btn-pay-vnpay {
        background: var(--color-crimson);
        color: #ffffff;
        font-weight: 800;
        font-size: 1.02rem;
        letter-spacing: 0.3px;
        padding: 13px 20px;
        border-radius: 12px;
        border: none;
        width: 100%;
        margin-top: 0.5rem;
        transition: background 0.15s ease, transform 0.1s ease;
    }

    .btn-pay-vnpay:hover {
        background: var(--color-crimson-dark);
        transform: translateY(-1px);
        color: #ffffff;
    }

    .btn-pay-vnpay:active { transform: translateY(0); }

    @@media (max-width: 767px) {
        .field-grid { grid-template-columns: 1fr; }
        .payment-sticky { position: static; }
        .checkout-marquee { flex-direction: column; align-items: flex-start; text-align: left; }
    }
</style>

<div class="container checkout-container">

    <div class="checkout-marquee">
        <div>
            <p class="checkout-marquee-title">XÁC NHẬN THANH TOÁN VÉ</p>
            <p class="checkout-marquee-sub">Kiểm tra kỹ thông tin đơn hàng trước khi chuyển khoản</p>
        </div>
        <div class="checkout-marquee-icon"><i class="bi bi-shield-check"></i></div>
    </div>

    <div class="row g-4">
        <!-- LEFT: BOOKING DETAIL -->
        <div class="col-lg-7">

            <div class="checkout-card">
                <div class="checkout-card-header"><i class="bi bi-person"></i> Thông tin khách hàng</div>
                <div class="checkout-card-body">
                    @if (!string.IsNullOrEmpty(Model.CustomerName))
                    {
                        <div class="field-grid">
                            <div>
                                <span class="field-label">Họ và tên</span>
                                <span class="field-value">@Model.CustomerName</span>
                            </div>
                            <div>
                                <span class="field-label">Số điện thoại</span>
                                <span class="field-value">@Model.CustomerPhone</span>
                            </div>
                            <div class="field-full">
                                <span class="field-label">Email</span>
                                <span class="field-value">@Model.CustomerEmail</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Đang tải...</p>
                    }
                </div>
            </div>

            <div class="checkout-card">
                <div class="checkout-card-header"><i class="bi bi-ticket-perforated"></i> Chi tiết đặt vé</div>
                <div class="checkout-card-body">

                    <div class="movie-strip">
                        <div>
                            <p class="movie-strip-title">@Model.MovieTitle</p>
                            <p class="movie-strip-tag">CineZone Movie Ticket</p>
                        </div>
                        <i class="bi bi-film movie-strip-reel"></i>
                    </div>

                    <div class="field-grid mb-4">
                        <div>
                            <span class="field-label">Rạp chiếu</span>
                            <span class="field-value">@Model.TheaterName</span>
                        </div>
                        <div>
                            <span class="field-label">Phòng chiếu</span>
                            <span class="field-value">@Model.Auditorium</span>
                        </div>
                        <div>
                            <span class="field-label">Suất chiếu</span>
                            <span class="field-value text-danger">@Model.Showtime</span>
                        </div>
                        <div>
                            <span class="field-label">Vị trí rạp</span>
                            <span class="text-muted small d-block" style="line-height: 1.3;">@Model.TheaterAddress</span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <p class="section-label"><i class="bi bi-grid-3x3-gap-fill"></i> Ghế đã chọn</p>
                        <div>
                            @if (Model.SelectedSeats != null && Model.SelectedSeats.Any())
                            {
                                foreach (var seat in Model.SelectedSeats)
                                {
                                    <span class="seat-pill">@seat</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small">Không có</span>
                            }
                        </div>
                    </div>

                    <p class="section-label"><i class="bi bi-tags-fill"></i> Phân loại vé</p>
                    <div class="checkout-list-group mb-4">
                        <div class="checkout-list-item">
                            <span>Người lớn</span>
                            <span class="field-value">@Model.AdultTickets vé</span>
                        </div>
                        <div class="checkout-list-item">
                            <span>Trẻ em</span>
                            <span class="field-value">@Model.ChildTickets vé</span>
                        </div>
                        <div class="checkout-list-item">
                            <span>Học sinh / Sinh viên</span>
                            <span class="field-value">@Model.StudentTickets vé</span>
                        </div>
                    </div>

                    @if (Model.Combos != null && Model.Combos.Any())
                    {
                        <p class="section-label"><i class="bi bi-egg-fried"></i> Combo bắp nước đã chọn</p>
                        <div class="checkout-list-group mb-4">
                            @foreach (var combo in Model.Combos)
                            {
                                <div class="checkout-list-item">
                                    <span>@combo.ComboName <span class="text-muted">x @combo.Quantity</span></span>
                                    <span class="text-danger fw-bold">@((combo.Price * combo.Quantity).ToString("N0")) ₫</span>
                                </div>
                            }
                        </div>
                    }

                    @* 💡 Gợi ý Nâng cấp Combo (Upselling) *@
                    @{
                        var upsells = ViewBag.UpsellOffers as List<CINEMA.ViewModels.UpsellOffer>;
                    }
                    @if (upsells != null && upsells.Any())
                    {
                        <div class="card border-warning bg-warning bg-opacity-10 rounded-4 mb-4 p-3" style="border-style: dashed !important; border-width: 1.5px !important; border-color: #ffc107 !important; background-color: #fffdf5 !important;">
                            <div class="d-flex align-items-center mb-2">
                                <i class="bi bi-gift-fill text-warning me-2 fs-5"></i>
                                <span class="fw-bold text-dark" style="font-size:0.9rem;">Ưu đãi nâng cấp Combo từ AI</span>
                            </div>
                            <p class="text-muted small mb-3">Nâng cấp combo của bạn lên cỡ lớn hơn hoặc gói ưu đãi để thưởng thức trọn vẹn hơn với mức giá tiết kiệm:</p>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var offer in upsells)
                                {
                                    <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded-3 border">
                                        <div class="small text-dark">
                                            <span class="text-muted text-decoration-line-through">@offer.CurrentComboName</span>
                                            <i class="bi bi-arrow-right mx-1 text-secondary"></i>
                                            <span class="fw-bold">@offer.UpgradedComboName</span>
                                        </div>
                                        <a href="@Url.Action("UpgradeCombo", "Payment", new { currentId = offer.CurrentComboId, upgradedId = offer.UpgradedComboId })" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold py-1" style="font-size:0.75rem; color: #000;">
                                            +@offer.PriceDiff.ToString("N0") ₫
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <p class="section-label"><i class="bi bi-receipt"></i> Chi tiết thanh toán</p>
                    <div class="checkout-list-group mb-4">
                        @if (Model.MembershipDiscountAmount > 0 || Model.DiscountAmount > 0)
                        {
                            <div class="checkout-list-item">
                                <span>Tổng tiền gốc</span>
                                <span class="text-muted text-decoration-line-through">@Model.OriginalPrice.ToString("N0") ₫</span>
                            </div>
                            @if (Model.MembershipDiscountAmount > 0)
                            {
                                <div class="checkout-list-item">
                                    <span class="text-success fw-semibold"><i class="bi bi-gem me-1"></i> Ưu đãi hạng @Model.MembershipLevel</span>
                                    <span class="text-success fw-bold">-@Model.MembershipDiscountAmount.ToString("N0") ₫ (-@Model.MembershipDiscountPercent.ToString("0")%)</span>
                                </div>
                            }
                            @if (Model.DiscountAmount > 0)
                            {
                                <div class="checkout-list-item">
                                    <span class="text-danger fw-semibold"><i class="bi bi-tag-fill me-1"></i> Giảm giá Voucher (@Model.VoucherCode)</span>
                                    <span class="text-danger fw-bold">-@Model.DiscountAmount?.ToString("N0") ₫</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="checkout-list-item">
                                <span>Tổng thanh toán</span>
                                <span class="fw-bold text-dark">@Model.OriginalPrice.ToString("N0") ₫</span>
                            </div>
                        }
                    </div>

                    <div class="ticket-perforation"></div>

                    <div class="total-price-box">
                        <span class="total-price-label">Tổng thanh toán</span>
                        <span class="total-price-value">@Model.TotalPrice.ToString("N0") ₫</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: PAYMENT & CONFIRMATION -->
        <div class="col-lg-5">
            <div class="payment-sticky">
                <div class="checkout-card">
                    <div class="checkout-card-header"><i class="bi bi-credit-card"></i> Cổng thanh toán</div>
                    <div class="checkout-card-body">
                        <form asp-controller="Payment" asp-action="Confirm" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="MovieId" />
                            <input type="hidden" asp-for="ShowtimeId" />
                            @foreach (var seat in Model.SelectedSeats)
                            {
                                <input type="hidden" name="SelectedSeats" value="@seat" />
                            }
                            <input type="hidden" asp-for="AdultTickets" />
                            <input type="hidden" asp-for="ChildTickets" />
                            <input type="hidden" asp-for="StudentTickets" />
                            <input type="hidden" asp-for="TotalPrice" />
                            <input type="hidden" asp-for="VoucherCode" />

                            @if (Model.Combos != null)
                            {
                                @for (int i = 0; i < Model.Combos.Count; i++)
                                {
                                    <input type="hidden" name="Combos[@i].OrderComboId" value="@Model.Combos[i].OrderComboId" />
                                    <input type="hidden" name="Combos[@i].ComboId" value="@Model.Combos[i].ComboId" />
                                    <input type="hidden" name="Combos[@i].ComboName" value="@Model.Combos[i].ComboName" />
                                    <input type="hidden" name="Combos[@i].Quantity" value="@Model.Combos[i].Quantity" />
                                    <input type="hidden" name="Combos[@i].Price" value="@Model.Combos[i].Price" />
                                }
                            }

                            <input type="hidden" name="method" value="Chuyển khoản" />

                            <div class="gateway-info">
                                <i class="bi bi-info-circle-fill"></i>
                                <span>Bạn sẽ được chuyển hướng an toàn sang cổng thanh toán trực tuyến <strong>VNPAY</strong> để xác thực thẻ/tài khoản ngân hàng của bạn.</span>
                            </div>

                            <div class="custom-check-box" onclick="var chk = this.querySelector('input'); chk.checked = !chk.checked;">
                                <input type="checkbox" id="checkAge" class="form-check-input" required onclick="event.stopPropagation();">
                                <label for="checkAge" onclick="event.stopPropagation();">
                                    Tôi xác nhận đã chọn phim đúng độ tuổi quy định và sẽ xuất trình giấy tờ tùy thân nếu rạp có yêu cầu kiểm tra.
                                </label>
                            </div>

                            <div class="custom-check-box" onclick="var chk = this.querySelector('input'); chk.checked = !chk.checked;">
                                <input type="checkbox" id="checkTerms" class="form-check-input" required onclick="event.stopPropagation();">
                                <label for="checkTerms" onclick="event.stopPropagation();">
                                    Tôi đồng ý với các chính sách hoàn đổi vé, bảo mật và điều khoản sử dụng dịch vụ của CineZone.
                                </label>
                            </div>

                            <button type="submit" class="btn btn-pay-vnpay">
                                <i class="bi bi-credit-card-fill me-2"></i>Xác nhận & Thanh toán VNPAY
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
