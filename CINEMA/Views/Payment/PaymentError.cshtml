@{
    ViewData["Title"] = "Thanh toán thất bại";
    Layout = "_Layout";
}

<!-- Custom Styles for Receipt view -->
@section Styles {
    <link rel="stylesheet" href="~/css/pages/payment/paymenterror.css" asp-append-version="true" />
}

<div class="container receipt-container">
    <div class="receipt-card text-center">
        
        <!-- HEADER STATUS ZONE -->
        <div class="status-glow-icon status-glow-danger">
            <i class="bi bi-x-circle-fill"></i>
        </div>
        <h2 class="fw-bold text-danger m-0">Thanh toán thất bại!</h2>
        <p class="text-muted mt-2">Đã có lỗi xảy ra trong quá trình xử lý giao dịch thanh toán trực tuyến.</p>

        <hr class="my-4">

        <!-- DYNAMIC ERROR MSG -->
        <div class="alert alert-danger border-0 rounded-4 p-4 text-start mb-4">
            <h6 class="fw-bold"><i class="bi bi-exclamation-triangle-fill"></i> Chi tiết lỗi:</h6>
            @if (TempData["Error"] != null)
            {
                <!-- Hiển thị lỗi từ Stripe -->
                <p class="mb-0 text-dark small" style="line-height: 1.4;">@TempData["Error"]</p>
            }
            else if (!string.IsNullOrEmpty(ViewBag.Message))
            {
                <p class="mb-0 text-dark small" style="line-height: 1.4;">@ViewBag.Message</p>
            }
            else
            {
                <p class="mb-0 text-dark small" style="line-height: 1.4;">Không thể xác thực giao dịch chuyển khoản hoặc người dùng đã hủy giao dịch.</p>
            }
        </div>

        <p class="text-muted small">Bạn có thể truy cập lịch sử đặt vé để thực hiện thanh toán lại hoặc liên hệ với bộ phận hỗ trợ khách hàng của CineZone.</p>

        <!-- ACTIONS BUTTONS -->
        <div class="mt-5 d-flex gap-2 justify-content-center">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-pill-action px-4">
                <i class="bi bi-house-door me-1"></i> Trang chủ
            </a>
            <a asp-controller="Tickets" asp-action="MyTickets" class="btn btn-danger btn-pill-action px-4 shadow-sm">
                <i class="bi bi-ticket-perforated me-1"></i> Vé của tôi
            </a>
        </div>

    </div>
</div>