@model CINEMA.Models.WorkSchedule
@{
    ViewData["Title"] = "Phân ca làm việc hàng loạt";
    Layout = "_AdminLayout";
    var shifts = ViewBag.Shifts as List<CINEMA.Models.Shift>;
}

<div class="container-fluid">
    <div class="mb-4">
        <h3>Phân ca làm việc theo tháng</h3>
    </div>

    <form asp-action="Create" method="post" id="scheduleForm">
        <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

        <div class="row mb-4">
            <!-- Chọn nhân viên -->
            <div class="col-md-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h5 class="card-title text-primary mb-3">1. Thông tin chung</h5>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Nhân viên <span class="text-danger">*</span></label>
                            <select name="AdminId" class="form-select" asp-items="ViewBag.AdminId" required>
                                <option value="">-- Chọn nhân viên --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn Tháng/Năm <span class="text-danger">*</span></label>
                            <input type="month" id="MonthYear" class="form-control" value="@DateTime.Now.ToString("yyyy-MM")" required onchange="generateTable()" />
                        </div>

                        <div class="alert alert-info mt-4" style="font-size: 0.85rem;">
                            <i class="bi bi-info-circle me-1"></i>
                            Chọn tháng xong, bảng danh sách ngày sẽ tự động cập nhật bên phải. Hãy tích vào các ca muốn phân công.
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lưới chọn ngày và ca -->
            <div class="col-md-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title text-success mb-0">2. Lịch làm việc trong tháng</h5>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="checkAll()">
                                <i class="bi bi-check-all"></i> Chọn / Bỏ chọn tất cả
                            </button>
                        </div>

                        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                            <table class="table table-bordered table-hover schedule-matrix">
                                <thead class="table-light position-sticky top-0" style="z-index: 1;">
                                    <tr class="text-center align-middle">
                                        <th style="width: 150px;">Ngày</th>
                                        @foreach (var shift in shifts)
                                        {
                                            <th>
                                                <div>@shift.ShiftName</div>
                                                <div class="text-muted fw-normal" style="font-size: 0.75rem;">
                                                    @shift.StartTime.ToString(@"hh\:mm") - @shift.EndTime.ToString(@"hh\:mm")
                                                </div>
                                            </th>
                                        }
                                    </tr>
                                </thead>
                                <tbody id="scheduleBody">
                                    <!-- Javascript sẽ đổ dữ liệu vào đây -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3 d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i> Lưu toàn bộ lịch
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        window.DutyScheduleConfig = {
            shiftList: [
                @foreach (var s in shifts)
                {
                    @Html.Raw($"{{ id: '{s.ShiftId}', name: '{s.ShiftName}' }},")
                }
            ]
        };
    </script>
    <script src="~/js/pages/dutyschedule/create.js" asp-append-version="true"></script>
}