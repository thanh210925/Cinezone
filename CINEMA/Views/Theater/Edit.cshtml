@model CINEMA.Models.Theater
@{
    ViewData["Title"] = "Chỉnh sửa rạp";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/theater-management.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-xl-10">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-white border-bottom-0 pt-4 pb-2 px-4 d-flex align-items-center">
                    <div class="icon-shape bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                        <i class="bi bi-pencil-square fs-5"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold text-dark mb-0">Chỉnh sửa rạp chiếu</h4>
                        <small class="text-muted">Cập nhật thông tin chi tiết của rạp</small>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="TheaterId" />

                        <div class="row g-4 mb-4">

                            <div class="col-md-6">
                                <div class="form-section p-4 h-100 rounded-3 bg-light border border-light-subtle">
                                    <h6 class="fw-bold mb-4 text-secondary text-uppercase" style="letter-spacing: 0.5px;">
                                        Thông tin cơ bản
                                    </h6>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-dark">Tên rạp <span class="text-danger">*</span></label>
                                        <input asp-for="Name" class="form-control custom-input" required />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-dark">Điện thoại</label>
                                        <input asp-for="Phone" class="form-control custom-input" />
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-section p-4 h-100 rounded-3 bg-light border border-light-subtle">
                                    <h6 class="fw-bold mb-4 text-secondary text-uppercase" style="letter-spacing: 0.5px;">
                                        Vị trí & Trạng thái
                                    </h6>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-dark">Địa chỉ</label>
                                        <input asp-for="Address" class="form-control custom-input" />
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-dark">Google Map URL</label>
                                        <input asp-for="GoogleMapUrl" class="form-control custom-input" />
                                    </div>

                                    <div class="form-check form-switch mt-4 ms-1">
                                        <input asp-for="IsActive" class="form-check-input fs-5 shadow-none cursor-pointer" id="IsActiveSwitch" />
                                        <label class="form-check-label fw-semibold text-dark ms-2 mt-1 cursor-pointer" for="IsActiveSwitch">Hoạt động</label>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <div class="d-flex gap-3 pt-3 border-top">
                            <button type="submit" class="btn btn-warning btn-lg px-5 fw-bold text-dark custom-btn shadow-sm">
                                <i class="bi bi-save me-2"></i> Cập nhật
                            </button>
                            <a asp-action="Index" class="btn btn-light btn-lg px-4 fw-medium text-secondary custom-btn-outline border">
                                Quay lại
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>