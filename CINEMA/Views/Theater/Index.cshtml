@model IEnumerable<CINEMA.Models.Theater>
@{
    ViewData["Title"] = "Danh sách rạp chiếu";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/theater-management.css" asp-append-version="true" />
}

<div class="container-fluid mt-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Quản lý rạp chiếu</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white border-bottom-0 pt-4 pb-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <h4 class="fw-bold text-primary mb-0 d-flex align-items-center">
                <i class="bi bi-camera-reels-fill me-2 fs-3 text-primary"></i>
                Danh sách rạp chiếu
            </h4>
            <a class="btn btn-primary btn-add rounded-pill px-4 shadow-sm" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i> Thêm rạp mới
            </a>
        </div>

        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table mb-0">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th class="ps-4" width="8%">STT</th>
                                <th width="25%">Tên rạp</th>
                                <th width="25%">Địa chỉ</th>
                                <th width="12%">Điện thoại</th>
                                <th width="15%">Trạng thái</th>
                                <th class="text-center pe-4" width="15%">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }
                            @foreach (var t in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-medium text-muted">@stt</td>
                                    <td class="fw-bold text-dark">@t.Name</td>
                                    <td class="text-muted text-truncate" style="max-width: 200px;" title="@t.Address">
                                        @t.Address
                                    </td>
                                    <td>@t.Phone</td>
                                    <td>
                                        @if (t.IsActive == true)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                                <i class="bi bi-check-circle me-1"></i> Hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-2">
                                                <i class="bi bi-pause-circle me-1"></i> Tạm dừng
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Edit" asp-route-id="@t.TheaterId" class="btn btn-light btn-sm text-primary action-btn" data-bs-toggle="tooltip" title="Chỉnh sửa">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@t.TheaterId" class="btn btn-light btn-sm text-danger action-btn" data-bs-toggle="tooltip" title="Xóa">
                                                <i class="bi bi-trash3"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-inbox text-muted opacity-50" style="font-size: 4rem;"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Chưa có rạp chiếu nào!</h5>
                    <p class="text-muted mb-4">Bạn chưa thêm rạp chiếu nào vào hệ thống. Hãy bắt đầu ngay.</p>
                    <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Create">
                        <i class="bi bi-plus-lg me-1"></i> Thêm rạp đầu tiên
                    </a>
                </div>
            }
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="card-footer bg-white border-top text-muted text-end py-3 px-4" style="font-size: 0.85rem;">
                Hiển thị tổng cộng <strong>@Model.Count()</strong> rạp chiếu
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/theater/index.js" asp-append-version="true"></script>
}