@model IEnumerable<CINEMA.Models.Movie>

<div class="container mt-5 mb-5">
    <div class="d-flex align-items-center mb-4">
        <div class="bg-danger" style="width: 5px; margin-right: 15px;"></div>
        <h2 class="fw-bold m-0">Thể loại: <span class="text-danger">@ViewBag.GenreName</span></h2>
    </div>

    <div class="row g-4">
        @if (Model.Any()) {
            @foreach (var movie in Model) {
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="movie-card-modern h-100 shadow-sm">
                        <div class="poster-wrapper">
                            <img src="@movie.PosterUrl" class="img-fluid" alt="@movie.Title">
                            <div class="overlay p-2 text-center">
                                <div class="d-flex flex-column gap-2 w-75">
                                    <a asp-controller="Home" asp-action="MovieDetails" asp-route-id="@movie.MovieId" 
                                       class="btn btn-sm btn-light rounded-pill px-3 fw-bold">Chi tiết</a>
                                    <a asp-controller="Home" asp-action="BookTicket" asp-route-id="@movie.MovieId" 
                                       class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold">Đặt vé</a>
                                </div>
                            </div>
                        </div>
                        <div class="info-wrapper p-3">
                            <h5 class="fw-bold mb-1 text-truncate" title="@movie.Title">@movie.Title</h5>
                            <div class="d-flex justify-content-between align-items-center text-muted small">
                                <span><i class="bi bi-clock me-1"></i> @movie.Duration'</span>
                                <span class="badge bg-light text-dark border">@movie.AgeRating</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        } else {
            <div class="text-center py-5">
                <i class="bi bi-film display-1 text-muted"></i>
                <p class="mt-3 text-muted">Hiện chưa có phim nào thuộc thể loại này.</p>
            </div>
        }
    </div>
</div>

<style>
    body{
        margin-top: 0;
        padding-top: 0
    }
    /* Styling hiện đại */
    .movie-card-modern {
        border-radius: 12px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: #fff;
        overflow: hidden;
    }
    .movie-card-modern:hover {
        transform: translateY(-8px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }
    .poster-wrapper {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }
    .poster-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .movie-card-modern:hover .poster-wrapper img {
        transform: scale(1.08);
    }
    .overlay {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(220, 53, 69, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    .movie-card-modern:hover .overlay {
        opacity: 1;
    }
    .info-wrapper {
        background: #fff;
    }
   
</style>