@model IEnumerable<CINEMA.Models.Movie>

@{
    ViewData["Title"] = "Kết quả tìm kiếm";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home/search.css" asp-append-version="true" />
}

<div class="container mb-5" style="padding-top: 100px !important;">

    <div class="search-banner">
        <h2>KẾT QUẢ TÌM KIẾM</h2>

        <p class="result-count">
            Từ khóa:
            <strong>"@ViewBag.Keyword"</strong>
        </p>

        @if (Model.Any())
        {
            <p class="mb-0 mt-2">
                Tìm thấy <strong>@Model.Count()</strong> phim phù hợp
            </p>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">
                🎬
            </div>

            <h3 class="mt-3">
                Không tìm thấy phim phù hợp
            </h3>

            <p class="text-muted mt-2">
                Hãy thử từ khóa khác hoặc khám phá những bộ phim đang được yêu thích.
            </p>

        </div>

        var suggestions = ViewBag.SuggestMovies as List<CINEMA.Models.Movie>;

        @if (suggestions != null && suggestions.Any())
        {
            <div class="d-flex align-items-center mb-3">
                <h3 class="suggest-title mb-0 d-flex align-items-center">
                    <i class="bi bi-robot fs-4 me-2 text-warning"></i> Gợi ý thông minh từ AI
                </h3>
            </div>

            @if (ViewBag.AIRecommendationReason != null)
            {
                <div class="alert alert-info border-0 shadow-sm rounded-4 p-3 mb-4 d-flex align-items-center" style="background: rgba(13, 110, 253, 0.05); border-left: 4px solid #0d6efd !important;">
                    <i class="bi bi-lightbulb-fill text-warning fs-5 me-3"></i>
                    <span class="fw-medium text-dark">@ViewBag.AIRecommendationReason</span>
                </div>
            }

            <div class="row">
                @foreach (var movie in suggestions)
                {
                    <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

                        <div class="card movie-card">

                            <div class="poster-wrapper">

                                <span class="badge bg-success movie-badge">
                                    Đang chiếu
                                </span>

                                <img src="@movie.PosterUrl"
                                     class="card-img-top movie-poster"
                                     alt="@movie.Title" />

                            </div>

                            <div class="card-body text-center">

                                <div class="movie-title">
                                    @movie.Title
                                </div>

                                <div class="d-flex justify-content-center gap-2 mt-3">
                                    <a asp-action="MovieDetails"
                                       asp-route-id="@movie.MovieId"
                                       class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill fw-semibold">
                                        🔍 Chi tiết
                                    </a>
                                    <a asp-action="BookTicket"
                                       asp-route-id="@movie.MovieId"
                                       class="btn btn-sm btn-danger px-3 py-2 rounded-pill fw-semibold">
                                        🎟 Đặt vé
                                    </a>
                                </div>

                            </div>

                        </div>

                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="row">

            @foreach (var movie in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

                    <div class="card movie-card">

                        <div class="poster-wrapper">

                            <span class="badge bg-success movie-badge">
                                Đang chiếu
                            </span>

                            <img src="@movie.PosterUrl"
                                 class="card-img-top movie-poster"
                                 alt="@movie.Title" />

                        </div>

                        <div class="card-body text-center">

                            <div class="movie-title">
                                @movie.Title
                            </div>

                            <div class="d-flex justify-content-center gap-2 mt-3">
                                <a asp-action="MovieDetails"
                                   asp-route-id="@movie.MovieId"
                                   class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill fw-semibold">
                                    🔍 Chi tiết
                                </a>
                                <a asp-action="BookTicket"
                                   asp-route-id="@movie.MovieId"
                                   class="btn btn-sm btn-danger px-3 py-2 rounded-pill fw-semibold">
                                    🎟 Đặt vé
                                </a>
                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
