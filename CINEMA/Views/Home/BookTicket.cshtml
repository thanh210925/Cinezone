@model CINEMA.Models.Movie
@{
    ViewData["Title"] = "CineZone - Đặt vé";
    var showtime = ViewBag.Showtime as CINEMA.Models.Showtime;
    var showtimes = ViewBag.Showtimes as List<CINEMA.Models.Showtime> ?? new List<CINEMA.Models.Showtime>();
    var combos = ViewBag.Combos as List<CINEMA.Services.ComboRecommendation>;
    var bookedSeats = ViewBag.BookedSeats as List<string> ?? new List<string>();
    var basePrice = showtime?.BasePrice ?? 0m;

    var seats = ViewBag.Seats as List<CINEMA.Models.Seat> ?? new List<CINEMA.Models.Seat>();
    var seatGroups = seats.GroupBy(s => s.RowLabel);
}

<div class="bookticket-container py-4" style="padding-top: 100px !important;">
    <div class="container-fluid px-lg-5 px-3">

        <!-- 🎬 TOP BANNER: Phim & Chọn suất chiếu -->
        <div class="movie-header-card mb-3">
            <div class="row g-3 align-items-center">
                <!-- LEFTSIDE: Poster Phim & Chi tiết -->
                <div class="col-lg-7">
                    <div class="d-flex flex-column flex-md-row gap-3 align-items-start">
                        <img src="@Model.PosterUrl" class="rounded-3 shadow-sm border" alt="@Model.Title" style="width: 110px; height: 160px; object-fit: cover; flex-shrink: 0;" />
                        <div class="flex-grow-1">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <span class="badge bg-danger px-2.5 py-1 text-white fw-bold" style="font-size: 0.75rem;">@Model.AgeRating</span>
                                <span class="text-muted small">
                                    <i class="bi bi-film me-1"></i>
                                    @(Model.Genres != null && Model.Genres.Any() ? string.Join(", ", Model.Genres.Select(g => g.Name)) : "Đang cập nhật")
                                </span>
                                <span class="text-muted small"><i class="bi bi-globe me-1"></i> @(string.IsNullOrEmpty(Model.Country) ? "Nhật Bản" : Model.Country)</span>
                                <span class="text-muted small"><i class="bi bi-clock me-1"></i> @Model.Duration phút</span>
                            </div>

                            <h2 class="fw-bold text-dark mb-2" style="font-size: 1.6rem; letter-spacing: -0.5px;">@Model.Title</h2>
                            <p class="text-muted small mb-3 line-clamp-2" style="line-height: 1.5;">
                                @Model.Description
                            </p>

                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(Model.TrailerUrl))
                                {
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill fw-bold px-3 py-1.5" data-bs-toggle="modal" data-bs-target="#trailerModal" data-trailer="@Model.TrailerUrl" data-title="@Model.Title" style="font-size: 0.82rem;">
                                        <i class="bi bi-play-circle-fill me-1"></i> Xem Trailer
                                    </button>
                                }

                                <div class="d-flex align-items-center gap-2 flex-wrap ms-md-2">
                                    <span class="share-title"><i class="bi bi-share-fill text-muted me-1"></i> Chia sẻ:</span>
                                    <a href="#" onclick="shareFacebook(window.location.href); return false;" class="btn-share-custom btn-share-facebook">
                                        <i class="bi bi-facebook"></i>
                                    </a>
                                    <button type="button" onclick="copyShareLink(this)" class="btn-share-custom btn-share-messenger">
                                        <i class="bi bi-messenger"></i>
                                    </button>
                                    <button type="button" onclick="copyShareLink(this)" class="btn-share-custom btn-share-zalo">
                                        <i class="bi bi-chat-dots"></i>
                                    </button>
                                    <button type="button" onclick="copyShareLink(this)" class="btn-share-custom btn-share-tiktok">
                                        <i class="bi bi-link-45deg"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- RIGHTSIDE: Chọn Lịch Chiếu (Showtimes List) -->
                <div class="col-lg-5 border-start border-slate-200 ps-lg-4">
                    <h6 class="text-uppercase fw-bold text-dark small tracking-wider mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-geo-alt-fill text-danger"></i> CHỌN LỊCH CHIẾU
                    </h6>

                    @if (showtimes.Any())
                    {
                        var theaters = showtimes.Select(s => s.Auditorium.Theater).Distinct().ToList();
                        <div class="d-flex flex-column gap-3 overflow-auto pr-1" style="max-height: 210px;">
                            @foreach (var theater in theaters)
                            {
                                <div>
                                    <div class="text-dark small fw-bold mb-1 d-flex align-items-center gap-1" style="font-size: 0.8rem;">
                                        <i class="bi bi-building me-1 text-primary"></i> @theater.Name
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var s in showtimes.Where(st => st.Auditorium.TheaterId == theater.TheaterId).OrderBy(st => st.StartTime))
                                        {
                                            bool isActive = showtime != null && s.ShowtimeId == showtime.ShowtimeId;
                                            <a asp-controller="Home" asp-action="BookTicket"
                                               asp-route-id="@Model.MovieId"
                                               asp-route-showtimeId="@s.ShowtimeId"
                                               class="btn btn-sm rounded-3 font-mono fw-bold transition-all @(isActive ? "btn-primary text-white shadow-sm" : "btn-outline-secondary")"
                                               style="min-width: 65px; font-size: 0.82rem; padding: 4px 10px;">
                                                @s.StartTime?.ToString("HH:mm")
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning py-2 small mb-0"><i class="bi bi-exclamation-triangle me-2"></i>Hiện tại chưa có lịch chiếu.</div>
                    }
                </div>
            </div>
        </div>


        <!-- CHỈ HIỂN THỊ FORM KHI ĐÃ CHỌN SUẤT CHIẾU -->
        @if (showtime != null)
        {
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- ELEGANT STEPPER NAVIGATION BAR -->
            <div class="wizard-stepper-bar">
                <div class="wizard-step-pill active">
                    <span class="wizard-step-num">1</span>
                    <span>CHỌN VÉ</span>
                </div>
                <div class="wizard-step-divider"></div>
                <div class="wizard-step-pill active">
                    <span class="wizard-step-num">2</span>
                    <span>CHỌN GHẾ</span>
                </div>
                <div class="wizard-step-divider"></div>
                <div class="wizard-step-pill active">
                    <span class="wizard-step-num">3</span>
                    <span>BẮP & NƯỚC</span>
                </div>
            </div>

            <form id="bookingForm" asp-controller="Payment" asp-action="Index" method="post" onsubmit="return validateForm()">
                <input type="hidden" id="selectedSeats" name="selectedSeats" />
                <input type="hidden" name="MovieId" value="@Model.MovieId" />
                <input type="hidden" name="ShowtimeId" value="@showtime.ShowtimeId" />
                <input type="hidden" id="basePrice" name="BasePrice" value="@basePrice" />
                <input type="hidden" id="TotalPriceHidden" name="TotalPrice" value="0" />

                <div class="row g-4">
                    <!-- LEFT COLUMN: TICKET TYPES + SEATS MATRIX + COMBOS -->
                    <div class="col-lg-8">

                        <!-- STEP 1: CHỌN LOẠI VÉ -->
                        <div class="light-panel-card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h5 class="light-panel-title">
                                    <i class="bi bi-ticket-perforated-fill text-primary"></i> CHỌN LOẠI VÉ
                                </h5>
                                <span class="text-muted small">Tối đa 10 vé / đơn hàng</span>
                            </div>
                            <div class="p-4">
                                <div class="row g-3">
                                    <!-- Người lớn -->
                                    <div class="col-md-4">
                                        <div class="ticket-type-card">
                                            <div class="ticket-type-title">NGƯỜI LỚN</div>
                                            <div class="ticket-type-price">@basePrice.ToString("N0")đ</div>
                                            <div class="ticket-counter-box">
                                                <button type="button" class="btn-counter" onclick="changeInputQty('AdultTickets', -1)">-</button>
                                                <input type="number" class="ticket-input ticket-input-display" name="AdultTickets" min="0" value="0" readonly />
                                                <button type="button" class="btn-counter" onclick="changeInputQty('AdultTickets', 1)">+</button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Trẻ em -->
                                    <div class="col-md-4">
                                        <div class="ticket-type-card">
                                            <div class="ticket-type-title">TRẺ EM</div>
                                            <div class="ticket-type-price">@(decimal.Multiply(basePrice, 0.7m).ToString("N0"))đ</div>
                                            <div class="ticket-counter-box">
                                                <button type="button" class="btn-counter" onclick="changeInputQty('ChildTickets', -1)">-</button>
                                                <input type="number" class="ticket-input ticket-input-display" name="ChildTickets" min="0" value="0" readonly />
                                                <button type="button" class="btn-counter" onclick="changeInputQty('ChildTickets', 1)">+</button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Học sinh / SV -->
                                    <div class="col-md-4">
                                        <div class="ticket-type-card">
                                            <div class="ticket-type-title">HỌC SINH / SV</div>
                                            <div class="ticket-type-price">@(decimal.Multiply(basePrice, 0.8m).ToString("N0"))đ</div>
                                            <div class="ticket-counter-box">
                                                <button type="button" class="btn-counter" onclick="changeInputQty('StudentTickets', -1)">-</button>
                                                <input type="number" class="ticket-input ticket-input-display" name="StudentTickets" min="0" value="0" readonly />
                                                <button type="button" class="btn-counter" onclick="changeInputQty('StudentTickets', 1)">+</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- STEP 2: CHỌN GHẾ NGỒI -->
                        <div class="light-panel-card">
                            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <h5 class="light-panel-title">
                                    <i class="bi bi-grid-3x3-gap-fill text-danger"></i> CHỌN GHẾ NGỒI
                                </h5>
                                <button type="button" id="btnAutoPickBestSeats" class="btn btn-warning btn-sm fw-bold rounded-pill px-3 shadow-sm text-dark" onclick="autoPickBestSeats()">
                                    <i class="bi bi-magic me-1"></i> ✨ Gợi ý ghế đẹp nhất
                                </button>
                            </div>

                            <div class="p-4">
                                <!-- Curved Screen Indicator -->
                                <div class="cinema-screen-container">
                                    <div class="cinema-screen-arc"></div>
                                    <div class="screen-label">MÀN HÌNH</div>
                                </div>

                                <!-- Seat Matrix Layout -->
                                <div class="d-flex flex-column align-items-center mb-4">
                                    @{
                                        int maxCol = seats.Any() ? seats.Max(s => s.SeatNumber ?? 0) : 0;
                                    }
                                    @foreach (var group in seatGroups)
                                    {
                                        <div class="d-flex justify-content-center align-items-center mb-2 gap-1.5 flex-wrap">
                                            <span class="fw-extrabold text-muted me-3 text-center" style="width: 22px; font-size: 0.9rem;">@group.Key</span>
                                            @for (int col = 1; col <= maxCol; col++)
                                            {
                                                var seat = group.FirstOrDefault(s => s.SeatNumber == col);
                                                if (seat != null)
                                                {
                                                    string seatCode = $"{seat.RowLabel}{seat.SeatNumber}";
                                                    bool isBooked = bookedSeats.Contains(seatCode);
                                                    decimal surcharge = 0m;
                                                    string typeClass = "";
                                                    string icon = "";

                                                    if (seat.SeatType == "VIP")
                                                    {
                                                        surcharge = 30000m;
                                                        typeClass = "seat-vip";
                                                    }
                                                    else if (seat.SeatType == "Couple")
                                                    {
                                                        surcharge = 100000m;
                                                        typeClass = "seat-couple";
                                                        icon = "<i class=\"bi bi-heart-fill small\"></i>";
                                                    }
                                                    else if (seat.SeatType == "Disabled")
                                                    {
                                                        typeClass = "seat-disabled";
                                                        icon = "<i class=\"bi bi-person-badge-fill small\"></i>";
                                                    }

                                                    <label class="seat-wrapper @(isBooked ? "disabled-seat" : "")" title="@seatCode - @seat.SeatType @(surcharge > 0 ? $"(+{surcharge:N0}đ)" : "")">
                                                        @if (isBooked)
                                                        {
                                                            <input type="checkbox" class="seat-checkbox" value="@seatCode" disabled style="display:none !important;" />
                                                        }
                                                        else
                                                        {
                                                            <input type="checkbox" class="seat-checkbox" value="@seatCode" data-surcharge="@surcharge" style="display:none !important;" />
                                                        }
                                                        <span class="seat-badge @typeClass @(isBooked ? "bg-secondary opacity-25 text-white-50" : "")">
                                                            @if (isBooked)
                                                            {
                                                                <i class="bi bi-x-lg text-secondary"></i>
                                                            }
                                                            else if (!string.IsNullOrEmpty(icon))
                                                            {
                                                                @Html.Raw(icon)
                                                            }
                                                            else
                                                            {
                                                                @seat.SeatNumber
                                                            }
                                                        </span>
                                                    </label>
                                                }
                                                else
                                                {
                                                    <div class="seat-empty-spacer" style="width: 36px; height: 36px; display: inline-block;"></div>
                                                }
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Seat Legend Bar -->
                                <div class="seat-legend-bar">
                                    <div class="legend-item">
                                        <div class="legend-box" style="background:#f1f5f9;"></div> <span>Thường</span>
                                    </div>
                                    <div class="legend-item">
                                        <div class="legend-box seat-vip"></div> <span>VIP (+30K)</span>
                                    </div>
                                    <div class="legend-item">
                                        <div class="legend-box seat-couple"></div> <span>Couple (+100K)</span>
                                    </div>
                                    <div class="legend-item">
                                        <div class="legend-box seat-disabled"></div> <span>Khuyết tật</span>
                                    </div>
                                    <div class="legend-item">
                                        <div class="legend-box" style="background:#22c55e;"></div> <span>Đã chọn</span>
                                    </div>
                                    <div class="legend-item">
                                        <div class="legend-box" style="background:#fef08a;"></div> <span>Đang chọn</span>
                                    </div>
                                    <div class="legend-item">
                                        <div class="legend-box opacity-50" style="background:#cbd5e1;"></div> <span>Đã bán</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- STEP 3: BẮP & NƯỚC -->
                        <div class="light-panel-card">
                            <div class="card-header">
                                <h5 class="light-panel-title">
                                    <i class="bi bi-cup-straw text-warning"></i> BẮP & NƯỚC
                                </h5>
                            </div>
                            <div class="p-4">
                                @if (combos != null && combos.Any())
                                {
                                    <div class="row g-3">
                                        @foreach (var rec in combos)
                                        {
                                            var combo = rec.Combo;
                                            <div class="col-md-6">
                                                <div class="combo-card-light h-100">
                                                    @if (!string.IsNullOrEmpty(combo.ImageUrl))
                                                    {
                                                        <img src="@combo.ImageUrl" class="combo-img-box" alt="@combo.Name" />
                                                    }
                                                    <div class="flex-grow-1">
                                                        <h6 class="fw-bold text-dark mb-1">@combo.Name</h6>
                                                        <p class="text-muted small mb-2 line-clamp-1" style="font-size:0.78rem;">@combo.Description</p>
                                                        <div class="combo-price-text">@combo.Price?.ToString("N0")đ</div>
                                                    </div>
                                                    <div class="ticket-counter-box">
                                                        <button type="button" class="btn-counter" onclick="changeComboQty('Combo_@combo.ComboId', -1)">-</button>
                                                        <input type="number" class="combo-input ticket-input-display" name="Combo_@combo.ComboId" min="0" value="0" data-price="@combo.Price" readonly />
                                                        <button type="button" class="btn-counter" onclick="changeComboQty('Combo_@combo.ComboId', 1)">+</button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0">Không có combo bắp nước khả dụng.</p>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT COLUMN: ORDER SUMMARY SIDEBAR -->
                    <div class="col-lg-4">
                        <div class="position-sticky" style="top: 100px;">
                            <div class="order-summary-card">
                                <div class="order-summary-header text-center">
                                    <h5 class="summary-title">THÔNG TIN ĐƠN HÀNG</h5>
                                </div>
                                <div class="p-4">
                                    <!-- Movie Info Box -->
                                    <div class="d-flex gap-3 align-items-center summary-movie-info mb-4">
                                        <img src="@Model.PosterUrl" class="rounded-3" style="width: 54px; height: 74px; object-fit: cover;" />
                                        <div>
                                            <div class="fw-extrabold text-dark mb-1" style="font-size: 0.95rem;">@Model.Title</div>
                                            <div class="text-muted small" style="font-size: 0.8rem;">
                                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @showtime.Auditorium?.Theater?.Name <br />
                                                <i class="bi bi-door-open-fill text-primary me-1"></i> Phòng: @showtime.Auditorium?.Name <br />
                                                <i class="bi bi-clock-fill text-warning me-1"></i> @showtime.StartTime?.ToString("HH:mm - dd/MM/yyyy")
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Selected Seats Badges -->
                                    <div class="mb-4">
                                        <div class="text-muted small font-bold text-uppercase tracking-wider mb-2">GHẾ ĐÃ CHỌN</div>
                                        <div id="displaySelectedSeats" class="d-flex flex-wrap gap-2">
                                            <span class="text-muted small">Chưa chọn ghế</span>
                                        </div>
                                    </div>

                                    <hr class="my-3" />

                                    <!-- Price Details -->
                                    <div class="d-flex justify-content-between align-items-center mb-4 summary-total-box">
                                        <div>
                                            <div class="text-muted small fw-bold text-uppercase">TỔNG TIỀN</div>
                                            <div class="summary-total-price"><span id="totalPrice">0</span>đ</div>
                                        </div>
                                    </div>

                                    <!-- Countdown Holding Timer -->
                                    <div class="timer-holding-badge mb-3">
                                        ⏱ Thời gian giữ vé: <span id="countdown" class="fw-bold text-danger">10:00</span>
                                    </div>

                                    <!-- Action Buttons -->
                                    <button type="submit" class="btn btn-pay-gradient mb-3">
                                        THANH TOÁN <i class="bi bi-arrow-right ms-1"></i>
                                    </button>

                                    <button type="button" onclick="event.preventDefault(); document.getElementById('groupBookingCreateForm').submit();" class="btn btn-invite-outline">
                                        👥 RỦ BẠN ĐI CÙNG
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>

            <form id="groupBookingCreateForm" action="/GroupBooking/Create" method="post" style="display: none;">
                <input type="hidden" name="showtimeId" value="@showtime.ShowtimeId" />
            </form>
        }

    </div>
</div>

<!-- Modal Xem Trailer -->
<div class="modal fade" id="trailerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title text-white" id="trailerModalTitle">Trailer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 ratio ratio-16x9">
                <iframe id="trailerIframe" src="" allowfullscreen allow="autoplay"></iframe>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/home/bookticket.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        function changeInputQty(inputName, delta) {
            const el = document.getElementsByName(inputName)[0];
            if (!el) return;
            let val = parseInt(el.value) || 0;
            val = Math.max(0, val + delta);
            el.value = val;
            el.dispatchEvent(new Event('input'));
        }

        function changeComboQty(inputName, delta) {
            const el = document.getElementsByName(inputName)[0];
            if (!el) return;
            let val = parseInt(el.value) || 0;
            val = Math.max(0, val + delta);
            el.value = val;
            el.dispatchEvent(new Event('input'));
        }
    </script>
    <script src="~/js/pages/home/bookticket.js" asp-append-version="true"></script>
}