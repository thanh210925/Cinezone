@* <!-- THEATER LOCATIONS --> *@
<section class="theater-section mt-5 mb-5">
    <div class="container">

        <div class="section-header mb-5">
            <h2 class="section-title text-center fw-bold">
                <i class="bi bi-geo-alt"></i> HỆ THỐNG RẠP CINEZONE
            </h2>
            <p class="text-center text-muted">Chọn rạp để xem vị trí trên bản đồ</p>
            <div class="title-underline"></div>
        </div>

        @{
            var theaters = ViewBag.Theaters as List<CINEMA.Models.Theater>;
            var firstTheater = theaters?.FirstOrDefault();

            string defaultMap =
                firstTheater != null
                ? $"https://maps.google.com/maps?q={Uri.EscapeDataString(firstTheater.Address ?? "")}&output=embed"
                : "https://maps.google.com/maps?q=Ho%20Chi%20Minh&output=embed";
        }

        <!-- Theater List -->
        <div class="row mb-5">

            @foreach (var theater in ViewBag.Theaters)
            {
                <div class="col-md-6 col-lg-4 mb-3">

                    <div class="theater-card h-100 p-4 rounded-3 shadow-sm cursor-pointer"
                         onclick="changeMap('@theater.Address', this)">

                        <h5 class="fw-bold mb-3 theater-name">
                            <i class="bi bi-building"></i> @theater.Name
                        </h5>

                        <div class="theater-info mb-2">
                            <p class="mb-2">
                                <i class="bi bi-geo-alt-fill text-primary"></i>
                                <span class="ms-2">@theater.Address</span>
                            </p>
                        </div>

                        <small class="text-muted">
                            <i class="bi bi-telephone-fill"></i>
                            <span class="ms-2">@theater.Phone</span>
                        </small>

                    </div>

                </div>
            }

        </div>

        <!-- Map -->
        <div class="map-container rounded-3 overflow-hidden shadow-md">

            <iframe id="theaterMap"
                    src="@defaultMap"
                    width="100%"
                    height="550"
                    style="border: none;"
                    loading="lazy">
            </iframe>

        </div>

    </div>
</section>

@* <!-- SCRIPTS --> *@
@section Scripts{
<script>
document.addEventListener("DOMContentLoaded", function () {

    // =========================
    // Popup
    // =========================
    const firstCard = document.querySelector(".theater-card");
    if (firstCard)
        firstCard.classList.add("active");

    const popupElement = document.getElementById("promoPopup");

    if (popupElement) {

        const popup = new bootstrap.Modal(popupElement);

        if (!sessionStorage.getItem("popupShown")) {

            setTimeout(() => popup.show(), 1000);

            sessionStorage.setItem("popupShown", "true");
        }
    }

    // =========================
    // Gợi ý phim
    // =========================

    const list = document.getElementById("recommendList");

    if (list) {

        list.innerHTML = "";

        const movieIds = new Set();

        const popularMovies = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                popularMovies.Select(x => new
                {
                    movieId = x.MovieId,
                    title = x.Title,
                    posterUrl = x.PosterUrl,
                    ageRating = x.AgeRating,
                    duration = x.Duration
                })
            )
        );

               // Khởi tạo Swiper (Đặt ngay trên cùng của thẻ script)
               var swiper = new Swiper(".popularSwiper", {
            slidesPerView: "auto",
            centeredSlides: true,
            loop: true,
            spaceBetween: 30
        });

            function renderMovie(movie) {
            const slide = document.createElement("div");
            slide.className = "swiper-slide";

            // Đảm bảo dữ liệu không bị undefined
            const ageRating = movie.ageRating || "P";
            const duration = movie.duration || 0;

                    slide.innerHTML = `
        <div class="movie-card shadow-lg border rounded-4 overflow-hidden">

            <div class="movie-poster-container">

                <img src="${movie.posterUrl}"
                     class="w-100"
                     style="height:400px; object-fit:cover;">

                <div class="movie-overlay">

                    <div class="overlay-content text-center">

                        <div class="movie-meta mb-3">
                            <span class="badge bg-secondary me-2">${ageRating}</span>
                            <span class="text-white">${duration} phút</span>
                        </div>

                        <a href="/Home/BookTicket/${movie.movieId}"
                           class="btn btn-danger rounded-pill px-4">
                            Đặt vé
                        </a>

                    </div>

                </div>

            </div>

            <div class="p-3 bg-white text-center">
                <h5 class="fw-bold text-truncate mb-0">${movie.title}</h5>
            </div>

        </div>`;
            swiper.appendSlide(slide);
        }
        // Hiển thị phim được xem nhiều trước
        popularMovies.forEach(movie => {

            movieIds.add(movie.movieId);

            renderMovie(movie);

        });

        // Sau đó thêm phim gợi ý
        fetch("/Home/Recommend")
            .then(res => res.json())
            .then(data => {

                if (!data)
                    return;

                data.forEach(movie => {

                    if (movieIds.has(movie.movieId))
                        return;

                    movieIds.add(movie.movieId);

                    renderMovie(movie);

                });

            })
            .catch(err => console.log(err));

    }

    // =========================
    // Đặt vé nhanh
    // =========================

    const theaterSelect = document.getElementById("theaterSelect");
    const movieSelect = document.getElementById("movieSelect");
    const dateSelect = document.getElementById("dateSelect");
    const showtimeSelect = document.getElementById("showtimeSelect");

    theaterSelect.addEventListener("change", function () {

        const theaterId = this.value;

        movieSelect.innerHTML = '<option selected disabled>-- Chọn phim --</option>';
        dateSelect.innerHTML = '<option selected disabled>-- Chọn ngày --</option>';
        showtimeSelect.innerHTML = '<option selected disabled>-- Chọn suất chiếu --</option>';

        fetch(`/Home/GetMoviesByTheater?theaterId=${theaterId}`)
            .then(res => res.json())
            .then(data => {

                data.forEach(m => {

                    const opt = document.createElement("option");

                    opt.value = m.movieId;
                    opt.textContent = m.title;

                    movieSelect.appendChild(opt);

                });

            });

    });

    movieSelect.addEventListener("change", function () {

        const theaterId = theaterSelect.value;
        const movieId = this.value;

        dateSelect.innerHTML = '<option selected disabled>-- Chọn ngày --</option>';

        fetch(`/Home/GetShowtimes?theaterId=${theaterId}&movieId=${movieId}`)
            .then(res => res.json())
            .then(data => {

                const dates = [...new Set(data.map(s => s.date))];

                dates.forEach(d => {

                    const opt = document.createElement("option");

                    opt.value = d;

                    const [y, m, day] = d.split("-");

                    opt.textContent = `${day}/${m}/${y}`;

                    dateSelect.appendChild(opt);

                });

                dateSelect.onchange = function () {

                    const selectedDate = this.value;

                    showtimeSelect.innerHTML = '<option selected disabled>-- Chọn suất chiếu --</option>';

                    data.filter(s => s.date === selectedDate)
                        .forEach(s => {

                            const opt = document.createElement("option");

                            opt.value = s.showtimeId;

                            opt.textContent =
                                `${s.time} - ${Number(s.price).toLocaleString("vi-VN")}đ`;

                            showtimeSelect.appendChild(opt);

                        });

                };

            });

    });

});

// =========================
// Google Map
// =========================

window.changeMap = function (address, element) {

    document.querySelectorAll(".theater-card")
        .forEach(x => x.classList.remove("active"));

    if (element)
        element.classList.add("active");

    document.getElementById("theaterMap").src =
        "https://maps.google.com/maps?q=" +
        encodeURIComponent(address) +
        "&output=embed";
};

function scrollToMapAndChange(address) {

    const mapSection = document.querySelector(".map-container");

    if (mapSection)
        mapSection.scrollIntoView({ behavior: "smooth" });

    document.querySelectorAll(".theater-card")
        .forEach(card => {

            const cardAddress =
                card.querySelector(".theater-info p").innerText.trim();

            card.classList.remove("active");

            if (cardAddress === address) {

                card.classList.add("active");

                changeMap(address, card);

            }

        });

}
</script>
}