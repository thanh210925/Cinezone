@model IEnumerable<CINEMA.Models.Movie>

@{
    ViewData["Title"] = "Trang chủ";

    var comingSoon = ViewBag.ComingSoon as IEnumerable<CINEMA.Models.Movie>
                     ?? Enumerable.Empty<CINEMA.Models.Movie>();

    var popup = ViewBag.Popup as CINEMA.Models.Popup;

    var popularMovies = ViewBag.PopularMovies as List<CINEMA.Models.Movie> ?? new List<CINEMA.Models.Movie>();
}
<!-- 🎬 POPUP QUẢNG CÁO -->
@if (popup != null && popup.IsActive)
{
    <div class="modal fade"
         id="promoPopup"
         tabindex="-1"
         data-bs-backdrop="true"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="position-relative">

                    <!-- nút đóng -->
                    <button type="button"
                            class="btn-close position-absolute top-0 end-0 m-3 bg-white p-2 rounded-circle shadow"
                            data-bs-dismiss="modal">
                    </button>

                    <!-- ảnh banner -->
                    <img src="@popup.ImageUrl"
                         class="img-fluid w-100"
                         style="max-height:320px; object-fit:cover;" />

                </div>

                <div class="modal-body text-center p-4">

                    <h3 class="fw-bold text-danger mb-3">
                        @popup.Title
                    </h3>

                    <p class="text-muted mb-4">
                        @popup.Description
                    </p>

                    <a href="@popup.ButtonLink"
                           class="btn btn-danger btn-lg fw-bold px-5 shadow-sm popup-btn">
                        🎟 Xem ngay
                    </a>

                </div>

            </div>

        </div>

    </div>
}

<!-- 🌟 KHU VỰC 1: HERO BANNER (DARK CINEMATIC CAROUSEL) -->
<div id="bannerCarousel" class="carousel slide carousel-fade position-relative mb-0 cz-animate-fade" data-bs-ride="carousel">
    <div class="carousel-inner shadow-lg">
        @{
            var todayDate = DateOnly.FromDateTime(DateTime.Today);
            var showingHero = (Model ?? Enumerable.Empty<CINEMA.Models.Movie>()).Take(5).ToList();
            var comingHero = (comingSoon ?? Enumerable.Empty<CINEMA.Models.Movie>()).Take(5).ToList();

            var heroMovies = new List<CINEMA.Models.Movie>();
            int maxLen = Math.Max(showingHero.Count, comingHero.Count);
            for (int k = 0; k < maxLen; k++)
            {
                if (k < showingHero.Count) heroMovies.Add(showingHero[k]);
                if (k < comingHero.Count) heroMovies.Add(comingHero[k]);
            }
        }
        @if (heroMovies.Any())
        {
            for (int i = 0; i < heroMovies.Count; i++)
            {
                var movie = heroMovies[i];
                var isActive = i == 0 ? "active" : "";
                var posterSrc = string.IsNullOrEmpty(movie.PosterUrl) ? "/images/unnamed.jpg" : movie.PosterUrl;
                var rating = movie.RatingAverage > 0 ? movie.RatingAverage.ToString("0.0") : "9.4";
                var ageRating = string.IsNullOrEmpty(movie.AgeRating) ? "P" : movie.AgeRating;
                bool isComingSoon = movie.ReleaseDate.HasValue && movie.ReleaseDate.Value > todayDate;

                <div class="carousel-item @isActive">
                    <section class="hero-section-modern" style="background-image: url('@posterSrc');">
                        <div class="hero-overlay-dark w-100 h-100 px-4 px-md-5 py-4">
                            <div class="container">
                                <div class="row align-items-center g-4">
                                    <!-- Left: Poster Thumbnail Image -->
                                    <div class="col-md-4 col-lg-3 text-center text-md-start">
                                        <div class="position-relative d-inline-block shadow-lg" style="border-radius: 20px !important; overflow: hidden;">
                                            <img src="@posterSrc"
                                                 onerror="this.onerror=null; this.src='/images/unnamed.jpg';"
                                                 alt="@movie.Title"
                                                 class="img-fluid border border-2 border-white border-opacity-25"
                                                 style="max-height: 380px; width: 265px; object-fit: cover; border-radius: 20px !important; box-shadow: 0 20px 40px rgba(0,0,0,0.6) !important;" />
                                            <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-3 fw-bold px-3 py-1.5 rounded-3 shadow fs-6" style="z-index: 5;">
                                                ⭐ @rating
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Right: Text Content & Actions -->
                                    <div class="col-md-8 col-lg-9 text-white">
                                        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                            @if (isComingSoon)
                                            {
                                                <span class="badge bg-danger px-3 py-2 rounded-pill fw-bold shadow-sm">Sắp khởi chiếu</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger px-3 py-2 rounded-pill fw-bold shadow-sm">Đang khởi chiếu</span>
                                            }
                                            <span class="badge bg-dark bg-opacity-60 text-white px-3 py-2 rounded-pill fw-semibold border border-secondary border-opacity-25">@(string.IsNullOrEmpty(movie.Language) ? "Tiếng Việt" : movie.Language)</span>
                                            <span class="badge bg-secondary bg-opacity-50 text-white px-3 py-2 rounded-pill fw-semibold">@ageRating</span>
                                        </div>

                                        <h1 class="display-5 fw-bold mb-3 text-uppercase text-white letter-spacing-1" style="line-height: 1.2;">@movie.Title</h1>

                                        <p class="lead text-light opacity-75 mb-4 pe-lg-4" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 1.05rem;">
                                            @(string.IsNullOrEmpty(movie.Description) 
                                                ? "Siêu phẩm điện ảnh đỉnh cao tại CineZone mang đến trải nghiệm hình ảnh sống động, âm thanh chân thực đỉnh cao..." 
                                                : movie.Description)
                                        </p>

                                        <div class="d-flex gap-3 flex-wrap">
                                            @if (isComingSoon)
                                            {
                                                <a asp-controller="Home" asp-action="MovieDetails" asp-route-id="@movie.MovieId" class="btn btn-danger btn-lg text-white rounded-pill px-4 fw-bold shadow">
                                                    <i class="bi bi-clock-history me-1"></i> Phim sắp chiếu
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="Home" asp-action="BookTicket" asp-route-id="@movie.MovieId" class="btn booking-btn-red text-white btn-lg rounded-pill px-4 fw-bold shadow">
                                                    <i class="bi bi-ticket-perforated me-1"></i> Đặt vé ngay
                                                </a>
                                            }
                                            <a href="@(string.IsNullOrEmpty(movie.TrailerUrl) ? "#" : movie.TrailerUrl)" target="_blank" class="btn btn-outline-light btn-lg rounded-pill px-4 fw-bold">
                                                <i class="bi bi-play-circle me-1"></i> Xem Trailer
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            }
        }
    </div>
</div>

<!-- 🎟️ KHU VỰC 2: OVERLAP BOOKING FORM (ĐẶT VÉ NHANH CHÌM DƯỚI CHÂN BANNER) -->
<section class="container mb-5">
    <div class="booking-overlap-card p-4 p-md-5">
        <h5 class="fw-bold text-dark mb-4"><i class="bi bi-calendar-check text-danger"></i> MUA VÉ NHANH</h5>
        <form asp-controller="Home" asp-action="BookTicket" method="post">
            <div class="row g-3">
                <div class="col-lg-3 col-md-6">
                    <select class="form-select form-select-lg border-0 bg-light rounded-3 text-dark" id="theaterSelect" name="theaterId" required>
                        <option selected disabled>Chọn rạp chiếu...</option>
                        @foreach (var theater in ViewBag.Theaters)
                        {
                            <option value="@theater.TheaterId">@theater.Name</option>
                        }
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <select class="form-select form-select-lg border-0 bg-light rounded-3 text-dark" id="movieSelect" name="movieId" required>
                        <option selected disabled>Chọn phim...</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <select class="form-select form-select-lg border-0 bg-light rounded-3 text-dark" id="dateSelect" name="date" required>
                        <option selected disabled>Chọn ngày...</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <select class="form-select form-select-lg border-0 bg-light rounded-3 text-dark" id="showtimeSelect" name="showtimeId" required>
                        <option selected disabled>Suất chiếu...</option>
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <button type="submit" class="btn booking-btn-red text-white btn-lg w-100 fw-bold rounded-3 h-100">MUA VÉ</button>
                </div>
            </div>
        </form>
    </div>
</section>

<!-- 🔥 KHU VỰC 3: PHIM ĐANG CHIẾU -->
<section class="movies-section mt-5">
    <div class="container-fluid px-lg-5 px-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-fire text-danger me-2"></i> PHIM ĐANG CHIẾU</h3>
            <a asp-controller="Home" asp-action="NowShowing" class="btn btn-outline-danger rounded-pill px-3 py-1.5 fw-bold shadow-sm d-inline-flex align-items-center gap-2 hover-lift transition-all">
                <span>Xem tất cả</span>
                <i class="bi bi-arrow-right-circle-fill fs-6"></i>
            </a>
        </div>

        <!-- 10 Movies Grid (5 columns per row on Desktop) -->
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4" id="recommendList">
        </div>
    </div>
</section>
@section Styles {
    <link rel="stylesheet" href="~/css/pages/home/index.css" asp-append-version="true" />
}
<!-- ⭐️ KHU VỰC 4: PHIM SẮP CHIẾU -->
<section class="movies-section mt-5">
    <div class="container-fluid px-lg-5 px-3">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold text-dark mb-0"><i class="bi bi-star-fill text-warning me-2"></i> PHIM SẮP CHIẾU</h3>
            <a asp-controller="Home" asp-action="ComingSoon" class="btn btn-outline-warning text-dark rounded-pill px-3 py-1.5 fw-bold shadow-sm d-inline-flex align-items-center gap-2 hover-lift transition-all" style="border-color: #f59e0b !important;">
                <span>Xem tất cả</span>
                <i class="bi bi-arrow-right-circle-fill text-warning fs-6"></i>
            </a>
        </div>

        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-4">
            @foreach (var movie in comingSoon)
            {
                var posterSrc = !string.IsNullOrWhiteSpace(movie.PosterUrl) ? movie.PosterUrl : "/images/unnamed.jpg";
                var ageRating = !string.IsNullOrWhiteSpace(movie.AgeRating) ? movie.AgeRating : "P";

                <div class="col">
                    <div class="movie-card shadow-sm border border-light-subtle rounded-4 overflow-hidden position-relative h-100 bg-white hover-up transition-all">
                        <div class="age-rating-badge position-absolute top-0 end-0 m-3 badge bg-warning text-dark fw-bold px-2 py-1 rounded-3 shadow-sm" style="z-index: 2;">
                            @ageRating
                        </div>

                        <div class="movie-poster-container position-relative overflow-hidden" style="height: 350px; background: #e2e8f0;">
                            <img src="@posterSrc"
                                 onerror="this.onerror=null; this.src='/images/unnamed.jpg';"
                                 alt="@movie.Title"
                                 class="w-100 h-100 object-fit-cover transition-transform">
                            
                            <div class="movie-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-60 opacity-0 transition-opacity">
                                <span class="badge bg-danger rounded-pill px-3 py-2 fs-6 shadow">
                                    <i class="bi bi-clock me-1"></i> Sắp chiếu
                                </span>
                            </div>
                        </div>

                        <div class="p-3 bg-white text-center">
                            <h6 class="fw-bold text-dark text-truncate mb-1" title="@movie.Title">@movie.Title</h6>
                            <p class="text-muted small mb-0">Khởi chiếu: <strong>@(movie.ReleaseDate.HasValue ? movie.ReleaseDate.Value.ToString("dd/MM/yyyy") : "Sắp chiếu")</strong></p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
