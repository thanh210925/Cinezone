@model IEnumerable<CINEMA.Models.Movie>

@{
    ViewData["Title"] = "Trang chủ";

    var comingSoon = ViewBag.ComingSoon as IEnumerable<CINEMA.Models.Movie>
                     ?? Enumerable.Empty<CINEMA.Models.Movie>();

    var popup = ViewBag.Popup as CINEMA.Models.Popup;

    var popularMovies = ViewBag.PopularMovies as List<CINEMA.Models.Movie> ?? new List<CINEMA.Models.Movie>();
}
<link rel="stylesheet" href="~/css/style-home.css" />
<!-- 🎬 POPUP QUẢNG CÁO -->
@if (popup != null && popup.IsActive)
{
    <div class="modal fade"
         id="promoPopup"
         tabindex="-1"
         data-bs-backdrop="true"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="position-relative">

                    <!-- nút đóng -->
                    <button type="button"
                            class="btn-close position-absolute top-0 end-0 m-3 bg-white p-2 rounded-circle shadow"
                            data-bs-dismiss="modal">
                    </button>

                    <!-- ảnh banner -->
                    <img src="@popup.ImageUrl"
                         class="img-fluid w-100"
                         style="max-height:320px; object-fit:cover;" />

                </div>

                <div class="modal-body text-center p-4">

                    <h3 class="fw-bold text-danger mb-3">
                        @popup.Title
                    </h3>

                    <p class="text-muted mb-4">
                        @popup.Description
                    </p>

                    <a href="@popup.ButtonLink"
                           class="btn btn-danger btn-lg fw-bold px-5 shadow-sm popup-btn">
                        🎟 Xem ngay
                    </a>

                </div>

            </div>

        </div>

    </div>
}

<!-- HEADER SECTION -->
