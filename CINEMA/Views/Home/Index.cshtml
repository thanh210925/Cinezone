<!-- QUICK BOOKING SECTION -->
<section class="booking-section mt-5">
    <div class="container">
        <div class="booking-card">

            <h2 class="section-title mb-4">
                <i class="bi bi-ticket-perforated"></i> ĐẶT VÉ NHANH
            </h2>

            <form asp-controller="Home"
                  asp-action="BookTicket"
                  method="post"
                  class="booking-form">

                <div class="row g-3">

                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fw-bold small">Chọn rạp chiếu</label>
                        <select class="form-select form-control-lg"
                                id="theaterSelect"
                                name="theaterId"
                                required>
                            <option selected disabled>-- Chọn rạp --</option>
                            @foreach (var theater in ViewBag.Theaters)
                            {
                                <option value="@theater.TheaterId">@theater.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fw-bold small">Chọn phim</label>
                        <select class="form-select form-control-lg"
                                id="movieSelect"
                                name="movieId"
                                required>
                            <option selected disabled>-- Chọn phim --</option>
                        </select>
                    </div>

                    <div class="col-md-2 col-sm-6">
                        <label class="form-label fw-bold small">Chọn ngày</label>
                        <select class="form-select form-control-lg"
                                id="dateSelect"
                                name="date"
                                required>
                            <option selected disabled>-- Chọn ngày --</option>
                        </select>
                    </div>

                    <div class="col-md-2 col-sm-6">
                        <label class="form-label fw-bold small">Suất chiếu</label>
                        <select class="form-select form-control-lg"
                                id="showtimeSelect"
                                name="showtimeId"
                                required>
                            <option selected disabled>-- Suất --</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 fw-bold rounded-2 booking-btn hover-lift">
                            Đặt vé
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>
</section>

<!-- NOW SHOWING MOVIES -->
<section class="movies-section mt-5">
    <div class="container">

        <div class="section-header mb-5">
            <h2 class="section-title text-center fw-bold">
                <i class="bi bi-film"></i> PHIM ĐANG CHIẾU
            </h2>
            <div class="title-underline"></div>
        </div>

        <div class="row g-4">

            @foreach (var movie in Model.Where(m =>
                    m.ReleaseDate.HasValue &&
                    m.ReleaseDate.Value.ToDateTime(TimeOnly.MinValue) <= DateTime.Today))
            {

                <div class="col-lg-3 col-md-4 col-sm-6">

                    <div class="movie-card h-100 shadow-sm rounded-3 overflow-hidden">

                        <div class="movie-poster-container position-relative">

                            <img src="@movie.PosterUrl"
                                 class="movie-poster w-100"
                                 alt="@movie.Title">

                            <div class="movie-overlay d-flex align-items-center justify-content-center">

                                <a asp-controller="Home"
                                   asp-action="BookTicket"
                                   asp-route-id="@movie.MovieId"
                                   class="btn btn-light btn-lg fw-bold rounded-pill px-4 shadow hover-lift movie-btn">
                                    Đặt vé
                                </a>

                            </div>

                        </div>

                        <div class="movie-info p-3">

                            <h5 class="fw-bold mb-2 movie-title">
                                @movie.Title
                            </h5>

                            <div class="movie-meta text-muted small">
                                <span class="badge bg-secondary me-2">@movie.AgeRating</span>
                                <span>@movie.Duration phút</span>
                            </div>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>
</section>

<!-- COMING SOON MOVIES -->
<section class="movies-section mt-5">
    <div class="container">

        <div class="section-header mb-5">
            <h2 class="section-title text-center fw-bold">
                <i class="bi bi-star"></i> PHIM SẮP CHIẾU
            </h2>
            <div class="title-underline"></div>
        </div>

        <div class="row g-4">

            @foreach (var movie in comingSoon)
            {

                <div class="col-lg-3 col-md-4 col-sm-6">

                    <div class="movie-card coming-soon h-100 shadow-sm rounded-3 overflow-hidden opacity-75">

                        <div class="movie-poster-container position-relative">

                            <img src="@movie.PosterUrl"
                                 class="movie-poster w-100"
                                 alt="@movie.Title">

                            <div class="movie-overlay d-flex align-items-center justify-content-center">

                                <div class="btn btn-outline-light btn-lg fw-bold rounded-pill px-4 shadow coming-soon-badge">
                                    Sắp chiếu
                                </div>

                            </div>

                        </div>

                        <div class="movie-info p-3">

                            <h5 class="fw-bold mb-2 movie-title">
                                @movie.Title
                            </h5>

                            <div class="movie-meta text-muted small">
                                <i class="bi bi-calendar-event"></i>
                                Khởi chiếu: <strong>@movie.ReleaseDate?.ToString("dd/MM/yyyy")</strong>
                            </div>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>
</section>

<!-- THEATER LOCATIONS -->
<section class="theater-section mt-5 mb-5">
    <div class="container">

        <div class="section-header mb-5">
            <h2 class="section-title text-center fw-bold">
                <i class="bi bi-geo-alt"></i> HỆ THỐNG RẠP CINEZONE
            </h2>
            <p class="text-center text-muted">Chọn rạp để xem vị trí trên bản đồ</p>
            <div class="title-underline"></div>
        </div>

        @{
            var theaters = ViewBag.Theaters as List<CINEMA.Models.Theater>;
            var firstTheater = theaters?.FirstOrDefault();

            string defaultMap =
                firstTheater != null
                ? $"https://maps.google.com/maps?q={Uri.EscapeDataString(firstTheater.Address ?? "")}&output=embed"
                : "https://maps.google.com/maps?q=Ho%20Chi%20Minh&output=embed";
        }

        <!-- Theater List -->
        <div class="row mb-5">

            @foreach (var theater in ViewBag.Theaters)
            {
                <div class="col-md-6 col-lg-4 mb-3">

                    <div class="theater-card h-100 p-4 rounded-3 shadow-sm cursor-pointer"
                         onclick="changeMap('@theater.Address', this)">

                        <h5 class="fw-bold mb-3 theater-name">
                            <i class="bi bi-building"></i> @theater.Name
                        </h5>

                        <div class="theater-info mb-2">
                            <p class="mb-2">
                                <i class="bi bi-geo-alt-fill text-primary"></i>
                                <span class="ms-2">@theater.Address</span>
                            </p>
                        </div>

                        <small class="text-muted">
                            <i class="bi bi-telephone-fill"></i>
                            <span class="ms-2">@theater.Phone</span>
                        </small>

                    </div>

                </div>
            }

        </div>

        <!-- Map -->
        <div class="map-container rounded-3 overflow-hidden shadow-md">

            <iframe id="theaterMap"
                    src="@defaultMap"
                    width="100%"
                    height="550"
                    style="border: none;"
                    loading="lazy">
            </iframe>

        </div>

    </div>
</section>

<!-- SCRIPTS -->
@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const firstCard = document.querySelector(".theater-card");
            if (firstCard) firstCard.classList.add("active");

            const popupElement = document.getElementById("promoPopup");
            if (popupElement) {
                const popup = new bootstrap.Modal(popupElement);
                if (!sessionStorage.getItem("popupShown")) {
                    setTimeout(() => popup.show(), 1000);
                    sessionStorage.setItem("popupShown", "true");
                }
            }
        });

        const theaterSelect = document.getElementById("theaterSelect");
        const movieSelect = document.getElementById("movieSelect");
        const dateSelect = document.getElementById("dateSelect");
        const showtimeSelect = document.getElementById("showtimeSelect");

        theaterSelect.addEventListener("change", function () {
            const theaterId = this.value;
            movieSelect.innerHTML = '<option selected disabled>-- Chọn phim --</option>';
            dateSelect.innerHTML = '<option selected disabled>-- Chọn ngày --</option>';
            showtimeSelect.innerHTML = '<option selected disabled>-- Chọn suất chiếu --</option>';

            fetch(`/Home/GetMoviesByTheater?theaterId=${theaterId}`)
                .then(res => res.json())
                .then(data => {
                    data.forEach(m => {
                        const opt = document.createElement("option");
                        opt.value = m.movieId;
                        opt.textContent = m.title;
                        movieSelect.appendChild(opt);
                    });
                });
        });

        movieSelect.addEventListener("change", function () {
            const theaterId = theaterSelect.value;
            const movieId = this.value;
            dateSelect.innerHTML = '<option selected disabled>-- Chọn ngày --</option>';

            fetch(`/Home/GetShowtimes?theaterId=${theaterId}&movieId=${movieId}`)
                .then(res => res.json())
                .then(data => {
                    const dates = [...new Set(data.map(s => s.date))];
                    dates.forEach(d => {
                        const opt = document.createElement("option");
                        opt.value = d;
                        const [y, m, day] = d.split("-");
                        opt.textContent = `${day}/${m}/${y}`;
                        dateSelect.appendChild(opt);
                    });

                    dateSelect.onchange = function () {
                        const selectedDate = this.value;
                        showtimeSelect.innerHTML = '<option selected disabled>-- Chọn suất chiếu --</option>';
                        data.filter(s => s.date === selectedDate)
                            .forEach(s => {
                                const opt = document.createElement("option");
                                opt.value = s.showtimeId;
                                opt.textContent = `${s.time} - ${Number(s.price).toLocaleString("vi-VN")}đ`;
                                showtimeSelect.appendChild(opt);
                            });
                    };
                });
        });

        window.changeMap = function (address, element) {
            document.querySelectorAll('.theater-card')
                .forEach(x => x.classList.remove('active'));
            if (element) element.classList.add('active');
            const mapUrl = "https://maps.google.com/maps?q=" + encodeURIComponent(address) + "&output=embed";
            document.getElementById("theaterMap").src = mapUrl;
        }
    </script>

}
