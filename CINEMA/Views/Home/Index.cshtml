<!-- 📊 COMPACT POPULAR GENRES SECTION (LIGHT THEME) -->
<section class="genre-compact-section my-4 py-4 rounded-4 shadow-sm border cz-animate-fade" style="background: #ffffff;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <span class="text-danger fs-5">🔥</span> THỂ LOẠI HOT NHẤT
            </h5>
            <small class="text-muted">Các thể loại được tìm kiếm nhiều nhất</small>
        </div>

        @{
            var popularGenres = ViewBag.PopularGenres as List<CINEMA.Models.Genre> ?? new List<CINEMA.Models.Genre>();
        }

        <div class="row g-3">
            @for (int i = 0; i < popularGenres.Count; i++)
            {
                var genre = popularGenres[i];
                <div class="col-md-4 col-12">
                    <a asp-controller="Home" asp-action="MoviesByGenre" asp-route-genreId="@genre.GenreId" class="text-decoration-none">
                        <div class="genre-compact-card p-3 rounded-3 d-flex align-items-center justify-content-between shadow-sm" style="background: #f8fafc; border: 1px solid #e2e8f0; transition: all 0.25s ease;">
                            <div class="d-flex align-items-center gap-3">
                                <span class="badge bg-danger rounded-circle p-2 fs-6 fw-bold" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">#@(i + 1)</span>
                                <div>
                                    <h6 class="fw-bold text-dark mb-0">@genre.Name</h6>
                                    <small class="text-muted" style="font-size: 0.78rem;">Phim hot trong tuần</small>
                                </div>
                            </div>
                            <span class="text-primary font-weight-bold fs-5">→</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- 📍 COMPACT THEATER LOCATIONS & MAP SECTION (280px Height - LIGHT THEME) -->
<section id="theaterSection" class="theater-section my-4 cz-animate-fade">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <span class="text-primary fs-5">📍</span> HỆ THỐNG RẠP CINEZONE
                </h5>
                <p class="text-muted small mb-0">Chọn rạp để xem vị trí trên bản đồ</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Home" asp-action="Theaters" class="btn btn-danger btn-sm rounded-pill px-3.5 shadow-sm fw-semibold">
                    <i class="bi bi-grid-fill me-1"></i> Xem tất cả rạp →
                </a>
                <a asp-controller="Home" asp-action="Schedule" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                    Lịch chiếu →
                </a>
            </div>
        </div>

        @{
            var theaters = ViewBag.Theaters as List<CINEMA.Models.Theater> ?? new List<CINEMA.Models.Theater>();
            var firstTheater = theaters.FirstOrDefault();
            string defaultMap = firstTheater != null
                ? $"https://maps.google.com/maps?q={Uri.EscapeDataString(firstTheater.Address ?? "")}&output=embed"
                : "https://maps.google.com/maps?q=Ho%20Chi%20Minh&output=embed";
        }

        <div class="row g-3 align-items-stretch">
            <!-- Left Side: Compact Theater List (5 cols, height 280px) -->
            <div class="col-lg-5">
                <div class="theater-compact-list p-2 rounded-3 border" style="background: #f8fafc; border-color: #e2e8f0 !important; max-height: 280px; overflow-y: auto;">
                    @if (theaters.Any())
                    {
                        for (int i = 0; i < theaters.Count; i++)
                        {
                            var t = theaters[i];
                            var isActive = i == 0 ? "active" : "";

                            <div class="theater-compact-item p-2 mb-2 rounded-3 cursor-pointer position-relative @isActive"
                                 onclick="changeMap('@t.Address', this)">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="fw-bold text-dark mb-0 small theater-name">
                                        <i class="bi bi-building me-1 text-primary"></i> @t.Name
                                    </h6>
                                    <span class="badge bg-warning text-dark font-weight-bold" style="font-size: 0.7rem;">★ 4.9</span>
                                </div>
                                <div class="small text-muted mb-1 text-truncate" style="font-size: 0.78rem;" title="@t.Address">
                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i> @t.Address
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="p-2 text-center text-muted small">Đang cập nhật danh sách rạp...</div>
                    }
                </div>
            </div>

            <!-- Right Side: Compact Map Embed (7 cols, height 280px) -->
            <div class="col-lg-7">
                <div class="map-container rounded-3 overflow-hidden shadow-sm border h-100" style="min-height: 280px; border-color: #e2e8f0 !important;">
                    <iframe id="theaterMap"
                            src="@defaultMap"
                            width="100%"
                            height="100%"
                            style="border: none; min-height: 280px;"
                            loading="lazy">
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</section>

@* <!-- SCRIPTS --> *@
@section Scripts{
    <script>
        window.HomeIndexConfig = {
            popularMovies: @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    popularMovies.Select(x => new
                    {
                        movieId = x.MovieId,
                        title = x.Title,
                        posterUrl = x.PosterUrl,
                        ageRating = x.AgeRating,
                        duration = x.Duration
                    })
                )
            )
        };
    </script>
    <script src="~/js/pages/home/index.js" asp-append-version="true"></script>
}
