@model IEnumerable<CINEMA.Models.Movie>

@{
    ViewData["Title"] = "Trang chủ";

    var comingSoon = ViewBag.ComingSoon as IEnumerable<CINEMA.Models.Movie>
                     ?? Enumerable.Empty<CINEMA.Models.Movie>();

    var popup = ViewBag.Popup as CINEMA.Models.Popup;

    var popularMovies = ViewBag.PopularMovies as List<CINEMA.Models.Movie> ?? new List<CINEMA.Models.Movie>();
}
<link rel="stylesheet" href="~/css/style-home.css" />
<!-- 🎬 POPUP QUẢNG CÁO -->
@if (popup != null && popup.IsActive)
{
    <div class="modal fade"
         id="promoPopup"
         tabindex="-1"
         data-bs-backdrop="true"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered modal-lg">

            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="position-relative">

                    <!-- nút đóng -->
                    <button type="button"
                            class="btn-close position-absolute top-0 end-0 m-3 bg-white p-2 rounded-circle shadow"
                            data-bs-dismiss="modal">
                    </button>

                    <!-- ảnh banner -->
                    <img src="@popup.ImageUrl"
                         class="img-fluid w-100"
                         style="max-height:320px; object-fit:cover;" />

                </div>

                <div class="modal-body text-center p-4">

                    <h3 class="fw-bold text-danger mb-3">
                        @popup.Title
                    </h3>

                    <p class="text-muted mb-4">
                        @popup.Description
                    </p>

                    <a href="@popup.ButtonLink"
                           class="btn btn-danger btn-lg fw-bold px-5 shadow-sm popup-btn">
                        🎟 Xem ngay
                    </a>

                </div>

            </div>

        </div>

    </div>
}

<!-- 🌟 HERO BANNER CAROUSEL MATCHING REFERENCE DESIGN SCREENSHOT -->
<div id="bannerCarousel" class="carousel slide carousel-fade position-relative mb-5 cz-animate-fade" data-bs-ride="carousel">
    <div class="carousel-inner shadow-lg" style="border-radius: 24px !important; overflow: hidden;">
        @if (Model != null && Model.Any())
        {
            var heroMovies = Model.Take(5).ToList();
            for (int i = 0; i < heroMovies.Count; i++)
            {
                var movie = heroMovies[i];
                var isActive = i == 0 ? "active" : "";
                var backdrop = string.IsNullOrEmpty(movie.PosterUrl) ? "/images/banner_web_4_.jpg" : movie.PosterUrl;
                var rating = movie.RatingAverage > 0 ? movie.RatingAverage.ToString("0.0") : "9.4";
                var ageRating = string.IsNullOrEmpty(movie.AgeRating) ? "T16" : movie.AgeRating;

                <div class="carousel-item @isActive">
                    <div class="hero-banner-custom-box position-relative d-flex align-items-center" style="background-image: url('@backdrop');">
                        <div class="hero-banner-custom-overlay w-100 h-100 d-flex align-items-center px-4 px-md-5">
                            <div class="row align-items-center w-100 g-4 mx-0">
                                <!-- Left Poster Thumbnail -->
                                <div class="col-md-4 col-lg-3 d-none d-md-block text-center text-md-start">
                                    <img src="@movie.PosterUrl" alt="@movie.Title" class="img-fluid hero-banner-thumb" />
                                </div>
                                <!-- Right Details -->
                                <div class="col-md-8 col-lg-9 text-white">
                                    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                                        <span class="badge bg-dark bg-opacity-75 px-3 py-2 rounded-pill fw-semibold border border-secondary border-opacity-25">Hành Động</span>
                                        <span class="badge bg-dark bg-opacity-75 px-3 py-2 rounded-pill fw-semibold border border-secondary border-opacity-25">2026</span>
                                        <span class="badge bg-dark bg-opacity-75 px-3 py-2 rounded-pill fw-semibold border border-secondary border-opacity-25">IMAX 3D</span>
                                    </div>
                                    
                                    <h1 class="fw-bold display-5 mb-3 text-uppercase text-white letter-spacing-1">@movie.Title</h1>

                                    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap small">
                                        <span class="badge bg-warning text-dark font-weight-bold px-2 py-1 rounded-pill" style="font-size: 0.85rem;">⭐ @rating</span>
                                        <span class="text-slate-300">2026</span>
                                        <span class="text-slate-300">@(movie.Duration.HasValue ? movie.Duration.Value + " phút" : "87 phút")</span>
                                        <span class="badge bg-danger rounded-pill px-2 py-1" style="font-size: 0.75rem;">@ageRating</span>
                                        <span class="text-slate-300">Tiếng Việt</span>
                                    </div>

                                    <p class="text-slate-300 mb-4 me-lg-5 hero-banner-desc">
                                        @(string.IsNullOrEmpty(movie.Description) 
                                            ? "Sarah đến một ngôi làng bị ám bởi truyền thuyết về Quỷ Mèo Đen. Khi các vụ chết người bí ẩn xảy ra, cô khám phá ra nghi lễ hiến tế cổ xưa và những bí mật đen tối của dân làng..." 
                                            : movie.Description)
                                    </p>

                                    <div class="d-flex align-items-center gap-3 flex-wrap">
                                        <a asp-controller="Home" asp-action="BookTicket" asp-route-id="@movie.MovieId" class="btn btn-primary rounded-pill px-4 py-2 fw-bold shadow border-0 d-inline-flex align-items-center gap-2" style="background-color: #1d72f3;">
                                            <i class="bi bi-ticket-perforated-fill fs-5"></i> Đặt vé
                                        </a>
                                        <a href="@(string.IsNullOrEmpty(movie.TrailerUrl) ? "#" : movie.TrailerUrl)" target="_blank" class="btn btn-outline-light rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 bg-dark bg-opacity-50 border-secondary border-opacity-50">
                                            <i class="bi bi-play-circle fs-5"></i> Trailer
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Floating Navigation Arrows -->
    <button class="carousel-control-prev hero-arrow-btn hero-arrow-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
        <i class="bi bi-chevron-left fs-4"></i>
    </button>
    <button class="carousel-control-next hero-arrow-btn hero-arrow-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
        <i class="bi bi-chevron-right fs-4"></i>
    </button>
</div>



@* <!-- QUICK BOOKING SECTION --> *@
<section class="booking-section mt-5">
    <div class="container">
        <div class="booking-card">

            <h2 class="section-title mb-4">
                <i class="bi bi-ticket-perforated"></i> ĐẶT VÉ NHANH
            </h2>

            <form asp-controller="Home"
                  asp-action="BookTicket"
                  method="post"
                  class="booking-form">

                <div class="row g-3">

                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fw-bold small">Chọn rạp chiếu</label>
                        <select class="form-select form-control-lg"
                                id="theaterSelect"
                                name="theaterId"
                                required>
                            <option selected disabled>-- Chọn rạp --</option>
                            @foreach (var theater in ViewBag.Theaters)
                            {
                                <option value="@theater.TheaterId">@theater.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-3 col-sm-6">
                        <label class="form-label fw-bold small">Chọn phim</label>
                        <select class="form-select form-control-lg"
                                id="movieSelect"
                                name="movieId"
                                required>
                            <option selected disabled>-- Chọn phim --</option>
                        </select>
                    </div>

                    <div class="col-md-2 col-sm-6">
                        <label class="form-label fw-bold small">Chọn ngày</label>
                        <select class="form-select form-control-lg"
                                id="dateSelect"
                                name="date"
                                required>
                            <option selected disabled>-- Chọn ngày --</option>
                        </select>
                    </div>

                    <div class="col-md-2 col-sm-6">
                        <label class="form-label fw-bold small">Suất chiếu</label>
                        <select class="form-select form-control-lg"
                                id="showtimeSelect"
                                name="showtimeId"
                                required>
                            <option selected disabled>-- Suất --</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 fw-bold rounded-2 booking-btn hover-lift">
                            Đặt vé
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>
</section>

@* <!-- NOW SHOWING MOVIES --> *@
<section class="movies-section mt-5">
    <div class="container text-center mb-5">
        <h2 class="fw-bold text-danger"><i class="bi bi-fire"></i> PHIM HOT & GỢI Ý</h2>
        <div class="title-underline mx-auto"></div>
    </div>

    <div class="swiper popularSwiper">
        <div class="swiper-wrapper" id="recommendList">
        </div>
    </div>
</section>
<style>
    .popularSwiper {
        padding: 50px 0;
        width: 100%;
    }

    .swiper-slide {
        transition: transform 0.5s ease;
        transform: scale(0.85); /* Card 2 bên nhỏ hơn */
        opacity: 0.6;
        width: 300px; /* Độ rộng cố định cho mỗi card */
    }

    .swiper-slide-active {
        transform: scale(1.15) !important; /* Card giữa to hơn */
        opacity: 1;
    }

    .movie-card {
        border-radius: 24px;
        overflow: hidden;
        background: #fff;
        transition: all .35s ease;
    }
    .movie-poster-container {
        position: relative;
        overflow: hidden;
    
    }

        .movie-poster-container img {
            transition: .4s;
        }

    .movie-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,.55);
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        visibility: hidden;
        transition: .35s;
    }

    .overlay-content {
        text-align: center;
        transform: translateY(20px);
        transition: .35s;
    }

    .movie-meta {
        color: #fff;
        font-size: 15px;
        font-weight: 600;
    }

        .movie-meta .badge {
            font-size: 14px;
            padding: 7px 12px;
        }

    .movie-card:hover .movie-overlay {
        opacity: 1;
        visibility: visible;
    }

    .movie-card:hover .overlay-content {
        transform: translateY(0);
    }

    .movie-card:hover img {
        transform: scale(1.08);
    }
</style>
@* <!-- COMING SOON MOVIES --> *@
<section class="movies-section mt-5">
    <div class="container">

        <div class="section-header mb-5">
            <h2 class="section-title text-center fw-bold">
                <i class="bi bi-star"></i> PHIM SẮP CHIẾU
            </h2>
            <div class="title-underline"></div>
        </div>

        <div class="row g-4">

            @foreach (var movie in comingSoon)
            {

                <div class="col-lg-3 col-md-4 col-sm-6">

                    <div class="movie-card coming-soon h-100 shadow-sm rounded-3 overflow-hidden opacity-75">

                        <div class="movie-poster-container position-relative">

                            <img src="@movie.PosterUrl"
                                 class="movie-poster w-100"
                                 alt="@movie.Title">

                            <div class="movie-overlay d-flex align-items-center justify-content-center">

                                <div class="btn btn-outline-light btn-lg fw-bold rounded-pill px-4 shadow coming-soon-badge">
                                    Sắp chiếu
                                </div>

                            </div>

                        </div>

                        <div class="movie-info p-3">

                            <h5 class="fw-bold mb-2 movie-title">
                                @movie.Title
                            </h5>

                            <div class="movie-meta text-muted small">
                                <i class="bi bi-calendar-event"></i>
                                Khởi chiếu: <strong>@movie.ReleaseDate?.ToString("dd/MM/yyyy")</strong>
                            </div>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>
</section>
