@model List<CINEMA.Models.Movie>
@{
    ViewData["Title"] = "Lịch chiếu phim";
    var selectedDate = (DateTime)ViewBag.SelectedDate;
}

<div class="container-fluid px-lg-5 px-3 py-5" style="padding-top: 100px !important;">
    <div class="text-center mb-5">
        <h1 class="fw-bold mb-3"
            style="font-size: 2.8rem; color: #1d4ed8; display: flex; align-items: center; justify-content: center; gap: 10px;">
            <i class="bi bi-camera-reels-fill"></i> Lịch Chiếu Phim
        </h1>

        <p class="text-muted fs-5 mb-4">
            @selectedDate.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
        </p>
        <div class="position-relative px-4 mx-auto" style="max-width: 900px;">
            <!-- Nút mũi tên trái -->
            <button type="button" class="scroll-arrow scroll-arrow-left" onclick="scrollTabs('left')">
                <i class="bi bi-chevron-left"></i>
            </button>

            <!-- Danh sách lịch cuộn ngang -->
            <div id="dateTabsContainer" class="d-flex align-items-center gap-2 mb-4 pb-2" 
                 style="overflow-x: auto; white-space: nowrap; -webkit-overflow-scrolling: touch; scrollbar-width: none;">
                @for (int i = 0; i < 30; i++)
                {
                    var day = DateTime.Today.AddDays(i);
                    var isActive = selectedDate.Date == day.Date;
                    
                    string dayLabel = "";
                    bool isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;

                    if (i == 0) {
                        dayLabel = "H.nay";
                    } else {
                        dayLabel = day.DayOfWeek switch {
                            DayOfWeek.Sunday => "C.Nhật",
                            DayOfWeek.Monday => "Thứ 2",
                            DayOfWeek.Tuesday => "Thứ 3",
                            DayOfWeek.Wednesday => "Thứ 4",
                            DayOfWeek.Thursday => "Thứ 5",
                            DayOfWeek.Friday => "Thứ 6",
                            DayOfWeek.Saturday => "Thứ 7",
                            _ => ""
                        };
                    }

                    <a asp-action="Schedule" asp-route-date="@day.ToString("yyyy-MM-dd")" 
                       class="date-tab @(isActive ? "date-tab-active" : "") @(isWeekend ? "date-tab-weekend" : "")"
                       id="tab-@day.ToString("yyyy-MM-dd")">
                        <span class="date-tab-header">@day.ToString("dd/MM")</span>
                        <span class="date-tab-footer">@dayLabel</span>
                    </a>
                }
            </div>

            <!-- Nút mũi tên phải -->
            <button type="button" class="scroll-arrow scroll-arrow-right" onclick="scrollTabs('right')">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>

        <!-- Bộ lọc thời gian -->
        <div class="d-flex justify-content-start justify-content-md-center align-items-center gap-2 flex-wrap mb-4 pb-3 border-bottom">
            <button class="btn time-filter-btn btn-pink-active px-3 py-2 rounded-pill fw-semibold" onclick="filterTime('all', this)">Tất cả</button>
            <button class="btn time-filter-btn btn-light-grey px-3 py-2 rounded-pill fw-semibold" onclick="filterTime('truoc12', this)">Trước 12:00</button>
            <button class="btn time-filter-btn btn-light-grey px-3 py-2 rounded-pill fw-semibold" onclick="filterTime('12to15', this)">12:00 - 15:00</button>
            <button class="btn time-filter-btn btn-light-grey px-3 py-2 rounded-pill fw-semibold" onclick="filterTime('15to18', this)">15:00 - 18:00</button>
            <button class="btn time-filter-btn btn-light-grey px-3 py-2 rounded-pill fw-semibold" onclick="filterTime('18to21', this)">18:00 - 21:00</button>
            <button class="btn time-filter-btn btn-light-grey px-3 py-2 rounded-pill fw-semibold" onclick="filterTime('sau21', this)">Sau 21:00</button>
        </div>

    </div>


    @if (Model != null && Model.Any())
    {
        <div class="row gy-4" id="movieListContainer">
            @foreach (var movie in Model)
            {
                <div class="col-12 movie-card-item">
                    <div class="card shadow-lg border-0 overflow-hidden movie-card">
                        <div class="row g-0">
                            <!-- Movie Poster -->
                            <div class="col-md-3 position-relative">
                                <img src="@movie.PosterUrl"
                                     alt="@movie.Title"
                                     class="img-fluid w-100 h-100"
                                     style="object-fit: cover; min-height: 320px; border-right: 4px solid #0d6efd;" />
                                <div class="position-absolute bottom-0 start-0 w-100 py-2 px-3 bg-dark bg-opacity-75 text-white small">
                                    <i class="bi bi-clock me-1"></i> @movie.Duration phút
                                </div>
                            </div>

                            <!-- Movie Info -->
                            <div class="col-md-9 bg-light bg-gradient">
                                <div class="card-body p-4">
                                    <!-- Title -->
                                    <h3 class="fw-bold mb-3 text-dark">@movie.Title</h3>

                                    <!-- Details -->
                                    <div class="d-flex flex-wrap gap-4 mb-4">
                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-film text-primary fs-5"></i>
                                            <div>
                                                <small class="text-muted d-block">Thể loại</small>
                                                <span class="fw-semibold">@string.Join(", ", movie.Genres?.Select(g => g.Name) ?? new List<string>())</span>
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center gap-2">
                                            <i class="bi bi-translate text-primary fs-5"></i>
                                            <div>
                                                <small class="text-muted d-block">Ngôn ngữ</small>
                                                <span class="fw-semibold">Phụ đề / Lồng tiếng</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Showtimes -->
                                    <div class="border-top pt-4">
                                        <h5 class="fw-semibold mb-3 text-secondary">
                                            <i class="bi bi-calendar-event me-2"></i>Suất chiếu trong ngày
                                        </h5>

                                        @{
                                            var showtimes = movie.Showtimes
                                            .Where(s => s.StartTime.HasValue &&
                                            s.StartTime.Value.Date == selectedDate.Date &&
                                            s.IsActive == true)
                                            .OrderBy(s => s.StartTime)
                                            .ToList();
                                        }
                                        @{
                                            var showtimesByTheater = movie.Showtimes
                                                .Where(s => s.StartTime.HasValue &&
                                                            s.StartTime.Value.Date == selectedDate.Date &&
                                                            s.IsActive == true)
                                                .GroupBy(s => s.Auditorium.Theater);
                                        }

                                        @if (showtimesByTheater.Any())
                                        {
                                            @foreach (var theaterGroup in showtimesByTheater)
                                            {
                                                <div class="mb-3 theater-block-item">
                                                    <!-- 🎯 TÊN RẠP -->
                                                    <h6 class="fw-bold text-primary mb-1">
                                                        <i class="bi bi-geo-alt-fill me-1"></i>
                                                        @theaterGroup.Key.Name
                                                    </h6>

                                                    <small class="text-muted d-block mb-2">
                                                        @theaterGroup.Key.Address
                                                    </small>

                                                    <!-- 🎬 SUẤT CHIẾU -->
                                                    <div class="d-flex flex-wrap gap-3">
                                                        @foreach (var s in theaterGroup.OrderBy(x => x.StartTime))
                                                        {
                                                            <a asp-controller="Home"
                                                                   asp-action="BookTicket"
                                                                   asp-route-id="@movie.MovieId"
                                                                   asp-route-showtimeId="@s.ShowtimeId"
                                                                   class="btn-showtime shadow-sm text-decoration-none"
                                                                   data-time="@s.StartTime?.ToString("HH:mm")">

                                                                <div class="fw-bold fs-5">
                                                                    @s.StartTime?.ToString("HH:mm")
                                                                </div>

                                                                <div class="text-muted small">
                                                                    @s.Auditorium?.Name
                                                                </div>

                                                                <div class="text-danger fw-semibold mt-1">
                                                                    @((s.BasePrice ?? 0).ToString("N0")) đ
                                                                </div>
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-muted mb-0">
                                                <i class="bi bi-info-circle me-2"></i>
                                                Chưa có suất chiếu cho ngày này.
                                            </p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted mb-4"></i>
            @if (ViewBag.IsRestricted == true)
            {
                <h4 class="text-muted mb-2">Hôm nay chưa có suất chiếu mới</h4>
                <p class="text-muted">Suất chiếu cho ngày này chưa được mở bán. Vui lòng quay lại sau.</p>
            }
            else
            {
                <h4 class="text-muted mb-2">Không có suất chiếu</h4>
                <p class="text-muted">Không có phim nào chiếu trong ngày này. Vui lòng chọn ngày khác.</p>
            }
        </div>
    }
</div>



@section Scripts {
    <script src="~/js/pages/home/schedule.js" asp-append-version="true"></script>
}
