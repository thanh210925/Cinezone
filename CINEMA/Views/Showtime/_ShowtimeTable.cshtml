@model IEnumerable<CINEMA.Models.Showtime>

<div class="table-responsive">
    <table class="table table-hover align-middle custom-table mb-0">
        <thead class="table-light text-secondary">
            <tr>
                <th class="ps-4">Phim</th>
                <th>Rạp</th>
                <th>Thời gian</th>
                <th>Giá vé</th>
                <th class="text-center">Ngôn ngữ</th>
                <th class="text-center pe-4">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var s in Model)
                {
                    <tr>
                        <td class="ps-4 fw-bold text-dark">@s.Movie?.Title</td>
                        <td class="text-muted">@s.Auditorium?.Name</td>
                        <td>
                            <div class="small fw-medium text-success">@s.StartTime?.ToString("HH:mm dd/MM")</div>
                            <div class="small text-muted">@s.EndTime?.ToString("HH:mm dd/MM")</div>
                        </td>
                        <td class="text-danger fw-bold">@s.BasePrice?.ToString("N0") đ</td>
                        <td class="text-center"><span class="badge bg-info-subtle text-info rounded-pill px-3">@s.Language</span></td>
                        <td class="text-center pe-4">
                            <div class="d-flex justify-content-center gap-2">
                                @if (s.IsActive == true)
                                {
                                    <a asp-action="Edit" asp-route-id="@s.ShowtimeId" class="btn btn-light btn-sm text-warning"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="Deactivate" asp-route-id="@s.ShowtimeId" method="post"><button class="btn btn-light btn-sm text-dark"><i class="bi bi-pause-circle"></i></button></form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@s.ShowtimeId" method="post"><button class="btn btn-light btn-sm text-success"><i class="bi bi-arrow-repeat"></i></button></form>
                                }
                                <a asp-action="Delete" asp-route-id="@s.ShowtimeId" class="btn btn-light btn-sm text-danger"><i class="bi bi-trash3"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center py-4 text-muted">Không có dữ liệu</td></tr>
            }
        </tbody>
    </table>
</div>