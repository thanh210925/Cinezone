@model IEnumerable<CINEMA.Models.Showtime>



<div class="table-responsive">
    <table class="table table-hover align-middle custom-table mb-0">
        <thead class="table-light text-secondary">
            <tr>
                <th class="ps-4 text-center" style="width: 40px;">
                    <input type="checkbox" class="form-check-input select-all-list-cb" onclick="toggleAllList(this)" />
                </th>
                <th>Phim</th>
                <th>Rạp</th>
                <th>Thời gian</th>
                <th>Giá vé</th>
                <th class="text-center">Ngôn ngữ</th>
                <th class="text-center pe-4">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var s in Model)
                {
                    <tr class="showtime-row" data-id="@s.ShowtimeId" onclick="toggleRowSelect(event, this)">
                        <td class="text-center ps-4">
                            <input type="checkbox" class="form-check-input showtime-select-cb" value="@s.ShowtimeId" onclick="event.stopPropagation(); updateListBulkBar();" />
                        </td>
                        <td class="fw-bold text-dark">@s.Movie?.Title</td>
                        <td class="text-muted">@s.Auditorium?.Name (@(s.Auditorium?.Theater?.Name ?? "CineZone"))</td>
                        <td>
                            <div class="small fw-medium text-success">@s.StartTime?.ToString("HH:mm dd/MM/yyyy")</div>
                            <div class="small text-muted">@s.EndTime?.ToString("HH:mm dd/MM/yyyy")</div>
                        </td>
                        <td class="text-danger fw-bold">@s.BasePrice?.ToString("N0") đ</td>
                        <td class="text-center"><span class="badge bg-info-subtle text-info rounded-pill px-3">@s.Language</span></td>
                        <td class="text-center pe-4">
                            <div class="d-flex justify-content-center gap-2" onclick="event.stopPropagation();">
                                @if (s.IsActive == true)
                                {
                                    <a asp-action="Edit" asp-route-id="@s.ShowtimeId" class="btn btn-light btn-sm text-warning" title="Sửa"><i class="bi bi-pencil-square"></i></a>
                                    <form asp-action="Deactivate" asp-route-id="@s.ShowtimeId" method="post" class="d-inline"><button class="btn btn-light btn-sm text-dark" title="Tạm dừng"><i class="bi bi-pause-circle"></i></button></form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@s.ShowtimeId" method="post" class="d-inline"><button class="btn btn-light btn-sm text-success" title="Kích hoạt"><i class="bi bi-arrow-repeat"></i></button></form>
                                }
                                <a asp-action="Delete" asp-route-id="@s.ShowtimeId" class="btn btn-light btn-sm text-danger" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa suất chiếu này?');"><i class="bi bi-trash3"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7" class="text-center py-4 text-muted">Không có dữ liệu</td></tr>
            }
        </tbody>
    </table>
</div>

<!-- Floating bulk actions bar for List View -->
<div id="listBulkBar" class="bulk-action-bar position-fixed bottom-0 start-50 translate-middle-x bg-white border shadow-lg p-3 rounded-4 mb-4 d-none align-items-center gap-3" style="z-index: 1050; min-width: 480px;">
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-warning text-dark fs-6" id="listBulkCount">0</span>
        <span class="small fw-semibold text-secondary">mục đã chọn</span>
    </div>
    <div class="ms-auto d-flex gap-2">
        <button class="btn btn-sm btn-success rounded-pill px-3" onclick="triggerListBulkAction('BulkActivate')">
            <i class="bi bi-play-fill me-1"></i> Kích hoạt
        </button>
        <button class="btn btn-sm btn-dark rounded-pill px-3" onclick="triggerListBulkAction('BulkDeactivate')">
            <i class="bi bi-pause-fill me-1"></i> Tạm ngưng
        </button>
        <button class="btn btn-sm btn-danger rounded-pill px-3" onclick="triggerListBulkAction('BulkDelete')">
            <i class="bi bi-trash-fill me-1"></i> Xóa
        </button>
    </div>
</div>

<script src="~/js/pages/showtime/showtimetable.js" asp-append-version="true"></script>
