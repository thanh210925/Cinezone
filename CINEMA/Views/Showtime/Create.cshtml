@{
    ViewData["Title"] = "Tạo lịch chiếu";
    Layout = "_AdminLayout";
    var movies = ViewBag.Movies as List<CINEMA.Models.Movie>;
    var auditoriums = ViewBag.Auditoriums as List<CINEMA.Models.Auditorium>;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/showtime/create.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none">Dashboard</a></li>
      <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Quản lý lịch chiếu</a></li>
      <li class="breadcrumb-item active">Tạo lịch chiếu</li>
    </ol>
  </nav>

  <!-- STEP INDICATOR -->
  <div class="wizard-nav">
    <div class="wstep"><div class="wstep-dot active" id="dot-1">1</div><span class="wstep-label active" id="lbl-1">Cài đặt chung</span></div>
    <div class="wstep-line" id="line-1"></div>
    <div class="wstep"><div class="wstep-dot pending" id="dot-2">2</div><span class="wstep-label" id="lbl-2">Chọn khung giờ</span></div>
    <div class="wstep-line" id="line-2"></div>
    <div class="wstep"><div class="wstep-dot pending" id="dot-3">3</div><span class="wstep-label" id="lbl-3">Preview &amp; Lưu</span></div>
  </div>

  <!-- ===== STEP 1 ===== -->
  <div class="wizard-panel active" id="panel-1">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-header bg-white border-0 pt-4 px-4">
        <h5 class="fw-bold text-primary mb-0"><i class="bi bi-gear-fill me-2"></i>B 1: Cài đặt chung</h5>
        <p class="text-muted small mb-0">Nhập thông tin chung cho tất cả suất chiếu.</p>
      </div>
      <div class="card-body p-4">
        <div class="row g-4">
          <div class="col-md-6">
            <label class="form-label fw-semibold">Phim <span class="text-danger">*</span></label>
            <select id="s1Movie" class="form-select" onchange="onMovieChange(this)">
              <option value="">-- Chon phim --</option>
              @if (movies != null) {
                foreach (var m in movies) {
                  <option value="@m.MovieId" data-dur="@m.Duration" data-name="@m.Title">@m.Title (@m.Duration phút)</option>
                }
              }
            </select>
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Ngày chiếu <span class="text-danger">*</span></label>
            <input type="date" id="s1Date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
          </div>
          <div class="col-md-3">
            <label class="form-label fw-semibold">Dọn phòng (phut)</label>
            <input type="number" id="s1Clean" class="form-control" value="15" min="0" max="60" onchange="updateInfo()" />
          </div>
          <div class="col-12">
            <label class="form-label fw-semibold">Phòng chiếu theo rạp <span class="text-danger">*</span> <small class="fw-normal text-muted">(chọn nhiều phòng)</small></label>
            <div class="row g-3 mt-1">
              @if (auditoriums != null) {
                var groups = auditoriums.GroupBy(a => a.TheaterId);
                foreach (var g in groups) {
                  var first = g.First();
                  var tName = first.Theater?.Name ?? "Khác";
                  <div class="col-md-4">
                    <div class="card shadow-none border rounded-3 h-100">
                      <div class="card-header bg-light py-2 px-3">
                        <span class="fw-bold small text-dark"><i class="bi bi-geo-alt-fill text-primary me-1"></i> @tName</span>
                      </div>
                      <div class="card-body p-2 d-flex flex-column gap-1">
                        @foreach (var r in g) {
                          <div class="room-chip w-100 justify-content-start border-1 py-2" onclick="toggleRoom(this)">
                            <input type="checkbox" value="@r.AuditoriumId" data-name="@r.Name (@tName)" class="d-none" />
                            <i class="bi bi-building me-2 text-muted"></i>@r.Name
                          </div>
                        }
                      </div>
                    </div>
                  </div>
                }
              }
            </div>
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Giá vé (d) <span class="text-danger">*</span></label>
            <input type="number" id="s1Price" class="form-control" placeholder="70000" min="0" />
          </div>
          <div class="col-md-4">
            <label class="form-label fw-semibold">Ngôn ngữ</label>
            <select id="s1Lang" class="form-select">
              <option value="Vietsub">Vietsub</option>
              <option value="Long tieng">Lồng tiếng</option>
              <option value="Thuyet minh">Thuyết minh</option>
              <option value="Subtitles">Subtitles (EN)</option>
            </select>
          </div>
          <div class="col-md-4 d-flex align-items-end">
            <button type="button" class="btn btn-outline-secondary w-100" onclick="openModal('copyModal')">
              <i class="bi bi-calendar-check me-1"></i> Copy lịch từ ngày khác
            </button>
          </div>
        </div>
        <div id="s1Info" class="info-box mt-3 d-none"></div>
      </div>
      <div class="card-footer bg-white border-0 px-4 pb-4 d-flex justify-content-end">
        <button type="button" class="btn btn-primary px-5 rounded-pill" onclick="goToStep(2)">
          Tiep theo: Chọn khung giờ <i class="bi bi-arrow-right ms-1"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- ===== STEP 2 ===== -->
  <div class="wizard-panel" id="panel-2">
    <div class="card shadow-sm border-0 rounded-4">
      <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
          <h5 class="fw-bold text-primary mb-0"><i class="bi bi-clock-history me-2"></i>Bước 2: Chọn khung giờ chiếu</h5>
          <p class="text-muted small mb-0" id="s2Sub">Thêm các khung giờ muốn chiếu trong ngày.</p>
        </div>
        <div class="d-flex gap-2">
          <button class="btn btn-sm btn-outline-secondary" onclick="openLoadTpl()"><i class="bi bi-folder2-open me-1"></i>Tải mẫu</button>
          <button class="btn btn-sm btn-outline-primary" onclick="saveTpl()"><i class="bi bi-floppy me-1"></i>Lưu mẫu</button>
        </div>
      </div>
      <div class="card-body p-4">
        <ul class="nav nav-pills mb-4">
          <li class="nav-item"><button class="nav-link active" id="tabManualBtn" onclick="switchTab('manual')"><i class="bi bi-check2-square me-1"></i>Chọn sẵn</button></li>
          <li class="nav-item"><button class="nav-link" id="tabAutoBtn" onclick="switchTab('auto')"><i class="bi bi-lightning-charge me-1"></i>Tự động sinh</button></li>
        </ul>

        <div id="tabManual">
          <p class="small text-muted mb-2"><i class="bi bi-grip-horizontal me-1"></i>Kéo thả để sắp xếp. Nhấn để chọn / bỏ chọn.</p>
          <div class="mb-3">
            <div class="small fw-semibold text-muted mb-2">Giờ phổ biến:</div>
            <div class="d-flex flex-wrap gap-2" id="presetChips">
              @{ var presets = new[]{"08:00","09:30","11:00","12:30","13:00","14:30","16:00","17:30","19:00","20:30","22:00"}; }
              @foreach(var t in presets){<button type="button" class="ts-chip" data-time="@t" onclick="togglePreset(this)">@t</button>}
            </div>
          </div>
          <div class="d-flex justify-content-between align-items-center mb-1">
            <div class="small fw-semibold text-muted">Khung giờ đã chọn (kéo để sắp xếp):</div>
            <button class="btn btn-link btn-sm text-danger p-0" onclick="clearSlots()">Xóa tất cả</button>
          </div>
          <div id="sortableSlots"><span id="slotHint" class="text-muted small">Chưa có khung giờ nào...</span></div>
          <div class="d-flex gap-2 mt-3">
            <input type="time" id="manualTime" class="form-control" style="width:140px;" />
            <button class="btn btn-outline-primary btn-sm" onclick="addManual()"><i class="bi bi-plus me-1"></i>Thêm giờ</button>
          </div>
        </div>

        <div id="tabAuto" class="d-none">
          <div class="row g-3 align-items-end">
            <div class="col-md-3"><label class="form-label fw-semibold">Bắt đầu từ</label><input type="time" id="autoStart" class="form-control" value="09:00" /></div>
            <div class="col-md-3"><label class="form-label fw-semibold">Kết thúc lúc</label><input type="time" id="autoEnd" class="form-control" value="22:00" /></div>
            <div class="col-md-3 pt-4">
              <div class="form-check"><input type="checkbox" class="form-check-input" id="autoAvoid" checked /><label class="form-check-label small fw-semibold" for="autoAvoid">Tự động tránh giờ trùng</label></div>
            </div>
            <div class="col-md-3"><button class="btn btn-success w-100 rounded-pill" onclick="autoGen()"><i class="bi bi-magic me-1"></i>Sinh tự động</button></div>
          </div>
          <div id="autoChips" class="d-flex flex-wrap gap-2 mt-3"></div>
          <div id="autoInfo" class="mt-2 small text-muted"></div>
        </div>

        <div class="mt-4 p-3 bg-primary bg-opacity-10 rounded-3 d-flex justify-content-between align-items-center">
          <div><span class="fw-bold text-primary" id="s2Cnt">0 khung giờ</span><span class="text-muted ms-2 small" id="s2Calc"></span></div>
          <span class="small fw-semibold text-primary" id="s2Total"></span>
        </div>
      </div>
      <div class="card-footer bg-white border-0 px-4 pb-4" style="display:flex;flex-direction:row;justify-content:space-between;align-items:center;">
        <button class="btn btn-light border rounded-pill px-4" style="display:inline-flex;align-items:center;gap:6px;white-space:nowrap;" onclick="goToStep(1)"><i class="bi bi-arrow-left"></i>Quay lại</button>
        <button class="btn btn-primary px-5 rounded-pill" style="display:inline-flex;align-items:center;gap:6px;white-space:nowrap;" onclick="goToStep(3)">Xem trước Preview <i class="bi bi-arrow-right"></i></button>
      </div>
    </div>
  </div>

  <!-- ===== STEP 3 ===== -->
  <div class="wizard-panel" id="panel-3">
    <div class="row g-3 mb-4">
      <div class="col-3"><div class="stat-card bg-light border"><div class="fs-4 fw-bold" id="sTot">0</div><div class="small text-muted">Tổng suất</div></div></div>
      <div class="col-3"><div class="stat-card" style="background:#f0fff4;border-color:#b7ebc0;"><div class="fs-4 fw-bold text-success" id="sVal">-</div><div class="small text-success">Hợp lệ</div></div></div>
      <div class="col-3"><div class="stat-card" style="background:#fff8f8;border-color:#f5b7b1;"><div class="fs-4 fw-bold text-danger" id="sCon">-</div><div class="small text-danger">Trùng lịch</div></div></div>
      <div class="col-3"><div class="stat-card" style="background:#e8f0fe;border-color:#c7d8ff;"><div class="fs-4 fw-bold text-primary" id="sSave">-</div><div class="small text-primary">Sẽ lưu</div></div></div>
    </div>
    <div class="bulk-bar" id="bulkBar">
      <i class="bi bi-pencil-square text-warning"></i>
      <span class="fw-semibold small"><span id="bulkCnt">0</span> suất được chọn</span>
      <input type="number" id="bulkPrice" class="form-control form-control-sm" style="width:130px;" placeholder="Giá mới (d)" />
      <select id="bulkLang" class="form-select form-select-sm" style="width:130px;"><option value="">-- Ngôn ngữ --</option><option>Vietsub</option><option>Long tieng</option><option>Thuyết minh</option></select>
      <button class="btn btn-sm btn-warning fw-semibold" onclick="applyBulk()"><i class="bi bi-check me-1"></i>Áp dụng</button>
      <button class="btn btn-sm btn-link text-muted ms-auto p-0" onclick="clearSel()">Bỏ chọn hết</button>
    </div>
    <div class="d-flex gap-2 mb-3 flex-wrap">
      <button class="btn btn-sm btn-outline-secondary" onclick="toggleAll()"><i class="bi bi-check-all me-1"></i>Chọn / Bỏ hết</button>
      <button class="btn btn-sm btn-outline-danger" onclick="autoRemoveConflicts()"><i class="bi bi-x-circle me-1"></i>Loại bỏ suất trùng</button>
      <button class="btn btn-sm btn-outline-secondary ms-auto" onclick="recheck()"><i class="bi bi-arrow-clockwise me-1"></i>Kiểm tra lại</button>
    </div>
    <div id="previewGrid" class="row g-3 mb-4"></div>
    <div class="card border-0 shadow-sm rounded-4">
      <div class="card-footer bg-white border-0 px-4 py-3" style="display:flex;flex-direction:row;justify-content:space-between;align-items:center;">
        <button class="btn btn-light border rounded-pill px-4" style="display:inline-flex;align-items:center;gap:6px;white-space:nowrap;" onclick="goToStep(2)"><i class="bi bi-arrow-left"></i>Quay lại chỉnh sửa</button>
        <button class="btn btn-success px-5 rounded-pill fw-semibold" style="display:inline-flex;align-items:center;gap:6px;" onclick="doSubmit()" id="btnSave">
          <i class="bi bi-floppy"></i><span id="btnLbl">Lưu tất cả hợp lệ</span>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- COPY MODAL -->
<div class="v3-overlay" id="copyModal">
  <div class="v3-modal">
    <h6><i class="bi bi-calendar-check me-2 text-primary"></i>Copy lịch từ ngày khác</h6>
    <label class="form-label fw-semibold">Chọn ngày cần copy:</label>
    <input type="date" id="copyDate" class="form-control mb-3" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
    <div id="copyMsg" class="small text-muted mb-2 d-none"></div>
    <div class="d-flex gap-2 justify-content-end">
      <button class="btn btn-light border" onclick="closeModal('copyModal')">Hủy</button>
      <button class="btn btn-primary" onclick="copySchedule()"><i class="bi bi-download me-1"></i>Tải lịch</button>
    </div>
  </div>
</div>

<!-- LOAD TEMPLATE MODAL -->
<div class="v3-overlay" id="tplModal">
  <div class="v3-modal">
    <h6><i class="bi bi-folder2-open me-2 text-primary"></i>Tải mẫu lịch chiếu</h6>
    <div id="tplList" class="mb-3"><p class="text-muted small">Chưa có mẫu nào.</p></div>
    <div class="d-flex justify-content-end"><button class="btn btn-light border" onclick="closeModal('tplModal')">Đóng</button></div>
  </div>
</div>

<!-- Hidden submit form -->
<form id="submitForm" method="post" asp-action="CreateMultiple">
  @Html.AntiForgeryToken()
  <div id="submitBody"></div>
</form>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
    window.ShowtimeCreateConfig = {
        todayDate: '@DateTime.Today.ToString("yyyy-MM-dd")'
    };
</script>
<script src="~/js/pages/showtime/create.js" asp-append-version="true"></script>
}

