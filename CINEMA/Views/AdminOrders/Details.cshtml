@model CINEMA.Models.Order
@{
    ViewData["Title"] = "Chi tiết vé";
    Layout = "_AdminLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/order-management.css" />
}

<div class="container-fluid py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Quản lý đơn hàng</a></li>
            <li class="breadcrumb-item active">Chi tiết mã vé @("CZ" + Model.OrderId.ToString("D6"))</li>
        </ol>
    </nav>

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-dark mb-0 d-flex align-items-center">
            <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                <i class="bi bi-ticket-detailed fs-4"></i>
            </div>
            Chi tiết giao dịch <span class="text-primary ms-2">#@("CZ" + Model.OrderId.ToString("D6"))</span>
        </h3>

        <div class="d-flex gap-2">
            <!-- Nút Hủy (Chỉ hiện khi đang chờ thanh toán) -->
            @if (Model.Status == "Chờ thanh toán" || Model.Status == "Đang chờ thanh toán")
            {
                <form asp-action="CancelOrder" method="post" class="m-0">
                    <input type="hidden" name="id" value="@Model.OrderId" />
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm" onclick="return confirm('Bạn có chắc chắn muốn hủy vé này không?');">
                        <i class="bi bi-x-circle me-1"></i> Hủy vé
                    </button>
                </form>
            }
            <a asp-action="Index" class="btn btn-light border rounded-pill px-4 shadow-sm text-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- 👤 Thông tin người mua -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100">
                <h6 class="fw-bold text-secondary text-uppercase mb-4" style="letter-spacing: 1px;">
                    <i class="bi bi-person-vcard me-2 text-primary"></i> Thông tin khách hàng
                </h6>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between border-bottom pb-2">
                        <span class="text-muted">Họ tên:</span>
                        <span class="fw-semibold text-dark">@Model.Customer?.FullName</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2">
                        <span class="text-muted">Email:</span>
                        <span class="fw-semibold text-dark">@Model.Customer?.Email</span>
                    </div>
                    <div class="d-flex justify-content-between pb-2">
                        <span class="text-muted">Số điện thoại:</span>
                        <span class="fw-semibold text-dark">@Model.Customer?.Phone</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 💳 Thông tin thanh toán -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-4 p-4 h-100 bg-light">
                <h6 class="fw-bold text-secondary text-uppercase mb-4" style="letter-spacing: 1px;">
                    <i class="bi bi-credit-card me-2 text-success"></i> Thông tin thanh toán
                </h6>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-content-between border-bottom pb-2 border-secondary-subtle">
                        <span class="text-muted">Trạng thái:</span>
                        @{
                            var badgeClass = Model.Status == "Đã thanh toán" ? "bg-success-subtle text-success border-success-subtle" :
                                             Model.Status.Contains("chờ") ? "bg-warning-subtle text-warning border-warning-subtle" :
                                             "bg-secondary-subtle text-secondary border-secondary-subtle";
                        }
                        <span class="badge @badgeClass border rounded-pill px-3">@Model.Status</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2 border-secondary-subtle">
                        <span class="text-muted">Phương thức:</span>
                        <span class="fw-semibold text-dark">@Model.PaymentMethod</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2 border-secondary-subtle">
                        <span class="text-muted">Ngày đặt:</span>
                        <span class="fw-semibold text-dark">@Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between mt-1">
                        <span class="text-muted fw-bold">Tổng tiền:</span>
                        <span class="fw-bold text-danger fs-5">@String.Format("{0:N0} ₫", Model.TotalAmount)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 🎬 Thông tin vé xem phim (Thiết kế dạng Ticket) -->
    <div class="card shadow-sm border-0 rounded-4 mb-4 ticket-card">
        <div class="card-body p-4 p-md-5">
            <h5 class="fw-bold text-dark mb-4 border-bottom pb-3">
                <i class="bi bi-film text-danger me-2"></i> Chi tiết vé xem phim
            </h5>

            @if (Model.Tickets != null && Model.Tickets.Any())
            {
                var ticket = Model.Tickets.First();
                <div class="row g-4">
                    <div class="col-md-8">
                        <h4 class="fw-bold text-primary mb-1">@ticket.Showtime?.Movie?.Title</h4>
                        <p class="text-muted mb-4"><i class="bi bi-geo-alt-fill me-1"></i> Rạp: <strong class="text-dark">@ticket.Showtime?.Auditorium?.Name</strong></p>

                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <small class="text-muted d-block mb-1">Suất chiếu</small>
                                    <span class="fw-bold text-dark fs-6">@ticket.Showtime?.StartTime?.ToString("HH:mm - dd/MM/yyyy")</span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <small class="text-muted d-block mb-1">Giá vé mỗi ghế</small>
                                    <span class="fw-bold text-danger fs-6">@String.Format("{0:N0} ₫", ticket.Price)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex flex-column justify-content-center align-items-center border-start border-2 border-dashed ticket-seat-zone">
                        <span class="text-muted mb-2 text-uppercase fw-bold" style="letter-spacing: 2px;">Ghế đã chọn</span>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            @foreach (var t in Model.Tickets)
                            {
                                <span class="badge bg-primary fs-5 px-3 py-2 rounded-3 shadow-sm">
                                    @(t.Seat.RowLabel + t.Seat.SeatNumber)
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-ticket-perforated fs-1 d-block mb-2 opacity-50"></i>
                    Không có vé xem phim nào trong đơn này.
                </div>
            }
        </div>
    </div>

    <!-- 🍿 Combo -->
    @if (Model.OrderCombos != null && Model.OrderCombos.Any())
    {
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                <h6 class="fw-bold text-secondary text-uppercase mb-0" style="letter-spacing: 1px;">
                    <i class="bi bi-cup-straw me-2 text-warning"></i> Dịch vụ đi kèm (Combo)
                </h6>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table mb-0 border rounded-3">
                        <thead class="table-light text-secondary">
                            <tr>
                                <th class="ps-4">Tên Combo</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end pe-4">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.OrderCombos)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">@c.Combo?.Name</td>
                                    <td class="text-center fw-medium">
                                        <span class="badge bg-light text-dark border px-3">x @c.Quantity</span>
                                    </td>
                                    <td class="text-end text-muted">@String.Format("{0:N0} ₫", c.UnitPrice)</td>
                                    <td class="text-end pe-4 fw-bold text-danger">@String.Format("{0:N0} ₫", (c.Quantity * (c.UnitPrice ?? 0)))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div> <!-- DÒNG NÀY ĐÃ ĐƯỢC FIX (Chuyển dấu } thành </div>) -->
        </div>
    }
</div>