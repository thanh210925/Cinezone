@model CINEMA.Models.Auditorium
@{
    ViewData["Title"] = "Xóa phòng chiếu";
    Layout = "_AdminLayout";
}

<div class="container mt-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">
                <i class="bi bi-exclamation-triangle-fill"></i> Xác nhận xóa phòng chiếu
            </h4>
        </div>
        <div class="card-body">
            @if (ViewBag.HasTickets == true)
            {
                <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4">
                    <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
                    <div>
                        <strong>Lưu ý về dữ liệu:</strong> Phòng chiếu này đã có dữ liệu vé đặt của khách hàng. 
                        Để tránh ảnh hưởng tới thống kê doanh thu và báo cáo lịch sử, hệ thống sẽ 
                        <strong>chuyển trạng thái sang Tạm dừng</strong> (không hiển thị khi tạo suất chiếu mới) thay vì xóa hoàn toàn khỏi cơ sở dữ liệu.
                    </div>
                </div>
            }
            <p>Bạn có chắc chắn muốn @(ViewBag.HasTickets == true ? "tạm dừng" : "xóa") phòng chiếu sau đây không?</p>

            <dl class="row">
                <dt class="col-sm-3">Tên phòng:</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Rạp:</dt>
                <dd class="col-sm-9">@Model.Theater?.Name</dd>

                <dt class="col-sm-3">Số hàng ghế:</dt>
                <dd class="col-sm-9">@Model.SeatRows</dd>

                <dt class="col-sm-3">Số ghế mỗi hàng:</dt>
                <dd class="col-sm-9">@Model.SeatCols</dd>

                <dt class="col-sm-3">Loại màn hình:</dt>
                <dd class="col-sm-9">@Model.ScreenType</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.AuditoriumId" method="post">
                <input type="hidden" name="id" value="@Model.AuditoriumId" />
                <div class="text-end">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash"></i> @(ViewBag.HasTickets == true ? "Xác nhận Tạm dừng" : "Xác nhận Xóa")
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
