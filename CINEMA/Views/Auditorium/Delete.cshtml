@model CINEMA.Models.Auditorium
@{
    ViewData["Title"] = "Ngừng hoạt động phòng chiếu";
    Layout = "_AdminLayout";
}

<div class="container mt-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0 fw-bold">
                <i class="bi bi-pause-circle-fill me-2"></i> Ngừng hoạt động phòng chiếu
            </h4>
        </div>
        <div class="card-body">
            <div class="alert alert-info border-0 shadow-sm d-flex align-items-center mb-4">
                <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
                <div>
                    <strong>Lưu ý:</strong> Hành động này sẽ chuyển trạng thái phòng chiếu sang <strong>Tạm dừng</strong>. 
                    Phòng sẽ không xuất hiện khi lập lịch chiếu mới, nhưng toàn bộ danh sách ghế ngồi, lịch sử đặt vé và doanh thu trước đây vẫn được giữ lại hoàn toàn để làm báo cáo thống kê.
                </div>
            </div>

            <p class="fw-semibold">Bạn có chắc chắn muốn ngưng hoạt động phòng chiếu dưới đây không?</p>

            <dl class="row mt-3">
                <dt class="col-sm-3">Tên phòng:</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Rạp:</dt>
                <dd class="col-sm-9">@Model.Theater?.Name</dd>

                <dt class="col-sm-3">Số hàng ghế:</dt>
                <dd class="col-sm-9">@Model.SeatRows</dd>

                <dt class="col-sm-3">Số ghế mỗi hàng:</dt>
                <dd class="col-sm-9">@Model.SeatCols</dd>

                <dt class="col-sm-3">Loại màn hình:</dt>
                <dd class="col-sm-9">@Model.ScreenType</dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.AuditoriumId" method="post" class="mt-4">
                <input type="hidden" name="id" value="@Model.AuditoriumId" />
                <div class="text-end">
                    <button type="submit" class="btn btn-warning px-4 fw-semibold">
                        <i class="bi bi-pause-fill"></i> Xác nhận Tạm dừng
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>
