@model CINEMA.Models.Auditorium
@{
    ViewData["Title"] = "Thiết kế sơ đồ ghế - " + Model.Name;
    Layout = "_AdminLayout";
    var existingSeats = ViewBag.Seats as List<CINEMA.Models.Seat> ?? new List<CINEMA.Models.Seat>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auditorium/designlayout.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-primary mb-1">
                <i class="bi bi-grid-3x3-gap me-2"></i>Thiết kế sơ đồ ghế: @Model.Name
            </h4>
            <p class="text-muted small mb-0">Rạp: @(Model.Theater?.Name ?? "CineZone") &bull; Kiểu màn hình: @Model.ScreenType</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
            <button class="btn btn-success rounded-pill px-4 shadow-sm" onclick="saveLayout()">
                <i class="bi bi-floppy me-1"></i> Lưu sơ đồ
            </button>
        </div>
    </div>

    <div class="row g-4">
        <!-- 🛠️ CỘT TRÁI: BỘ CÔNG CỤ -->
        <div class="col-xl-3 col-lg-4">
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-tools text-primary me-2"></i>Công cụ vẽ ghế</h6>
                </div>
                <div class="card-body p-4 d-flex flex-column gap-2">
                    <button class="tool-btn active" data-type="Standard" onclick="selectTool('Standard')">
                        <span class="tool-color-dot" style="background-color: #94a3b8; border: 1px solid #64748b;"></span>
                        Ghế Thường (Standard)
                    </button>
                    <button class="tool-btn" data-type="VIP" onclick="selectTool('VIP')">
                        <span class="tool-color-dot" style="background-color: #eab308; border: 1px solid #ca8a04;"></span>
                        Ghế VIP (+30.000đ)
                    </button>
                    <button class="tool-btn" data-type="Couple" onclick="selectTool('Couple')">
                        <span class="tool-color-dot" style="background-color: #ec4899; border: 1px solid #db2777;"></span>
                        Ghế Đôi (Couple +100.000đ)
                    </button>
                    <button class="tool-btn" data-type="Disabled" onclick="selectTool('Disabled')">
                        <span class="tool-color-dot" style="background-color: #3b82f6; border: 1px solid #2563eb;"></span>
                        Ghế Khuyết Tật
                    </button>
                    <button class="tool-btn" data-type="Empty" onclick="selectTool('Empty')">
                        <span class="tool-color-dot" style="background-color: transparent; border: 2px dashed #cbd5e1;"></span>
                        Eraser (Xóa / Lối đi trống)
                    </button>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-sliders text-primary me-2"></i>Kích thước lưới vẽ</h6>
                </div>
                <div class="card-body p-4">
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="small text-muted fw-bold mb-1">Số hàng (A-Z)</label>
                            <input type="number" id="gridRows" class="form-control rounded-3" value="@(Model.SeatRows ?? 10)" min="1" max="26" />
                        </div>
                        <div class="col-6">
                            <label class="small text-muted fw-bold mb-1">Số cột</label>
                            <input type="number" id="gridCols" class="form-control rounded-3" value="@(Model.SeatCols ?? 15)" min="1" max="30" />
                        </div>
                    </div>
                    <button class="btn btn-primary btn-sm w-100 rounded-pill mb-2" onclick="resizeGrid()">
                        <i class="bi bi-arrow-repeat me-1"></i> Cập nhật kích thước lưới
                    </button>
                </div>
            </div>
        </div>

        <!-- 🖥️ CỘT PHẢI: BẢN VẼ CANVAS -->
        <div class="col-xl-9 col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <!-- 🎬 Màn hình chiếu giả lập -->
                    <div class="d-flex flex-column align-items-center mb-5">
                        <div class="screen-shape mb-2"></div>
                        <span class="small text-muted fw-bold tracking-wider">MÀN HÌNH CHIẾU</span>
                    </div>

                    <!-- 🪑 Lưới ghế tương tác -->
                    <div class="grid-container text-center">
                        <div id="seatGrid" class="seat-grid"></div>
                    </div>

                    <!-- Hướng dẫn sử dụng nhanh -->
                    <div class="alert alert-info mt-4 rounded-3 small mb-0">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Mẹo vẽ nhanh:</strong> Click chọn công cụ vẽ ở bên trái, sau đó **nhấp chuột và di kéo (drag)** qua các ô trên lưới để tô nhanh sơ đồ mà không cần nhấp từng ô!
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.DesignLayoutConfig = {
            auditoriumId: @Model.AuditoriumId,
            seatRows: @(Model.SeatRows ?? 10),
            seatCols: @(Model.SeatCols ?? 15),
            existingSeats: {
                @if (existingSeats.Any())
                {
                    @Html.Raw(string.Join(",\n", existingSeats.Select(s => $"\"{s.RowLabel}_{s.SeatNumber}\": {{ type: \"{s.SeatType}\", active: {(s.IsActive == true ? "true" : "false")} }}")))
                }
            }
        };
    </script>
    <script src="~/js/pages/auditorium/designlayout.js" asp-append-version="true"></script>
}
