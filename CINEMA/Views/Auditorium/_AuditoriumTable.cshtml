@model IEnumerable<CINEMA.Models.Auditorium>

<div class="table-responsive">
    <table class="table table-hover align-middle custom-table mb-0">
        <thead class="table-light text-secondary">
            <tr>
                <th class="ps-4 text-center" width="8%">STT</th>
                <th>Tên phòng</th>
                <th>Rạp</th>
                <th class="text-center">Số hàng</th>
                <th class="text-center">Ghế/hàng</th>
                <th class="text-center">Màn hình</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-center pe-4" width="10%">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @{
                int stt = 1;
            }
            @foreach (var a in Model)
            {
                <tr>
                    <td class="ps-4 text-center fw-medium text-muted">@stt</td>
                    <td class="fw-bold text-dark">@a.Name</td>
                    <td><span class="text-muted">@a.Theater?.Name</span></td>
                    <td class="text-center">@a.SeatRows</td>
                    <td class="text-center">@a.SeatCols</td>
                    <td class="text-center"><span class="badge bg-info-subtle text-info">@a.ScreenType</span></td>
                    <td class="text-center">
                        <span class="badge @(a.IsActive == true ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill px-3">
                            @(a.IsActive == true ? "Hoạt động" : "Tạm dừng")
                        </span>
                    </td>
                    <td class="text-center pe-4">
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="Edit" asp-route-id="@a.AuditoriumId" class="btn btn-light btn-sm text-warning"><i class="bi bi-pencil-square"></i></a>
                            <a asp-action="Delete" asp-route-id="@a.AuditoriumId" class="btn btn-light btn-sm text-danger"><i class="bi bi-trash3"></i></a>
                        </div>
                    </td>
                </tr>
                stt++;
            }
        </tbody>
    </table>
</div>