@model IEnumerable<CINEMA.Models.Auditorium>
@{
    ViewData["Title"] = "Danh sách phòng chiếu";
    Layout = "_AdminLayout";
    // Lấy danh sách rạp từ ViewBag (nhớ truyền từ Controller nhé)
    var theaters = ViewBag.Theaters as List<CINEMA.Models.Theater> ?? new List<CINEMA.Models.Theater>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/auditorium/index.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active">Quản lý phòng chiếu</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white pt-4 px-4 border-0 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <ul class="nav nav-pills flex-nowrap overflow-auto" id="theaterTabs" role="tablist" style="scrollbar-width: none;">
                <li class="nav-item">
                    <button class="nav-link active rounded-pill px-4 me-2" data-bs-toggle="pill" data-bs-target="#all-content" type="button">Tất cả</button>
                </li>
                @foreach (var t in theaters)
                {
                    <li class="nav-item">
                        <button class="nav-link rounded-pill px-4 me-2" data-bs-toggle="pill" data-bs-target="#content-@t.TheaterId" type="button">@t.Name</button>
                    </li>
                }
            </ul>
            <a class="btn btn-primary rounded-pill px-4 fw-medium" asp-action="Create">
                <i class="bi bi-plus-lg me-1"></i> Thêm phòng chiếu
            </a>
        </div>

        <div class="card-body p-0">
            <div class="tab-content" id="theaterTabsContent">
                <div class="tab-pane fade show active" id="all-content">
                    @await Html.PartialAsync("_AuditoriumTable", Model)
                </div>
                @foreach (var t in theaters)
                {
                    <div class="tab-pane fade" id="content-@t.TheaterId">
                        @await Html.PartialAsync("_AuditoriumTable", Model.Where(a => a.TheaterId == t.TheaterId).ToList())
                    </div>
                }
            </div>
        </div>
    </div>
</div>