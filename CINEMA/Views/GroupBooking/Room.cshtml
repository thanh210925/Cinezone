@model CINEMA.Models.GroupBookingRoom
@{
    ViewData["Title"] = "CineZone - Phòng chờ đặt vé nhóm";
    var seats = ViewBag.Seats as List<CINEMA.Models.Seat> ?? new List<CINEMA.Models.Seat>();
    var bookedSeats = ViewBag.BookedSeats as List<string> ?? new List<string>();
    var seatGroups = seats.GroupBy(s => s.RowLabel);
    int currentCustomerId = ViewBag.CurrentCustomerId;
    
    // Tìm ghế hiện tại của người dùng này nếu có
    var currentMember = Model.Members.FirstOrDefault(m => m.CustomerId == currentCustomerId);
    int? mySelectedSeatId = currentMember?.SeatId;
    string mySelectedSeatCode = currentMember?.Seat != null ? $"{currentMember.Seat.RowLabel}{currentMember.Seat.SeatNumber}" : "";
}

<div class="container-fluid py-4 min-vh-100" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%); color: #f8fafc; font-family: 'Outfit', 'Inter', sans-serif;">
    <div class="container py-2">
        
        <!-- 🎬 Tên Phim & Rạp thông tin -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="p-4 rounded-4 shadow-lg border border-opacity-10 border-light" style="background: rgba(30, 41, 59, 0.45); backdrop-filter: blur(16px);">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <span class="badge bg-primary mb-2 px-3 py-2 text-uppercase letter-spacing-1 small">👥 Phòng chờ: @Model.RoomId</span>
                            <h2 class="fw-bold text-white mb-1"><i class="bi bi-film me-2 text-warning"></i> @Model.Showtime.Movie.Title</h2>
                            <p class="text-slate-300 mb-0 mt-2 small text-muted">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i> @Model.Showtime.Auditorium.Theater.Name &nbsp;|&nbsp;
                                <i class="bi bi-camera-reels-fill text-primary me-1"></i> @Model.Showtime.Auditorium.Name &nbsp;|&nbsp;
                                <i class="bi bi-clock-fill text-success me-1"></i> @Model.Showtime.StartTime?.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>
                        <div class="text-md-end bg-dark bg-opacity-50 p-3 rounded-3 border border-secondary border-opacity-25" style="min-width: 200px;">
                            <span class="text-muted d-block small mb-1">⏳ PHÒNG CHỜ HẾT HẠN TRONG</span>
                            <span id="roomCountdown" class="fs-3 fw-bold text-danger">15:00</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- CỘT TRÁI: SƠ ĐỒ GHẾ THỜI GIAN THỰC -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-lg h-100 rounded-4 overflow-hidden" style="background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.05) !important;">
                    <div class="card-header bg-dark bg-opacity-25 border-bottom border-light border-opacity-10 pt-4 pb-3 px-4">
                        <h4 class="fw-bold mb-0 text-white"><i class="bi bi-grid-3x3-gap me-2 text-danger"></i> Chọn Ghế Của Bạn</h4>
                        <small class="text-muted d-block mt-1">Click vào ghế trống để chọn. Hệ thống tự động đồng bộ thời gian thực với bạn bè.</small>
                    </div>
                    <div class="card-body py-5 overflow-auto">
                        <!-- Màn hình chiếu -->
                        <div class="cinema-screen-container mb-5 text-center">
                            <div class="cinema-screen mx-auto"></div>
                            <small class="text-muted fw-bold letter-spacing-2">MÀN HÌNH CHIẾU</small>
                        </div>

                        <!-- Lưới Ghế -->
                        <div class="d-flex flex-column align-items-center">
                            @{
                                int maxCol = seats.Any() ? seats.Max(s => s.SeatNumber ?? 0) : 0;
                            }
                            @foreach (var group in seatGroups)
                            {
                                <div class="d-flex justify-content-center align-items-center mb-2 gap-1 flex-wrap">
                                    <span class="fw-bold text-muted me-3 text-center" style="width: 24px;">@group.Key</span>
                                    @for (int col = 1; col <= maxCol; col++)
                                    {
                                        var seat = group.FirstOrDefault(s => s.SeatNumber == col);
                                        if (seat != null)
                                        {
                                            string seatCode = $"{seat.RowLabel}{seat.SeatNumber}";
                                            bool isBooked = bookedSeats.Contains(seatCode);
                                            decimal surcharge = 0m;
                                            string typeClass = "";
                                            string icon = "";

                                            if (seat.SeatType == "VIP")
                                            {
                                                surcharge = 30000m;
                                                typeClass = "seat-vip";
                                            }
                                            else if (seat.SeatType == "Couple")
                                            {
                                                surcharge = 100000m;
                                                typeClass = "seat-couple";
                                                icon = "<i class=\"bi bi-heart-fill small\"></i>";
                                            }
                                            else if (seat.SeatType == "Disabled")
                                            {
                                                typeClass = "seat-disabled";
                                                icon = "<i class=\"bi bi-person-badge-fill small\"></i>";
                                            }

                                            <!-- Ghế Wrapper -->
                                            <div class="seat-container" 
                                                 id="seat-container-@seat.SeatId"
                                                 data-seat-id="@seat.SeatId" 
                                                 data-seat-code="@seatCode"
                                                 data-booked="@(isBooked ? "true" : "false")"
                                                 data-surcharge="@surcharge">
                                                 
                                                <button class="btn-seat @typeClass @(isBooked ? "seat-booked" : "")" 
                                                        id="btn-seat-@seat.SeatId"
                                                        onclick="selectGroupSeat(@seat.SeatId)" 
                                                        title="@seatCode - @seat.SeatType @(surcharge > 0 ? $"(+{surcharge:N0}đ)" : "")"
                                                        @(isBooked ? "disabled" : "")>
                                                    @if (!string.IsNullOrEmpty(icon))
                                                    {
                                                        @Html.Raw(icon)
                                                    }
                                                    else
                                                    {
                                                        @seat.SeatNumber
                                                    }
                                                </button>
                                                <!-- Badge hiển thị initials của người giữ ghế -->
                                                <span class="seat-member-badge" id="badge-seat-@seat.SeatId"></span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div style="width: 38px; height: 38px; display: inline-block;"></div>
                                        }
                                    }
                                </div>
                            }
                        </div>

                        <!-- Chú thích loại ghế -->
                        <div class="d-flex justify-content-center gap-4 mt-5 pt-4 border-top border-light border-opacity-10 flex-wrap text-muted small">
                            <div class="d-flex align-items-center"><div class="legend-box border border-secondary border-opacity-25 bg-slate"></div> <span class="ms-2">Thường</span></div>
                            <div class="d-flex align-items-center"><div class="legend-box seat-vip bg-yellow"></div> <span class="ms-2">VIP (+30k)</span></div>
                            <div class="d-flex align-items-center"><div class="legend-box seat-couple bg-pink"></div> <span class="ms-2">Couple (+100k)</span></div>
                            <div class="d-flex align-items-center"><div class="legend-box seat-disabled bg-blue"></div> <span class="ms-2">Khuyết tật</span></div>
                            <div class="d-flex align-items-center"><div class="legend-box bg-success border-success"></div> <span class="ms-2">Bạn đang chọn</span></div>
                            <div class="d-flex align-items-center"><div class="legend-box bg-info border-info"></div> <span class="ms-2">Thành viên khác chọn</span></div>
                            <div class="d-flex align-items-center"><div class="legend-box bg-secondary opacity-50"></div> <span class="ms-2">Đã bán</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: CHI TIẾT PHÒNG NHÓM & THANH TOÁN -->
            <div class="col-lg-4">
                <div class="d-flex flex-column gap-4 h-100">
                    
                    <!-- Box chia sẻ link -->
                    <div class="p-4 rounded-4 shadow-lg border border-opacity-10 border-light" style="background: rgba(30, 41, 59, 0.45); backdrop-filter: blur(16px);">
                        <h5 class="fw-bold mb-3 text-white"><i class="bi bi-share me-2 text-primary"></i> Mời Bạn Bè Tham Gia</h5>
                        <p class="small text-muted mb-3">Gửi đường dẫn này cho bạn bè. Họ chỉ cần đăng nhập là có thể vào phòng chờ chọn ghế chung.</p>
                        
                        <div class="input-group mb-3 bg-dark bg-opacity-50 p-1 rounded-3 border border-secondary border-opacity-25">
                            <input type="text" id="shareRoomLink" class="form-control bg-transparent border-0 text-white small" style="outline: none; box-shadow: none;" readonly value="" />
                            <button class="btn btn-primary px-3 rounded-3 btn-sm" type="button" onclick="copyRoomLink(this)">
                                <i class="bi bi-clipboard me-1"></i> Copy
                            </button>
                        </div>
                    </div>

                    <!-- Panel thành viên nhóm -->
                    <div class="p-4 rounded-4 shadow-lg border border-opacity-10 border-light flex-grow-1 d-flex flex-column" style="background: rgba(30, 41, 59, 0.45); backdrop-filter: blur(16px);">
                        <h5 class="fw-bold mb-3 text-white"><i class="bi bi-people me-2 text-warning"></i> Bạn Đồng Hành</h5>
                        
                        <div class="flex-grow-1 overflow-auto d-flex flex-column gap-2 mb-4" id="memberListContainer" style="max-height: 380px;">
                            <!-- Danh sách thành viên được vẽ bằng JS -->
                            <div class="text-center py-4 text-muted small">Đang tải thành viên...</div>
                        </div>

                        <!-- Cụm Checkout -->
                        <div class="mt-auto border-top border-light border-opacity-10 pt-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted fw-bold">Ghế của bạn:</span>
                                <span class="fs-5 fw-bold text-success" id="mySeatCodeDisplay">Chưa chọn</span>
                            </div>
                            
                            <a id="btnCheckout" href="/GroupBooking/StartCheckout?roomId=@Model.RoomId" class="btn btn-danger w-100 btn-lg fw-bold rounded-3 shadow-lg py-3 disabled">
                                THANH TOÁN PHẦN CỦA TÔI <i class="bi bi-arrow-right ms-2"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/groupbooking/room.css" asp-append-version="true" />
}

@section Scripts {
    <!-- SignalR Library -->
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        window.RoomConfig = {
            roomId: "@Model.RoomId",
            currentCustomerId: @currentCustomerId,
            expiresAt: "@Model.ExpiresAt.ToString("yyyy-MM-ddTHH:mm:ss")"
        };
    </script>
    <script src="~/js/pages/groupbooking/room.js" asp-append-version="true"></script>
}
