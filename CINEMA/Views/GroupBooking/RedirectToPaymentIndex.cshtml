@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Chuyển hướng thanh toán...</title>
</head>
<body style="background-color: #121212; color: #ffffff; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">
    <div style="text-align: center;">
        <div style="border: 4px solid #f3f3f3; border-top: 4px solid #3498db; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto 20px;"></div>
        <p>Đang chuẩn bị thông tin thanh toán...</p>
    </div>

    <form id="autoForm" action="/Payment/Index" method="post">
        <input type="hidden" name="MovieId" value="@ViewBag.MovieId" />
        <input type="hidden" name="ShowtimeId" value="@ViewBag.ShowtimeId" />
        <input type="hidden" name="selectedSeats" value="@ViewBag.SelectedSeats" />
        <input type="hidden" name="AdultTickets" value="1" />
        <input type="hidden" name="ChildTickets" value="0" />
        <input type="hidden" name="StudentTickets" value="0" />
        <input type="hidden" name="TotalPrice" value="@ViewBag.TotalPrice" />
    </form>

    <style>
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>

    <script>
        document.getElementById("autoForm").submit();
    </script>
</body>
</html>
