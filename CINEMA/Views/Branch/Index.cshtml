@model IEnumerable<CINEMA.Models.Theater>

@{
    ViewData["Title"] = "Quản lý chi nhánh";
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Quản lý chi nhánh</h3>

        <a asp-controller="Theater"
           asp-action="Index"
           class="btn btn-primary">
            Quản lý rạp
        </a>
    </div>

    <form method="get">
        <div class="input-group mb-3">
            <input name="search"
                   value="@Context.Request.Query["search"]"
                   class="form-control"
                   placeholder="Tìm chi nhánh..." />

            <button class="btn btn-secondary">
                Tìm
            </button>
        </div>
    </form>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>Tên chi nhánh</th>
                <th>Địa chỉ</th>
                <th>Điện thoại</th>
                <th>Google Map</th>
                <th>Trạng thái</th>
                <th width="120">Thao tác</th>
            </tr>
        </thead>

    <tbody>
    @if (Model.Any())
    {
        int stt = 1;

        @foreach (var item in Model)
        {
            <tr>
                <td>@stt</td>

                <td>@item.Name</td>

                <td>@item.Address</td>

                <td>@item.Phone</td>

                <td>
                    @if (!string.IsNullOrEmpty(item.GoogleMapUrl))
                    {
                        <a href="@item.GoogleMapUrl"
                           target="_blank"
                           class="btn btn-sm btn-info">
                            Xem
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">Không có</span>
                    }
                </td>

                <td>
                    @if (item.IsActive == true)
                    {
                        <span class="badge bg-success">
                            Hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Ngừng
                        </span>
                    }
                </td>

                <td>
                    <a asp-controller="Theater"
                       asp-action="Edit"
                       asp-route-id="@item.TheaterId"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>
                </td>
            </tr>

            stt++;
        }
    }
    else
    {
        <tr>
            <td colspan="7" class="text-center text-muted">
                Không có dữ liệu.
            </td>
        </tr>
    }
</tbody>
    </table>

</div>