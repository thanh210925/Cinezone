{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "AllowedHosts": "*"
  },
  "AllowedHosts": "*",
  "GeminiApiKey": "YOUR_GEMINI_API_KEY",
  "AppSettings": {
    "BaseUrl": "https://localhost:7123/"
  },
  "ConnectionStrings": {
    "CinemaDb": "Server=YOUR_SERVER_NAME;Database=CinezoneDB;User ID=YOUR_USER_ID;Password=YOUR_PASSWORD;Encrypt=True;TrustServerCertificate=True;"
  },
  "Vnpay": {
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "ReturnUrl": "/Payment/PaymentReturn",
    "TmnCode": "YOUR_VNPAY_TMN_CODE",
    "HashSecret": "YOUR_VNPAY_HASH_SECRET"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "CineZone",
    "SenderEmail": "your_email@gmail.com",
    "Username": "your_email@gmail.com",
    "Password": "YOUR_EMAIL_APP_PASSWORD",
    "EnableSsl": true
  },
  "Stripe": {
    "PublishableKey": "YOUR_STRIPE_PUBLISHABLE_KEY",
    "SecretKey": "YOUR_STRIPE_SECRET_KEY"
  },
  "VietQR": {
    "BankId": "MB",
    "BankName": "MBBank",
    "AccountNo": "YOUR_ACCOUNT_NUMBER",
    "AccountName": "YOUR_ACCOUNT_NAME",
    "Template": "compact2"
  },
  "Jwt": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_HERE_MIN_32_CHARS",
    "Issuer": "CinezoneAPI",
    "Audience": "CinezoneClient",
    "ExpireDays": 7
  }
}
